,760,762,764,767,770,773,776,779,783,787,790,792,795,797,800,802,805,807,810,812,815,817],{"hid":710,"property":710,"name":710,"content":711},"description","IntroductionRobot-mediated neuro-motor rehabilitation offers intensive, repeatable, and objectively monitored therapy, yet existing systems rarely integrate ...",{"hid":713,"property":713,"name":714,"content":703},"og:title","title",{"hid":716,"property":716,"name":710,"content":711},"og:description",{"hid":718,"name":718,"content":719},"keywords","human-robot interaction,socially assistive robotics,rehabilitation robotics,adaptive difficulty,behavior tree,TIAGo,Unilateral Spatial Neglect",{"hid":721,"property":721,"name":722,"content":723},"og:site_name","site_name","Frontiers",{"hid":725,"property":725,"name":405,"content":423},"og:image",{"hid":727,"property":727,"name":728,"content":729},"og:type","type","article",{"hid":731,"property":731,"name":732,"content":707},"og:url","url",{"hid":734,"name":734,"content":735},"twitter:card","summary_large_image",{"hid":737,"name":737,"content":738},"citation_volume","13",{"hid":740,"name":740,"content":127},"citation_journal_title",{"hid":742,"name":742,"content":723},"citation_publisher",{"hid":744,"name":744,"content":660},"citation_journal_abbrev",{"hid":746,"name":746,"content":661},"citation_issn",{"hid":748,"name":748,"content":552},"citation_doi",{"hid":750,"name":750,"content":751},"citation_firstpage","1950821",{"hid":753,"name":753,"content":754},"citation_language","English",{"hid":756,"name":756,"content":553},"citation_title",{"hid":758,"name":758,"content":759},"citation_keywords","human-robot interaction; socially assistive robotics; rehabilitation robotics; adaptive difficulty; behavior tree; TIAGo; Unilateral Spatial Neglect",{"hid":761,"name":761,"content":558},"citation_abstract",{"hid":763,"name":763,"content":567},"citation_article_type",{"hid":765,"name":765,"content":766},"citation_pdf_url","https://www.frontiersin.org/journals/robotics-and-ai/articles/10.3389/frobt.2026.1950821/pdf",{"hid":768,"name":768,"content":769},"citation_xml_url","https://www.frontiersin.org/journals/robotics-and-ai/articles/10.3389/frobt.2026.1950821/xml",{"hid":771,"name":771,"content":772},"citation_fulltext_world_readable","yes",{"hid":774,"name":774,"content":775},"citation_online_date","2026/09/23",{"hid":777,"name":777,"content":778},"citation_publication_date","2026/10/21",{"hid":780,"name":781,"content":782},"citation_author_0","citation_author","Soldi, Roberto ",{"hid":784,"name":785,"content":786},"citation_author_institution_0","citation_author_institution","Bioengineering Laboratory, Department of Electrical, Computer and Biomedical Engineering, University of Pavia, Italy",{"hid":788,"name":781,"content":789},"citation_author_1","Guerra, Bruna Maria Vittoria ",{"hid":791,"name":785,"content":786},"citation_author_institution_1",{"hid":793,"name":781,"content":794},"citation_author_2","Sozzi, Stefania ",{"hid":796,"name":785,"content":786},"citation_author_institution_2",{"hid":798,"name":781,"content":799},"citation_author_3","Lunghi, Francesco ",{"hid":801,"name":785,"content":786},"citation_author_institution_3",{"hid":803,"name":781,"content":804},"citation_author_4","Russo, Leo ",{"hid":806,"name":785,"content":786},"citation_author_institution_4",{"hid":808,"name":781,"content":809},"citation_author_5","Schmid, Micaela ",{"hid":811,"name":785,"content":786},"citation_author_institution_5",{"hid":813,"name":781,"content":814},"citation_author_6","Ramat, Stefano ",{"hid":816,"name":785,"content":786},"citation_author_institution_6",{"hid":818,"name":818,"content":819},"dc.identifier","doi:10.3389/frobt.2026.1950821",[821,824,827,829],{"src":822,"body":15,"type":823,"async":15},"https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?features=es6","text/javascript",{"innerHTML":825,"type":826},"MathJax.Hub.Config({\"CommonHTML\":{linebreaks:{automatic:true,width:\"container\"}}});","text/x-mathjax-config",{"src":828,"body":15,"type":823,"async":15},"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.1/MathJax.js?config=TeX-MML-AM_CHTML",{"src":830,"body":15,"type":823,"async":15},"https://crossmark-cdn.crossref.org/widget/v2.0/widget.js",{"journal":832,"doi":751,"articleType":567,"title":834,"authors":836,"onBehalfOf":21,"affiliations":858,"authorNotes":862,"publicationDate":940,"acceptedDate":941,"receivedDate":942,"revisedDate":941,"correctedDate":21,"retractedDate":21,"volume":672,"elocationId":551,"permissions":943,"keywords":960,"relatedArticles":975,"abstractContent":976,"bodyContent":1034,"appendixContent":8876,"statements":8877,"otherBackSections":9004,"referenceLists":9005,"references":12837,"figures":16259,"toc":17310,"correspondingAuthors":17323,"sectionAtAcceptance":136},{"title":127,"abbreviation":660,"issn":661,"publisherName":833},"Frontiers Media S.A.",[835],{"#text":553},[837,840,843,846,849,852,855],{"surname":582,"givenNames":581,"suffix":21,"affiliationsIndexes":838,"isCorresponding":347,"equalContrib":347,"hierarchySymbol":21,"footnoteSymbol":21,"loopUrl":839,"onBehalfOf":21},[412],"https://loop.frontiersin.org/people/3402120",{"surname":591,"givenNames":590,"suffix":21,"affiliationsIndexes":841,"isCorresponding":347,"equalContrib":347,"hierarchySymbol":21,"footnoteSymbol":21,"loopUrl":842,"onBehalfOf":21},[412],"https://loop.frontiersin.org/people/823353",{"surname":598,"givenNames":597,"suffix":21,"affiliationsIndexes":844,"isCorresponding":347,"equalContrib":347,"hierarchySymbol":21,"footnoteSymbol":21,"loopUrl":845,"onBehalfOf":21},[412],"https://loop.frontiersin.org/people/3692180",{"surname":605,"givenNames":604,"suffix":21,"affiliationsIndexes":847,"isCorresponding":347,"equalContrib":347,"hierarchySymbol":21,"footnoteSymbol":21,"loopUrl":848,"onBehalfOf":21},[412],"https://loop.frontiersin.org/people/3720130",{"surname":612,"givenNames":611,"suffix":21,"affiliationsIndexes":850,"isCorresponding":347,"equalContrib":347,"hierarchySymbol":21,"footnoteSymbol":21,"loopUrl":851,"onBehalfOf":21},[412],"https://loop.frontiersin.org/people/3720007",{"surname":619,"givenNames":618,"suffix":21,"affiliationsIndexes":853,"isCorresponding":347,"equalContrib":347,"hierarchySymbol":21,"footnoteSymbol":21,"loopUrl":854,"onBehalfOf":21},[412],"https://loop.frontiersin.org/people/898973",{"surname":626,"givenNames":625,"suffix":21,"affiliationsIndexes":856,"isCorresponding":15,"equalContrib":347,"hierarchySymbol":21,"footnoteSymbol":21,"loopUrl":857,"onBehalfOf":21},[412],"https://loop.frontiersin.org/people/5560",[859],{"index":409,"baseText":21,"institution":586,"country":587,"address":860,"textContent":861},"Pavia","Bioengineering Laboratory, Department of Electrical, Computer and Biomedical Engineering, University of Pavia, Pavia, Italy",{"editedBy":863,"editedByContent":868,"reviewedBy":886,"reviewedByContent":899,"approvedBy":935,"approvedByContent":936,"correspondence":937,"equalContribution":938,"presentAddress":21,"other":939},[864],{"loopId":865,"fullName":866,"textContent":867},"1740191","Christian Tamantini","\n          Edited by:\n          Christian Tamantini, National Research Council (CNR), Italy",[869,871,884],{"#text":870},"\n        ",{"p":872},[873,875,882],{"#text":874},"\n          \n          ",{"ext-link":876,":@":878},[877],{"#text":866},{"@_ext-link-type":879,"@_xmlns:xlink":880,"@_xlink:href":881},"uri","http://www.w3.org/1999/xlink","https://loop.frontiersin.org/people/1740191/overview",{"#text":883},", National Research Council (CNR), Italy",{"#text":885},"\n      ",[887,891,895],{"loopId":888,"fullName":889,"textContent":890},"535877","Francesco Scotto di Luzio","\n          Reviewed by:\n          Francesco Scotto di Luzio, Campus Bio-Medico University, Italy",{"loopId":892,"fullName":893,"textContent":894},"860776","Jianwei Niu","\n          Jianwei Niu, University of Science and Technology Beijing, China",{"loopId":896,"fullName":897,"textContent":898},"3710261","Roberto Cittadini","\n          Roberto Cittadini, European Organization for Nuclear Research (CERN), Switzerland",[900,901,911,912,923,924,934],{"#text":870},{"p":902},[903,904,909],{"#text":874},{"ext-link":905,":@":907},[906],{"#text":889},{"@_ext-link-type":879,"@_xmlns:xlink":880,"@_xlink:href":908},"https://loop.frontiersin.org/people/535877/overview",{"#text":910},", Campus Bio-Medico University, Italy",{"#text":870},{"p":913},[914,916,921],{"#text":915},"\n          ",{"ext-link":917,":@":919},[918],{"#text":893},{"@_ext-link-type":879,"@_xlink:href":920},"https://loop.frontiersin.org/people/860776/overview",{"#text":922},", University of Science and Technology Beijing, China",{"#text":870},{"p":925},[926,927,932],{"#text":915},{"ext-link":928,":@":930},[929],{"#text":897},{"@_ext-link-type":879,"@_xlink:href":931},"https://loop.frontiersin.org/people/3710261/overview",{"#text":933},", European Organization for Nuclear Research (CERN), Switzerland",{"#text":885},[],[],"*Correspondence: Stefano Ramat, c3RlZmFuby5yYW1hdEB1bmlwdi5pdA==",[],[],"2026-10-21","2026-09-23","2026-07-28",{"copyrightStatement":944,"copyrightYear":945,"copyrightHolder":946,"licenseUrl":947,"licenseText":948},"Copyright © 2026 Soldi, Guerra, Sozzi, Lunghi, Russo, Schmid and Ramat.",2026,"Soldi, Guerra, Sozzi, Lunghi, Russo, Schmid and Ramat","https://creativecommons.org/licenses/by/4.0/",[949],{"p":950},[951,953,958],{"#text":952},"This is an open-access article distributed under the terms of the ",{"ext-link":954,":@":957},[955],{"#text":956},"Creative Commons Attribution License (CC BY)",{"@_ext-link-type":879,"@_xlink:href":947},{"#text":959},". The use, distribution or reproduction in other forums is permitted, provided the original author(s) and the copyright owner(s) are credited and that the original publication in this journal is cited, in accordance with accepted academic practice. No use, distribution or reproduction is permitted which does not comply with these terms.",[961,963,965,967,969,971,973],[962],{"#text":574},[964],{"#text":575},[966],{"#text":571},[968],{"#text":573},[970],{"#text":572},[972],{"#text":576},[974],{"#text":577},[],[977,978,991,992,1005,1006,1019,1020,1033],{"#text":870},{"sec":979},[980,981,985,986,990],{"#text":915},{"title":982},[983],{"#text":984},"Introduction",{"#text":915},{"p":987},[988],{"#text":989},"Robot-mediated neuro-motor rehabilitation offers intensive, repeatable, and objectively monitored therapy, yet existing systems rarely integrate automated session management, real-time per-repetition scoring, and data-driven adaptive difficulty progression within a single non-contact architecture. This work presents HemiBot (Hemineglect roBot), a ROS 2 software stack implementing a fully automated coaching pipeline for semicircular arm-pointing exercises on the TIAGo mobile manipulator (PAL Robotics), targeting post-stroke Unilateral Spatial Neglect (USN), in which patients fail to orient toward or interact with stimuli in the contralesional hemispace.",{"#text":870},{"#text":870},{"sec":993},[994,995,999,1000,1004],{"#text":915},{"title":996},[997],{"#text":998},"Methods",{"#text":915},{"p":1001},[1002],{"#text":1003},"The robot’s end effector moves into the neglected hemispace as an exogenous attentional cue while the participant actively reaches toward it with the affected arm. The system extends a skeletal tracking framework with a Behavior Tree orchestrating exercise execution and per-repetition metric computation, a Coach node performing session-level adaptive difficulty progression, Italian empathetic text-to-speech feedback, and a scoreboard for therapist supervision. The scoring metric combines arm-alignment angle and hand–end-effector distance in a logical AND gate, yielding a normalized 0–100 score partitioned into three performance bands (Fail \u003C25, Acceptable 25–75, Great ≥75). A participant is promoted when the mean session score exceeds 75 and demoted when the fail ratio reaches 0.50. Sixteen healthy participants (mean age 54.5 ± 6.8 years) were divided into two groups of eight: a high-performance group performing all repetitions correctly, and a low-performance group following a controlled error pattern designed to trigger demotion. Kinematic time series from the robot’s onboard RGB-D camera were compared against a stereophotogrammetric gold standard (BTS SMART-DX EVO).",{"#text":870},{"#text":870},{"sec":1007},[1008,1009,1013,1014,1018],{"#text":915},{"title":1010},[1011],{"#text":1012},"Results",{"#text":915},{"p":1015},[1016],{"#text":1017},"Scoring concordance between TIAGo- and mocap-derived classifications reached 100% (Cohen’s κ = 1.000) across all 120 repetitions, with no cross-band errors between Fail and Great. The executed arc trajectory showed near-perfect agreement with the commanded geometry (Pearson r > 0.99). Adaptive behavior was correct for all 16 participants.",{"#text":870},{"#text":870},{"sec":1021},[1022,1023,1027,1028,1032],{"#text":915},{"title":1024},[1025],{"#text":1026},"Discussion",{"#text":915},{"p":1029},[1030],{"#text":1031},"These findings verify that the onboard measurement chain reproduces gold-standard band assignments under the tested conditions and that the session-level decision pipeline operates end-to-end as specified. Validation of the scoring thresholds under naturally occurring, near-boundary performance remains necessary before clinical use.",{"#text":870},{"#text":885},[1035,1037,1428,1429,5869,5870,7992,7993,8831,8832,8874],{"#text":1036},"\n    ",{"sec":1038,":@":1425,"anchorId":1427},[1039,1041,1045,1046,1075,1076,1126,1127,1152,1153,1288,1289,1317,1318,1357,1358,1362,1363,1381,1382,1408,1409,1419,1420,1424],{"#text":1040},"\n      \n      ",{"title":1042},[1043],{"#text":1044},"1 Introduction",{"#text":885},{"p":1047},[1048,1050,1057,1059,1065,1067,1073],{"#text":1049},"Unilateral Spatial Neglect (USN, or Hemineglect) is a frequent and disabling cognitive consequence of right-hemisphere stroke. Patients fail to orient toward, perceive, or act on stimuli in the contralesional (typically left) side of space, despite intact primary sensory and motor function (",{"xref":1051,":@":1054},[1052],{"#text":1053},"Bazan et al., 2022",{"@_ref-type":1055,"@_rid":1056},"bibr","B4",{"#text":1058},"; ",{"xref":1060,":@":1063},[1061],{"#text":1062},"Karner et al., 2019",{"@_ref-type":1055,"@_rid":1064},"B21",{"#text":1066},"). The condition significantly prolongs hospitalisation, impedes rehabilitation, and is associated with poorer long-term functional outcomes (",{"xref":1068,":@":1071},[1069],{"#text":1070},"Winstein et al., 2016",{"@_ref-type":1055,"@_rid":1072},"B41",{"#text":1074},").",{"#text":885},{"p":1077},[1078,1080,1086,1088,1092,1094,1098,1100,1106,1108,1114,1115,1119,1121,1125],{"#text":1079},"USN is a heterogeneous disorder that manifests differently depending on the spatial reference frame affected (",{"xref":1081,":@":1084},[1082],{"#text":1083},"Williams et al., 2021",{"@_ref-type":1055,"@_rid":1085},"B40",{"#text":1087},"). In ",{"italic":1089},[1090],{"#text":1091},"egocentric",{"#text":1093}," neglect, the patient fails to orient toward or interact with stimuli in the contralesional hemispace relative to their own body; in ",{"italic":1095},[1096],{"#text":1097},"allocentric",{"#text":1099}," neglect, the patient ignores the contralesional side of individual objects, irrespective of their position in space (",{"xref":1101,":@":1104},[1102],{"#text":1103},"Marsh and Hillis, 2008",{"@_ref-type":1055,"@_rid":1105},"B23",{"#text":1107},"). The two forms are clinically dissociable: egocentric neglect is by far the more prevalent form, affecting the large majority of USN patients as the sole or dominant subtype (",{"xref":1109,":@":1112},[1110],{"#text":1111},"Demeyere and Gillebert, 2019",{"@_ref-type":1055,"@_rid":1113},"B10",{"#text":1058},{"xref":1116,":@":1118},[1117],{"#text":1103},{"@_ref-type":1055,"@_rid":1105},{"#text":1120},"). Critically, egocentric neglect is the primary determinant of impairment in peripersonal activities–those requiring interaction with objects and stimuli within arm’s reach–such as reaching, object manipulation, and self-care (",{"xref":1122,":@":1124},[1123],{"#text":1083},{"@_ref-type":1055,"@_rid":1085},{"#text":1074},{"#text":885},{"p":1128},[1129,1131,1137,1138,1144,1146,1150],{"#text":1130},"At the neural level, USN arises from the dysfunction of distributed fronto-parietal networks rather than from focal cortical damage alone (",{"xref":1132,":@":1135},[1133],{"#text":1134},"Corbetta and Shulman, 2011",{"@_ref-type":1055,"@_rid":1136},"B9",{"#text":1058},{"xref":1139,":@":1142},[1140],{"#text":1141},"Bartolomeo, 2021",{"@_ref-type":1055,"@_rid":1143},"B3",{"#text":1145},"). Damage to the right ventral fronto-parietal system disrupts both stimulus-driven reorienting and the broader network that controls voluntary spatial attention in body-centered coordinates, producing the characteristic egocentric spatial bias. Crucially, this network-based account opens a rehabilitative pathway: if intact nodes within the damaged network, or their homologs in the undamaged left hemisphere, can be recruited through appropriate sensorimotor activity, compensatory reorganisation becomes possible (",{"xref":1147,":@":1149},[1148],{"#text":1141},{"@_ref-type":1055,"@_rid":1143},{"#text":1151},"). Voluntary, goal-directed movement of the contralesional limb in contralesional space is one such activating strategy, engaging the same fronto-parietal circuits whose dysfunction underlies egocentric neglect.",{"#text":885},{"p":1154},[1155,1157,1161,1162,1166,1168,1174,1176,1180,1182,1188,1190,1194,1196,1200,1202,1206,1208,1214,1215,1221,1222,1228,1230,1236,1238,1242,1243,1249,1251,1254,1256,1259,1261,1267,1269,1275,1277,1281,1283,1287],{"#text":1156},"Conventional therapies–visual scanning training, prism adaptation, and non-invasive brain stimulation–predominantly address the perceptual-attentional component of egocentric neglect and show variable transfer to functional activities of daily life (",{"xref":1158,":@":1160},[1159],{"#text":1053},{"@_ref-type":1055,"@_rid":1056},{"#text":1058},{"xref":1163,":@":1165},[1164],{"#text":1062},{"@_ref-type":1055,"@_rid":1064},{"#text":1167},"). Cueing-based interventions offer a complementary approach: graded, performance-driven adaptation of attentional cues has been shown to produce significant improvements in visuospatial neglect measures and activities of daily living (",{"xref":1169,":@":1172},[1170],{"#text":1171},"Turgut et al., 2018",{"@_ref-type":1055,"@_rid":1173},"B37",{"#text":1175},"). The theoretical rationale for engaging the affected limb in USN rehabilitation can be framed within the ",{"italic":1177},[1178],{"#text":1179},"Where/Aiming",{"#text":1181}," model (",{"xref":1183,":@":1186},[1184],{"#text":1185},"Barrett et al., 2022",{"@_ref-type":1055,"@_rid":1187},"B2",{"#text":1189},"), which dissociates a perceptual-attentional deficit (",{"italic":1191},[1192],{"#text":1193},"Where",{"#text":1195},", impaired orienting toward contralesional space) from a motor-intentional deficit (",{"italic":1197},[1198],{"#text":1199},"Aiming",{"#text":1201},", impaired initiation and execution of movement directed into that space). The two components respond differentially to treatment (",{"xref":1203,":@":1205},[1204],{"#text":1185},{"@_ref-type":1055,"@_rid":1187},{"#text":1207},"), yet most neglect treatment studies assess only one of them. Limb activation and spatiomotor cueing approaches addressed this gap by showing that voluntary movement of the contralesional limb within contralesional hemispace can facilitate spatial representation in the damaged hemisphere (",{"xref":1209,":@":1212},[1210],{"#text":1211},"Robertson and North, 1992",{"@_ref-type":1055,"@_rid":1213},"B30",{"#text":1058},{"xref":1216,":@":1219},[1217],{"#text":1218},"Kalra et al., 1997",{"@_ref-type":1055,"@_rid":1220},"B20",{"#text":1058},{"xref":1223,":@":1226},[1224],{"#text":1225},"Robertson et al., 2002",{"@_ref-type":1055,"@_rid":1227},"B31",{"#text":1229},"). A recent systematic review further notes that the joint attentional-motor approach remains comparatively underexplored in robotic platforms (",{"xref":1231,":@":1234},[1232],{"#text":1233},"Somma et al., 2026",{"@_ref-type":1055,"@_rid":1235},"B33",{"#text":1237},"). The semicircular pointing exercise operationalizes this principle through a robot-driven visual stimulus that specifically targets egocentric peripersonal neglect: the arc is centered on the participant’s left shoulder, placing the therapeutic stimulus in body-centered contralesional space within arm’s reach–the spatial domain whose disruption underlies the most functionally disabling egocentric neglect symptoms (",{"xref":1239,":@":1241},[1240],{"#text":1134},{"@_ref-type":1055,"@_rid":1136},{"#text":1058},{"xref":1244,":@":1247},[1245],{"#text":1246},"Verdon et al., 2010",{"@_ref-type":1055,"@_rid":1248},"B38",{"#text":1250},"). The TIAGo end-effector moves into contralesional hemispace as an exogenous attentional cue, while the participant actively reaches toward it with the left arm, coupling the ",{"italic":1252},[1253],{"#text":1193},{"#text":1255}," and ",{"italic":1257},[1258],{"#text":1199},{"#text":1260}," components within a single non-contact task. Robot-assisted platforms have extended this principle to motor training. Exoskeleton-based systems such as the Armule (",{"xref":1262,":@":1265},[1263],{"#text":1264},"Chen et al., 2021",{"@_ref-type":1055,"@_rid":1266},"B7",{"#text":1268},") and manipulator-based platforms such as the REAplan (",{"xref":1270,":@":1273},[1271],{"#text":1272},"Doumas et al., 2025",{"@_ref-type":1055,"@_rid":1274},"B12",{"#text":1276},") deliver adaptive guidance through physical contact, achieving measurable motor gains. These systems, however, primarily target the motor execution component of neglect. Moreover, the paper-and-pencil assessments commonly used to evaluate their outcomes may fail to detect residual neglect that persists in everyday interaction with real three-dimensional objects (",{"xref":1278,":@":1280},[1279],{"#text":1141},{"@_ref-type":1055,"@_rid":1143},{"#text":1282},"). A recent systematic review confirms that robotic platforms remain underrepresented relative to virtual reality approaches and have rarely been designed to jointly capture attentional engagement and motor re-engagement within the same task (",{"xref":1284,":@":1286},[1285],{"#text":1233},{"@_ref-type":1055,"@_rid":1235},{"#text":1074},{"#text":885},{"p":1290},[1291,1293,1299,1301,1307,1309,1315],{"#text":1292},"Within the framework of the project described in (",{"xref":1294,":@":1297},[1295],{"#text":1296},"Guerra et al., 2025",{"@_ref-type":1055,"@_rid":1298},"B16",{"#text":1300},"), we propose an additional, complementary paradigm: non-contact visual stimulation delivered through the TIAGo mobile manipulator. Previous work on TIAGo for motor-cognitive rehabilitation has relied on physical contact and natural language interaction (",{"xref":1302,":@":1305},[1303],{"#text":1304},"Tamantini et al., 2023",{"@_ref-type":1055,"@_rid":1306},"B35",{"#text":1308},"); the present system adopts a fundamentally different approach, in which the robot’s end-effector serves as a moving attentional cue eliciting goal-directed pointing responses without any physical contact, targeting USN patients for whom exogenous visual cueing in the neglected hemispace is the primary therapeutic modality. The present work extends the robotic platform architecture previously described in ",{"xref":1310,":@":1313},[1311],{"#text":1312},"Soldi et al. (2025)",{"@_ref-type":1055,"@_rid":1314},"B32",{"#text":1316},", adding automated session management, per-repetition scoring, and adaptive difficulty progression to the existing exercise-delivery infrastructure.",{"#text":885},{"p":1319},[1320,1322,1325,1327,1332,1334,1340,1342,1345,1347,1350,1352,1355],{"#text":1321},"A direct measure of the attentional (",{"italic":1323},[1324],{"#text":1193},{"#text":1326},") component would require estimating where the participant is actually looking. In prior work (",{"xref":1328,":@":1331},[1329],{"#text":1330},"Soldi et al., 2025",{"@_ref-type":1055,"@_rid":1314},{"#text":1333},"), we explored MediaPipe Face Landmarker (",{"xref":1335,":@":1338},[1336],{"#text":1337},"Google LLC, 2020a",{"@_ref-type":1055,"@_rid":1339},"B13",{"#text":1341},") to estimate head rotation relative to the end-effector as a proxy for gaze direction, analogous to the arm-alignment metric used here for the motor component. However, under the experimental conditions of that study this approach proved insufficiently robust, producing large estimation errors caused by self-occlusion of facial landmarks during head rotation. For this reason, the present system does not yet implement a ",{"italic":1343},[1344],{"#text":1193},{"#text":1346},"-specific attentional measure, so that the results reported here focus on the motor-kinematic (",{"italic":1348},[1349],{"#text":1199},{"#text":1351},") component described above. A direct measure of the ",{"italic":1353},[1354],{"#text":1193},{"#text":1356}," component is nonetheless feasible in principle through wearable eye-tracking glasses, which record the wearer’s ocular movements and map the gaze point onto the scene: by verifying whether and when the participant’s gaze lands on the end-effector as it moves into the contralesional hemispace, such instrumentation would provide a continuous attentional variable analogous to the arm-alignment metric presented here for the motor component. This gaze-on-target signal is the attentional measurement modality we intend to integrate into HemiBot, and is discussed further in the Limitations and Future Directions sections.",{"#text":885},{"p":1359},[1360],{"#text":1361},"A critical question remains open for any clinically deployable robotic coaching system: can it autonomously manage a full rehabilitation session, assess per-repetition performance with sufficient reliability, and adapt exercise difficulty to the participant’s evolving capability? These three capabilities are rarely integrated and systematically validated together in the existing literature, and their joint demonstration is a prerequisite for clinical deployment.",{"#text":885},{"p":1364},[1365,1367,1371,1373,1379],{"#text":1366},"To enable autonomous, repeatable delivery of this paradigm, this paper presents ",{"italic":1368},[1369],{"#text":1370},"HemiBot",{"#text":1372}," (Hemineglect roBot), a ROS 2 (",{"xref":1374,":@":1377},[1375],{"#text":1376},"Open Robotics, 2022",{"@_ref-type":1055,"@_rid":1378},"B25",{"#text":1380},") software stack that extends the TIAGo platform with a Behavior Tree for exercise execution and per-repetition scoring, a Coach node for adaptive difficulty progression, and Italian empathetic text-to-speech (TTS) feedback.",{"#text":885},{"p":1383},[1384,1386],{"#text":1385},"The contributions of this work are threefold:",{"list":1387,":@":1406},[1388,1394,1400],{"list-item":1389},[1390],{"p":1391},[1392],{"#text":1393},"A complete, modular ROS 2 software architecture for autonomous rehabilitation session management, described in sufficient detail to support reproducibility and future extension.",{"list-item":1395},[1396],{"p":1397},[1398],{"#text":1399},"Validation of the per-repetition scoring metric against a stereophotogrammetric gold standard on 16 healthy participants across two sessions, quantifying the concordance between robot-derived and mocap-derived performance classifications.",{"list-item":1401},[1402],{"p":1403},[1404],{"#text":1405},"Controlled demonstration of correct adaptive behavior under two distinct performance conditions (high-performance and low-performance), confirming that the promotion and demotion logic operates as designed.",{"@_list-type":1407},"order",{"#text":885},{"p":1410},[1411,1413,1417],{"#text":1412},"The envisioned clinical deployment target is the Neurology Clinic ",{"italic":1414},[1415],{"#text":1416},"Fondazione IRCCS Mondino",{"#text":1418}," in Pavia, with a trained therapist always present during sessions. The system is conceived as a tool to enhance therapeutic efficiency, not to replace clinical judgment.",{"#text":885},{"p":1421},[1422],{"#text":1423},"The long-term objective underlying HemiBot is implementing a robotic system capable of autonomously managing a complete USN rehabilitation session, composed of multiple, heterogeneous exercise modalities, while continuously measuring patient performance and adapting task difficulty in real time. The present work addresses one constituent module of this broader architecture: a contactless, mobile visuo-motor stimulation exercise, together with its associated performance-scoring and adaptive-difficulty mechanisms. Accordingly, the study reported here should be considered as a technical validation of this specific module and of the underlying measurement/decision pipeline, through an experimental interaction with healthy volunteers. No clinical validation of the full multi-exercise session-management architecture, of its interaction with the target USN population and of its rehabilitative effectiveness was faced so far, but will be the object of future clinical trials.",{"#text":1036},{"@_sec-type":1426,"@_id":1427},"intro","s1",{"#text":1036},{"sec":1430,":@":5866,"anchorId":5868},[1431,1432,1436,1437,2175,2176,2199,2200,2271,2272,2626,2627,3018,3019,3588,3589,4376,4377,4689,4690,5209,5210,5865],{"#text":1040},{"title":1433},[1434],{"#text":1435},"2 Materials and methods",{"#text":885},{"sec":1438,":@":2173},[1439,1441,1445,1446,1553,1554,1818,1819,1879,1880,2172],{"#text":1440},"\n        \n        ",{"title":1442},[1443],{"#text":1444},"2.1 Exercise definition and difficulty levels",{"#text":870},{"p":1447},[1448,1450,1454,1456,1475,1477,1505,1507,1533,1535,1551],{"#text":1449},"The rehabilitation exercise consists of a ",{"italic":1451},[1452],{"#text":1453},"semicircular arm-pointing task",{"#text":1455},": the TIAGo end-effector moves along a circular arc centered on the participant’s left shoulder, first sweeping rightward (from ",{"inline-formula":1457,":@":1473},[1458],{"mml:math":1459,":@":1470},[1460],{"mml:mrow":1461},[1462,1466],{"mml:mn":1463},[1464],{"#text":1465},"0",{"mml:mo":1467},[1468],{"#text":1469},"°",{"@_id":1471,"@_xmlns:mml":1472},"m6","http://www.w3.org/1998/Math/MathML",{"@_id":1474},"inf6",{"#text":1476}," to ",{"inline-formula":1478,":@":1503},[1479],{"mml:math":1480,":@":1501},[1481],{"mml:mrow":1482},[1483,1487],{"mml:mo":1484},[1485],{"#text":1486},"+",{"mml:msub":1488},[1489,1495],{"mml:mrow":1490},[1491],{"mml:mi":1492},[1493],{"#text":1494},"θ",{"mml:mrow":1496},[1497],{"mml:mtext":1498},[1499],{"#text":1500},"max",{"@_id":1502},"m7",{"@_id":1504},"inf7",{"#text":1506},"), pausing at the extreme, then sweeping leftward across the midline (to ",{"inline-formula":1508,":@":1531},[1509],{"mml:math":1510,":@":1529},[1511],{"mml:mrow":1512},[1513,1517],{"mml:mo":1514},[1515],{"#text":1516},"−",{"mml:msub":1518},[1519,1524],{"mml:mrow":1520},[1521],{"mml:mi":1522},[1523],{"#text":1494},{"mml:mrow":1525},[1526],{"mml:mtext":1527},[1528],{"#text":1500},{"@_id":1530},"m8",{"@_id":1532},"inf8",{"#text":1534},"), pausing again, and returning to center. Angles are expressed in degrees relative to the anteroposterior axis, with forward defined as ",{"inline-formula":1536,":@":1549},[1537],{"mml:math":1538,":@":1547},[1539],{"mml:mrow":1540},[1541,1544],{"mml:mn":1542},[1543],{"#text":1465},{"mml:mo":1545},[1546],{"#text":1469},{"@_id":1548},"m9",{"@_id":1550},"inf9",{"#text":1552}," and clockwise as positive.",{"#text":870},{"p":1555},[1556,1558],{"#text":1557},"Each repetition is decomposed into five consecutive segments:",{"list":1559,":@":1817},[1560,1601,1668,1717,1777],{"list-item":1561},[1562],{"p":1563},[1564,1599],{"inline-formula":1565,":@":1597},[1566],{"mml:math":1567,":@":1595},[1568],{"mml:mrow":1569},[1570,1573,1576,1580,1583],{"mml:mn":1571},[1572],{"#text":1465},{"mml:mo":1574},[1575],{"#text":1469},{"mml:mo":1577},[1578],{"#text":1579},"→",{"mml:mo":1581},[1582],{"#text":1486},{"mml:msub":1584},[1585,1590],{"mml:mrow":1586},[1587],{"mml:mi":1588},[1589],{"#text":1494},{"mml:mrow":1591},[1592],{"mml:mtext":1593},[1594],{"#text":1500},{"@_id":1596},"m10",{"@_id":1598},"inf10",{"#text":1600}," (rightward sweep)",{"list-item":1602},[1603],{"p":1604},[1605,1607,1632,1634,1666],{"#text":1606},"Pause at ",{"inline-formula":1608,":@":1630},[1609],{"mml:math":1610,":@":1628},[1611],{"mml:mrow":1612},[1613,1616],{"mml:mo":1614},[1615],{"#text":1486},{"mml:msub":1617},[1618,1623],{"mml:mrow":1619},[1620],{"mml:mi":1621},[1622],{"#text":1494},{"mml:mrow":1624},[1625],{"mml:mtext":1626},[1627],{"#text":1500},{"@_id":1629},"m11",{"@_id":1631},"inf11",{"#text":1633}," (dwell time ",{"inline-formula":1635,":@":1664},[1636],{"mml:math":1637,":@":1662},[1638],{"mml:mrow":1639},[1640,1654,1658],{"mml:msub":1641},[1642,1648],{"mml:mrow":1643},[1644],{"mml:mi":1645},[1646],{"#text":1647},"t",{"mml:mrow":1649},[1650],{"mml:mtext":1651},[1652],{"#text":1653},"wait",{"mml:mo":1655},[1656],{"#text":1657},"=",{"mml:mn":1659},[1660],{"#text":1661},"2",{"@_id":1663},"m12",{"@_id":1665},"inf12",{"#text":1667},"s)",{"list-item":1669},[1670],{"p":1671},[1672,1715],{"inline-formula":1673,":@":1713},[1674],{"mml:math":1675,":@":1711},[1676],{"mml:mrow":1677},[1678,1681,1693,1696,1699],{"mml:mo":1679},[1680],{"#text":1486},{"mml:msub":1682},[1683,1688],{"mml:mrow":1684},[1685],{"mml:mi":1686},[1687],{"#text":1494},{"mml:mrow":1689},[1690],{"mml:mtext":1691},[1692],{"#text":1500},{"mml:mo":1694},[1695],{"#text":1579},{"mml:mo":1697},[1698],{"#text":1516},{"mml:msub":1700},[1701,1706],{"mml:mrow":1702},[1703],{"mml:mi":1704},[1705],{"#text":1494},{"mml:mrow":1707},[1708],{"mml:mtext":1709},[1710],{"#text":1500},{"@_id":1712},"m13",{"@_id":1714},"inf13",{"#text":1716}," (full crossing)",{"list-item":1718},[1719],{"p":1720},[1721,1722,1747,1748,1776],{"#text":1606},{"inline-formula":1723,":@":1745},[1724],{"mml:math":1725,":@":1743},[1726],{"mml:mrow":1727},[1728,1731],{"mml:mo":1729},[1730],{"#text":1516},{"mml:msub":1732},[1733,1738],{"mml:mrow":1734},[1735],{"mml:mi":1736},[1737],{"#text":1494},{"mml:mrow":1739},[1740],{"mml:mtext":1741},[1742],{"#text":1500},{"@_id":1744},"m14",{"@_id":1746},"inf14",{"#text":1633},{"inline-formula":1749,":@":1774},[1750],{"mml:math":1751,":@":1772},[1752],{"mml:mrow":1753},[1754,1766,1769],{"mml:msub":1755},[1756,1761],{"mml:mrow":1757},[1758],{"mml:mi":1759},[1760],{"#text":1647},{"mml:mrow":1762},[1763],{"mml:mtext":1764},[1765],{"#text":1653},{"mml:mo":1767},[1768],{"#text":1657},{"mml:mn":1770},[1771],{"#text":1661},{"@_id":1773},"m15",{"@_id":1775},"inf15",{"#text":1667},{"list-item":1778},[1779],{"p":1780},[1781,1815],{"inline-formula":1782,":@":1813},[1783],{"mml:math":1784,":@":1811},[1785],{"mml:mrow":1786},[1787,1790,1802,1805,1808],{"mml:mo":1788},[1789],{"#text":1516},{"mml:msub":1791},[1792,1797],{"mml:mrow":1793},[1794],{"mml:mi":1795},[1796],{"#text":1494},{"mml:mrow":1798},[1799],{"mml:mtext":1800},[1801],{"#text":1500},{"mml:mo":1803},[1804],{"#text":1579},{"mml:mn":1806},[1807],{"#text":1465},{"mml:mo":1809},[1810],{"#text":1469},{"@_id":1812},"m16",{"@_id":1814},"inf16",{"#text":1816}," (return to center)",{"@_list-type":1407},{"#text":870},{"p":1820},[1821,1823,1845,1847,1854,1856,1877],{"#text":1822},"Three difficulty levels are defined by varying ",{"inline-formula":1824,":@":1843},[1825],{"mml:math":1826,":@":1841},[1827],{"mml:mrow":1828},[1829],{"mml:msub":1830},[1831,1836],{"mml:mrow":1832},[1833],{"mml:mi":1834},[1835],{"#text":1494},{"mml:mrow":1837},[1838],{"mml:mtext":1839},[1840],{"#text":1500},{"@_id":1842},"m17",{"@_id":1844},"inf17",{"#text":1846}," (",{"xref":1848,":@":1851},[1849],{"#text":1850},"Table 1",{"@_ref-type":1852,"@_rid":1853},"table","T1",{"#text":1855},"). All levels share the same arc radius (",{"inline-formula":1857,":@":1875},[1858],{"mml:math":1859,":@":1873},[1860],{"mml:mrow":1861},[1862,1866,1869],{"mml:mi":1863},[1864],{"#text":1865},"r",{"mml:mo":1867},[1868],{"#text":1657},{"mml:mn":1870},[1871],{"#text":1872},"0.85",{"@_id":1874},"m18",{"@_id":1876},"inf18",{"#text":1878}," m), end-effector angular velocity, and number of repetitions per session (3). Trajectory parameters are specified in a YAML configuration file loaded at runtime by the Coach node, making it straightforward to add or modify difficulty levels without code changes.",{"#text":870},{"table-wrap":1881,":@":2170},[1882,1883,1887,1888,1949,1950,2169],{"#text":915},{"label":1884},[1885],{"#text":1886},"TABLE 1",{"#text":915},{"caption":1889},[1890,1892,1948],{"#text":1891},"\n            ",{"p":1893},[1894,1896,1915,1917,1946],{"#text":1895},"Difficulty levels for the semicircular arm-pointing task. All levels share the same arc radius (",{"inline-formula":1897,":@":1913},[1898],{"mml:math":1899,":@":1911},[1900],{"mml:mrow":1901},[1902,1905,1908],{"mml:mi":1903},[1904],{"#text":1865},{"mml:mo":1906},[1907],{"#text":1657},{"mml:mn":1909},[1910],{"#text":1872},{"@_id":1912},"m19",{"@_id":1914},"inf19",{"#text":1916}," m), angular velocity, repetitions per session (3), and dwell time at extremes (",{"inline-formula":1918,":@":1944},[1919],{"mml:math":1920,":@":1942},[1921],{"mml:mrow":1922},[1923,1935,1938],{"mml:msub":1924},[1925,1930],{"mml:mrow":1926},[1927],{"mml:mi":1928},[1929],{"#text":1647},{"mml:mrow":1931},[1932],{"mml:mtext":1933},[1934],{"#text":1653},{"mml:mo":1936},[1937],{"#text":1657},{"mml:mn":1939},[1940],{"#text":1941},"2.0",{"@_id":1943},"m20",{"@_id":1945},"inf20",{"#text":1947}," s).",{"#text":915},{"#text":915},{"table":1951},[1952,1953,2026,2027,2168],{"#text":1891},{"thead":1954,":@":2024},[1955,1957,2023],{"#text":1956},"\n              ",{"tr":1958},[1959,1961,1967,1968,2016,2017,2022],{"#text":1960},"\n                ",{"th":1962,":@":1965},[1963],{"#text":1964},"Level",{"@_align":1966},"left",{"#text":1960},{"th":1969,":@":2014},[1970,1972,2012],{"#text":1971},"\n                  ",{"inline-formula":1973,":@":2010},[1974,1976,2009],{"#text":1975},"\n                    ",{"mml:math":1977,":@":2007},[1978,1980,2006],{"#text":1979},"\n                      ",{"mml:mrow":1981},[1982,1984,2005],{"#text":1983},"\n                        ",{"mml:msub":1985},[1986,1988,1996,1997,2004],{"#text":1987},"\n                          ",{"mml:mrow":1989},[1990,1992,1995],{"#text":1991},"\n                            ",{"mml:mi":1993},[1994],{"#text":1494},{"#text":1987},{"#text":1987},{"mml:mrow":1998},[1999,2000,2003],{"#text":1991},{"mml:mtext":2001},[2002],{"#text":1500},{"#text":1987},{"#text":1983},{"#text":1979},{"#text":1975},{"@_id":2008},"m21",{"#text":1971},{"@_id":2011},"inf21",{"#text":2013}," (deg)",{"@_align":2015},"center",{"#text":1960},{"th":2018,":@":2021},[2019],{"#text":2020},"Arc extent (deg)",{"@_align":2015},{"#text":1956},{"#text":1891},{"@_valign":2025},"top",{"#text":1891},{"tbody":2028,":@":2167},[2029,2030,2076,2077,2121,2122,2166],{"#text":1956},{"tr":2031},[2032,2033,2038,2039,2069,2070,2075],{"#text":1960},{"td":2034,":@":2037},[2035],{"#text":2036},"Easy",{"@_align":1966},{"#text":1960},{"td":2040,":@":2068},[2041,2042,2067],{"#text":1971},{"inline-formula":2043,":@":2065},[2044,2045,2064],{"#text":1975},{"mml:math":2046,":@":2062},[2047,2048,2061],{"#text":1979},{"mml:mrow":2049},[2050,2051,2055,2056,2060],{"#text":1983},{"mml:mo":2052},[2053],{"#text":2054},"±",{"#text":1983},{"mml:mn":2057},[2058],{"#text":2059},"10",{"#text":1979},{"#text":1975},{"@_id":2063},"m22",{"#text":1971},{"@_id":2066},"inf22",{"#text":1960},{"@_align":2015},{"#text":1960},{"td":2071,":@":2074},[2072],{"#text":2073},"20",{"@_align":2015},{"#text":1956},{"#text":1956},{"tr":2078},[2079,2080,2084,2085,2114,2115,2120],{"#text":1960},{"td":2081,":@":2083},[2082],{"#text":326},{"@_align":1966},{"#text":1960},{"td":2086,":@":2113},[2087,2088,2112],{"#text":1971},{"inline-formula":2089,":@":2110},[2090,2091,2109],{"#text":1975},{"mml:math":2092,":@":2107},[2093,2094,2106],{"#text":1979},{"mml:mrow":2095},[2096,2097,2100,2101,2105],{"#text":1983},{"mml:mo":2098},[2099],{"#text":2054},{"#text":1983},{"mml:mn":2102},[2103],{"#text":2104},"15",{"#text":1979},{"#text":1975},{"@_id":2108},"m23",{"#text":1971},{"@_id":2111},"inf23",{"#text":1960},{"@_align":2015},{"#text":1960},{"td":2116,":@":2119},[2117],{"#text":2118},"30",{"@_align":2015},{"#text":1956},{"#text":1956},{"tr":2123},[2124,2125,2130,2131,2159,2160,2165],{"#text":1960},{"td":2126,":@":2129},[2127],{"#text":2128},"Hard",{"@_align":1966},{"#text":1960},{"td":2132,":@":2158},[2133,2134,2157],{"#text":1971},{"inline-formula":2135,":@":2155},[2136,2137,2154],{"#text":1975},{"mml:math":2138,":@":2152},[2139,2140,2151],{"#text":1979},{"mml:mrow":2141},[2142,2143,2146,2147,2150],{"#text":1983},{"mml:mo":2144},[2145],{"#text":2054},{"#text":1983},{"mml:mn":2148},[2149],{"#text":2073},{"#text":1979},{"#text":1975},{"@_id":2153},"m24",{"#text":1971},{"@_id":2156},"inf24",{"#text":1960},{"@_align":2015},{"#text":1960},{"td":2161,":@":2164},[2162],{"#text":2163},"40",{"@_align":2015},{"#text":1956},{"#text":1891},{"@_valign":2025},{"#text":915},{"#text":870},{"@_id":1853,"@_position":2171},"float",{"#text":885},{"@_id":2174},"s2-1",{"#text":885},{"sec":2177,":@":2197},[2178,2179,2183,2184,2196],{"#text":1440},{"title":2180},[2181],{"#text":2182},"2.2 Hardware platform",{"#text":870},{"p":2185},[2186,2188,2194],{"#text":2187},"The experimental platform is the TIAGo mobile manipulator (PAL Robotics), a service robot featuring a mobile base, height-adjustable torso, 2-DOF head, and 7-DOF arm providing kinematic redundancy. Onboard sensors include an RGB-D camera and a 4-microphone array. The arm is equipped with a parallel gripper that can hold objects serving as visual stimulus. The full hardware description and technical specifications are provided in ",{"xref":2189,":@":2192},[2190],{"#text":2191},"PAL Robotics (2026)",{"@_ref-type":1055,"@_rid":2193},"B27",{"#text":2195},"; the present description is limited to the software architecture built on top of this platform.",{"#text":885},{"@_id":2198},"s2-2",{"#text":885},{"sec":2201,":@":2269},[2202,2203,2207,2208,2242,2243,2268],{"#text":1440},{"title":2204},[2205],{"#text":2206},"2.3 Software architecture overview",{"#text":870},{"p":2209},[2210,2212],{"#text":2211},"Two independent layers cooperate to manage a rehabilitation session:",{"list":2213,":@":2240},[2214,2220],{"list-item":2215},[2216],{"p":2217},[2218],{"#text":2219},"Session layer (Coach node): a ROS 2 node that loads the session plan from a YAML configuration file, sequences the exercises, dispatches triggers to the BT, collects session-aggregate results and displays them on a real-time graphical scoreboard visible to the experimenter, and decides the difficulty level for subsequent sessions.",{"list-item":2221},[2222],{"p":2223},[2224,2226,2230,2232,2238],{"#text":2225},"Execution layer (Behavior Tree): a ROS 2 BT node implemented in Python using the ",{"monospace":2227},[2228],{"#text":2229},"py_trees",{"#text":2231}," library (",{"xref":2233,":@":2236},[2234],{"#text":2235},"Stonier, 2025",{"@_ref-type":1055,"@_rid":2237},"B34",{"#text":2239},"). It coordinates real-time exercise execution, kinematic monitoring, per-repetition metric computation, and emergency stop handling. This layer operates at the timescale of individual repetitions.",{"@_list-type":2241},"bullet",{"#text":870},{"p":2244},[2245,2247,2251,2253,2257,2259,2266],{"#text":2246},"The graphical interface allows the therapist to monitor session progress in real time and, if needed, confirm or override individual repetitions before the BT advances. Empathetic feedback in Italian is delivered to the participant after each repetition ",{"italic":2248},[2249],{"#text":2250},"via",{"#text":2252}," the",{"monospace":2254},[2255],{"#text":2256},"/tts_engine/tts",{"#text":2258}," action server natively available on the TIAGo platform, with messages selected probabilistically from predefined pools corresponding to the three performance bands (Fail, Acceptable, Great). Representative examples of these messages are provided in the ",{"xref":2260,":@":2263},[2261],{"#text":2262},"Supplementary Material",{"@_ref-type":2264,"@_rid":2265},"sec","s12",{"#text":2267},".",{"#text":885},{"@_id":2270},"s2-3",{"#text":885},{"sec":2273,":@":2624},[2274,2275,2279,2280,2444,2445,2466,2467,2556,2557,2623],{"#text":1440},{"title":2276},[2277],{"#text":2278},"2.4 TIAGo arm action server",{"#text":870},{"p":2281},[2282,2284,2288,2290,2296,2298],{"#text":2283},"The low-level arm control is handled by a custom C++ ROS 2 node, ",{"monospace":2285},[2286],{"#text":2287},"tiago_arm_action_server",{"#text":2289},", implemented using the MoveIt 2 motion planning framework (",{"xref":2291,":@":2294},[2292],{"#text":2293},"PickNik Robotics, 2025",{"@_ref-type":1055,"@_rid":2295},"B28",{"#text":2297},"). The node exposes two ROS 2 action interfaces:",{"list":2299,":@":2443},[2300,2333],{"list-item":2301},[2302],{"p":2303},[2304,2308,2309,2313,2315,2331],{"monospace":2305},[2306],{"#text":2307},"/tiago_arm/setup_pose",{"#text":1846},{"monospace":2310},[2311],{"#text":2312},"SetupPose",{"#text":2314}," action): brings the arm to a predefined joint-space configuration prior to each repetition, ensuring a consistent and ergonomically appropriate starting posture. Specifically, the setup pose corresponds to the neutral position of the semicircular trajectory (",{"inline-formula":2316,":@":2329},[2317],{"mml:math":2318,":@":2327},[2319],{"mml:mrow":2320},[2321,2324],{"mml:mn":2322},[2323],{"#text":1465},{"mml:mo":2325},[2326],{"#text":1469},{"@_id":2328},"m25",{"@_id":2330},"inf25",{"#text":2332}," eccentricity), with the end-effector placed at the center of the arc in front of the participant. This guarantees that each repetition begins from a well-defined, reproducible arm configuration that is geometrically aligned with the subsequent motion.",{"list-item":2334},[2335],{"p":2336},[2337,2341,2342,2346,2348,2352,2354,2367,2369,2392,2394,2417,2419,2441],{"monospace":2338},[2339],{"#text":2340},"/tiago_arm/execute_motion",{"#text":1846},{"monospace":2343},[2344],{"#text":2345},"ExecuteMotion",{"#text":2347}," action): executes a Cartesian-space arc trajectory from the starting position using the ",{"monospace":2349},[2350],{"#text":2351},"semicircle",{"#text":2353}," motion type. The trajectory is parametrized by the arc center (the participant’s left shoulder), the radius ",{"inline-formula":2355,":@":2365},[2356],{"mml:math":2357,":@":2363},[2358],{"mml:mrow":2359},[2360],{"mml:mi":2361},[2362],{"#text":1865},{"@_id":2364},"m26",{"@_id":2366},"inf26",{"#text":2368},", and the start and end angles (",{"inline-formula":2370,":@":2390},[2371],{"mml:math":2372,":@":2388},[2373],{"mml:mrow":2374},[2375],{"mml:msub":2376},[2377,2382],{"mml:mrow":2378},[2379],{"mml:mi":2380},[2381],{"#text":1494},{"mml:mrow":2383},[2384],{"mml:mtext":2385},[2386],{"#text":2387},"start",{"@_id":2389},"m27",{"@_id":2391},"inf27",{"#text":2393},", ",{"inline-formula":2395,":@":2415},[2396],{"mml:math":2397,":@":2413},[2398],{"mml:mrow":2399},[2400],{"mml:msub":2401},[2402,2407],{"mml:mrow":2403},[2404],{"mml:mi":2405},[2406],{"#text":1494},{"mml:mrow":2408},[2409],{"mml:mtext":2410},[2411],{"#text":2412},"end",{"@_id":2414},"m28",{"@_id":2416},"inf28",{"#text":2418},") relative to the anteroposterior axis. The arc is discretized into Cartesian waypoints spaced by a configurable angular step, with an optional dwell time ",{"inline-formula":2420,":@":2439},[2421],{"mml:math":2422,":@":2437},[2423],{"mml:mrow":2424},[2425],{"mml:msub":2426},[2427,2432],{"mml:mrow":2428},[2429],{"mml:mi":2430},[2431],{"#text":1647},{"mml:mrow":2433},[2434],{"mml:mtext":2435},[2436],{"#text":1653},{"@_id":2438},"m29",{"@_id":2440},"inf29",{"#text":2442}," at each waypoint. The end-effector orientation is continuously adjusted so that the gripper always faces the arc center, preserving a consistent stimulus orientation at every eccentricity. Progress feedback (phase and completion ratio) is published at 5 Hz.",{"@_list-type":2241},{"#text":870},{"sec":2446,":@":2464},[2447,2448,2452,2453,2463],{"#text":874},{"title":2449},[2450],{"#text":2451},"2.4.1 Cartesian path planning and velocity profiling",{"#text":915},{"p":2454},[2455,2457,2461],{"#text":2456},"Trajectory execution relies on MoveIt 2 Cartesian path computation (",{"monospace":2458},[2459],{"#text":2460},"computeCartesianPath",{"#text":2462},"), which interpolates end-effector poses along the requested path while respecting joint limits and collision constraints. A custom trapezoidal velocity profile is then applied to the resulting joint trajectory: the profile is parameterized by the desired segment transition time and scaled by configurable maximum joint velocity and acceleration factors, ensuring smooth acceleration and deceleration at the beginning and end of each motion segment. Before execution, the trajectory is validated against joint velocity and acceleration limits; if any limit is violated the goal is aborted and an informative error is returned to the caller.",{"#text":870},{"@_id":2465},"s2-4-1",{"#text":870},{"sec":2468,":@":2554},[2469,2470,2474,2475,2553],{"#text":874},{"title":2471},[2472],{"#text":2473},"2.4.2 Collision avoidance with dynamic patient model",{"#text":915},{"p":2476},[2477,2479,2483,2485,2489,2491,2521,2523,2527,2529,2535,2537,2540,2541,2545,2547,2551],{"#text":2478},"The action server integrates a real-time patient collision model into the MoveIt 2 planning scene. The patient’s skeletal joint positions, published as a ",{"monospace":2480},[2481],{"#text":2482},"MarkerArray",{"#text":2484}," on",{"monospace":2486},[2487],{"#text":2488},"/skeleton3d_markers",{"#text":2490}," by the monitoring node in the BT, are translated into spherical collision objects (radius ",{"inline-formula":2492,":@":2519},[2493],{"mml:math":2494,":@":2517},[2495],{"mml:mrow":2496},[2497,2510,2513],{"mml:msub":2498},[2499,2504],{"mml:mrow":2500},[2501],{"mml:mi":2502},[2503],{"#text":1865},{"mml:mrow":2505},[2506],{"mml:mtext":2507},[2508],{"#text":2509},"skel",{"mml:mo":2511},[2512],{"#text":1657},{"mml:mn":2514},[2515],{"#text":2516},"0.10",{"@_id":2518},"m30",{"@_id":2520},"inf30",{"#text":2522},"m) and applied to the ",{"monospace":2524},[2525],{"#text":2526},"PlanningSceneInterface",{"#text":2528}," at every incoming frame. Stale objects from the previous frame are removed before each update. Additionally, the OctoMap occupancy representation (",{"xref":2530,":@":2533},[2531],{"#text":2532},"Hornung et al., 2013",{"@_ref-type":1055,"@_rid":2534},"B19",{"#text":2536},"), built directly from the raw depth stream independently of skeletal tracking, is cleared ",{"italic":2538},[2539],{"#text":2250},{"#text":2252},{"monospace":2542},[2543],{"#text":2544},"/clear_octomap",{"#text":2546}," service only at the start of each motion and is otherwise continuously repopulated during execution. Because it relies on depth measurements rather than skeleton keypoints, the OctoMap layer keeps marking the participant’s body volume as occupied even if the skeletal tracker temporarily loses or degrades its joint estimates, providing a coarser but tracking-independent fallback around the tighter, keypoint-driven spherical margin. Together, these two representations are intended to make the motion planner account for the participant’s current body configuration when computing each trajectory segment. At the trajectory level, the reaching targets themselves are designed ",{"italic":2548},[2549],{"#text":2550},"a priori",{"#text":2552}," to keep the end-effector at a safe distance from the participant throughout the task, rather than relying on collision avoidance alone to prevent contact.",{"#text":870},{"@_id":2555},"s2-4-2",{"#text":870},{"sec":2558,":@":2621},[2559,2560,2564,2565,2620],{"#text":874},{"title":2561},[2562],{"#text":2563},"2.4.3 Emergency stop and preemption",{"#text":915},{"p":2566},[2567,2569,2573,2574,2578,2580,2584,2586,2590,2592,2595,2597,2601,2603,2607,2609,2613,2615,2618],{"#text":2568},"The action server monitors two Boolean flags, ",{"monospace":2570},[2571],{"#text":2572},"estop_active_",{"#text":1255},{"monospace":2575},[2576],{"#text":2577},"cancel_requested_",{"#text":2579},", checked at each iteration of the execution loop. An Emergency-Stop (E-Stop) message received on",{"monospace":2581},[2582],{"#text":2583},"/protocol/session/stop",{"#text":2585}," sets both flags to true atomically and calls ",{"monospace":2587},[2588],{"#text":2589},"move_group_->stop()",{"#text":2591}," for immediate arm deceleration, causing the executing thread to terminate at the next loop iteration. New goals are rejected while ",{"monospace":2593},[2594],{"#text":2572},{"#text":2596}," is set; the flag is cleared only upon receipt of a resume message on",{"monospace":2598},[2599],{"#text":2600},"/protocol/session/resume",{"#text":2602},", after which ",{"monospace":2604},[2605],{"#text":2606},"clearPoseTargets()",{"#text":2608}," discards any residual MoveIt 2 state. The end-to-end responsiveness of the stop mechanism is bounded on the software side by the Behavior Tree tick rate: since ",{"monospace":2610},[2611],{"#text":2612},"EStopMonitor",{"#text":2614}," and the action-server execution loop are evaluated at 30 Hz, an E-Stop event is detected and ",{"monospace":2616},[2617],{"#text":2589},{"#text":2619}," is issued within one tick, i.e., approximately 33 ms in the worst case, before mechanical deceleration begins. We note, however, that this figure characterizes only the software detection-to-command latency; the additional hardware contribution, actuator command latency and the physical deceleration time and distance of the arm, was not experimentally measured in the present study. A dedicated characterization of the full stopping latency and stopping distance under representative motion conditions was outside the scope of the present study and is left to future safety validation.",{"#text":870},{"@_id":2622},"s2-4-3",{"#text":885},{"@_id":2625},"s2-4",{"#text":885},{"sec":2628,":@":3016},[2629,2630,2634,2635,2669,2670,2769,2770,3010,3011,3015],{"#text":1440},{"title":2631},[2632],{"#text":2633},"2.5 Behavior Tree structure",{"#text":870},{"p":2636},[2637,2639,2643,2645,2652,2654,2657,2659,2662,2664,2668],{"#text":2638},"The Behavior Tree (BT) has a two-level ",{"monospace":2640},[2641],{"#text":2642},"Parallel",{"#text":2644}," structure (",{"xref":2646,":@":2649},[2647],{"#text":2648},"Figure 1",{"@_ref-type":2650,"@_rid":2651},"fig","F1",{"#text":2653},"). In py_trees, a ",{"monospace":2655},[2656],{"#text":2642},{"#text":2658}," node ticks all children at every BT cycle, allowing multiple children to be in the running state simultaneously within the same thread. Crucially, regardless of the success policy, any failure returned by a child immediately propagates to the parent ",{"monospace":2660},[2661],{"#text":2642},{"#text":2663},", which halts all sibling behaviors and returns failure (",{"xref":2665,":@":2667},[2666],{"#text":2235},{"@_ref-type":1055,"@_rid":2237},{"#text":1074},{"#text":870},{"fig":2671,":@":2768},[2672,2673,2677,2678,2753,2754,2767],{"#text":915},{"label":2674},[2675],{"#text":2676},"FIGURE 1",{"#text":915},{"caption":2679},[2680,2681,2752],{"#text":1891},{"p":2682},[2683,2685,2688,2690,2694,2696,2699,2701,2705,2707,2710,2711,2715,2717,2721,2723,2727,2729,2733,2735,2739,2741,2745,2747,2751],{"#text":2684},"The root ",{"monospace":2686},[2687],{"#text":2642},{"#text":2689}," node (",{"monospace":2691},[2692],{"#text":2693},"SuccessOnOne",{"#text":2695},") runs the ",{"monospace":2697},[2698],{"#text":2612},{"#text":2700}," safety leaf alongside ",{"monospace":2702},[2703],{"#text":2704},"RehabRoot",{"#text":2706},", a second ",{"monospace":2708},[2709],{"#text":2642},{"#text":2689},{"monospace":2712},[2713],{"#text":2714},"SuccessOnAll",{"#text":2716},") that concurrently executes the perception and logging leaves–",{"monospace":2718},[2719],{"#text":2720},"SkeletonTracker",{"#text":2722}," (body-joint tracking), ",{"monospace":2724},[2725],{"#text":2726},"HandPointingMetrics",{"#text":2728}," (real-time scoring), ",{"monospace":2730},[2731],{"#text":2732},"SessionAggregator",{"#text":2734}," (session-level aggregation), and ",{"monospace":2736},[2737],{"#text":2738},"RobotLinkTracker",{"#text":2740}," (robot kinematics logging) – together with the ",{"monospace":2742},[2743],{"#text":2744},"RehabPipeline",{"#text":2746}," subtree, which drives exercise execution through ",{"monospace":2748},[2749],{"#text":2750},"SendExercise",{"#text":2267},{"#text":915},{"#text":915},{"graphic":2755,":@":2764},[2756,2757,2763],{"#text":1891},{"alt-text":2758,":@":2761},[2759],{"#text":2760},"Flowchart illustrating a system hierarchy where Root SuccessOnOne leads to EStopMonitor and RehabRoot SuccessOnAll. RehabRoot branches into SkeletonTracker, HandPointingMetrics, SessionAggregator, RobotLinkTracker, and RehabPipeline, with RehabPipeline connecting to SendExercise.",{"@_content-type":2762},"machine-generated",{"#text":915},{"@_mimetype":405,"@_mime-subtype":2765,"@_xmlns:xlink":880,"@_xlink:href":2766},"tiff","frobt-13-1950821-g001.tif",{"#text":870},{"@_id":2651,"@_position":2171},{"#text":870},{"p":2771},[2772,2774,2777,2779,2782,2784,2787,2789,2792,2794,2797,2798,2801,2803,2806,2808,2811,2812,2815,2816,2819,2820,2823,2825,2828,2830,2833,2834,2837,2839,2842,2844,2847,2848],{"#text":2773},"The tree is designed to remain in running indefinitely under normal operation: ",{"monospace":2775},[2776],{"#text":2612},{"#text":2778}," returns running as long as no stop signal is received, and ",{"monospace":2780},[2781],{"#text":2750},{"#text":2783}," is programmed to return running at all times–including after the completion of a full exercise sequence, when it automatically resets and awaits the next trigger. This design ensures that neither the exercise pipeline nor the monitoring leaves ever terminate the tree through success; the only mechanism that can abort the session is ",{"monospace":2785},[2786],{"#text":2612},{"#text":2788}," returning failure upon receiving a message on",{"monospace":2790},[2791],{"#text":2583},{"#text":2793},". This failure propagates instantaneously through the root ",{"monospace":2795},[2796],{"#text":2642},{"#text":1846},{"monospace":2799},[2800],{"#text":2693},{"#text":2802},"), halting ",{"monospace":2804},[2805],{"#text":2704},{"#text":2807}," and all five of its children simultaneously–",{"monospace":2809},[2810],{"#text":2720},{"#text":2393},{"monospace":2813},[2814],{"#text":2726},{"#text":2393},{"monospace":2817},[2818],{"#text":2732},{"#text":2393},{"monospace":2821},[2822],{"#text":2738},{"#text":2824},", and ",{"monospace":2826},[2827],{"#text":2744},{"#text":2829},"–regardless of the current phase of exercise execution. The ",{"monospace":2831},[2832],{"#text":2693},{"#text":1255},{"monospace":2835},[2836],{"#text":2714},{"#text":2838}," policies on the two ",{"monospace":2840},[2841],{"#text":2642},{"#text":2843}," nodes therefore define the nominal success semantics of the tree, but under normal operation neither is triggered: session termination is exclusively event-driven through ",{"monospace":2845},[2846],{"#text":2612},{"#text":2267},{"list":2849,":@":3009},[2850,2874,2892,2924,2973,2991],{"list-item":2851},[2852],{"p":2853},[2854,2856,2860,2862,2866,2868,2872],{"#text":2855},"SendExercise: waits for a JSON trigger on the topic",{"monospace":2857},[2858],{"#text":2859},"/protocol/exercise/execute",{"#text":2861},", commands the TIAGo arm action server to execute the prescribed trajectory sequence for each repetition, and publishes repetition results to",{"monospace":2863},[2864],{"#text":2865},"/protocol/exercise/repetition_result",{"#text":2867},". After each repetition it pauses and awaits confirmation (",{"monospace":2869},[2870],{"#text":2871},"/protocol/exercise/agent_feedback",{"#text":2873},") before advancing. This node manages the entire repetition lifecycle: setup pose, motion execution, result publication, and repeat/abort logic.",{"list-item":2875},[2876],{"p":2877},[2878,2880,2884,2886,2890],{"#text":2879},"RobotLinkTracker: records the robot’s kinematic state throughout the session to enable post-hoc validation of the motion control pipeline. Subscribing to",{"monospace":2881},[2882],{"#text":2883},"/joint_states",{"#text":2885}," and querying the TF tree for the end-effector pose in the ",{"italic":2887},[2888],{"#text":2889},"base_footprint",{"#text":2891}," frame, it timestamps and logs, at a fixed rate, both the commanded and the measured joint trajectories together with the corresponding Cartesian pose of the gripper. Data are optionally serialized to CSV files, allowing offline analysis.",{"list-item":2893},[2894],{"p":2895},[2896,2898,2904,2906,2909,2911,2917,2919,2922],{"#text":2897},"SkeletonTracker: performs three-dimensional, markerless tracking of the participant’s body joints, publishing the results as TF frames consumed by HandPointingMetrics. RGB and depth streams are processed with MediaPipe Pose ",{"xref":2899,":@":2902},[2900],{"#text":2901},"Google LLC (2020b)",{"@_ref-type":1055,"@_rid":2903},"B14",{"#text":2905}," to extract landmarks, which are back-projected into 3D ",{"italic":2907},[2908],{"#text":2250},{"#text":2910}," the pinhole camera model ",{"xref":2912,":@":2915},[2913],{"#text":2914},"OpenCV (2026)",{"@_ref-type":1055,"@_rid":2916},"B26",{"#text":2918}," and transformed into the ",{"italic":2920},[2921],{"#text":2889},{"#text":2923}," frame using the URDF (Unified Robot Description Format) kinematic chain. Only four joints (shoulders and wrists) are tracked to limit data volume and occlusion issues, with a 3D Kalman filter smoothing the trajectories. The 3D Kalman filter smooths the per-frame landmark estimates produced by the markerless pipeline, which are intrinsically noisy; it is not used to bridge missing observations by prediction. MediaPipe’s per-landmark visibility score is recorded alongside each estimate but is not currently used as an explicit confidence threshold, and no explicit occlusion (or self-occlusion) detection is performed. The only criterion for discarding a sample is the depth reading: a landmark is treated as missing for a given frame whenever the corresponding pixel yields an invalid or unavailable depth value, in which case the sample is omitted rather than replaced by a filtered or extrapolated estimate. Occlusions that still yield a valid depth reading are therefore retained and may introduce artifacts in the tracked trajectory, an effect not addressed in the present work.",{"list-item":2925},[2926],{"p":2927},[2928,2930,2943,2945,2958,2960,2966,2968,2972],{"#text":2929},"HandPointingMetrics: monitors the participant’s kinematic response in real time by reading TF frames published by SkeletonTracker. It implements a three-state machine (idle",{"inline-formula":2931,":@":2941},[2932],{"mml:math":2933,":@":2939},[2934],{"mml:mrow":2935},[2936],{"mml:mo":2937},[2938],{"#text":1579},{"@_id":2940},"m31",{"@_id":2942},"inf31",{"#text":2944},"recording",{"inline-formula":2946,":@":2956},[2947],{"mml:math":2948,":@":2954},[2949],{"mml:mrow":2950},[2951],{"mml:mo":2952},[2953],{"#text":1579},{"@_id":2955},"m32",{"@_id":2957},"inf32",{"#text":2959},"processing) synchronized with the exercise status on the BT blackboard. During recording, it accumulates metric samples at each BT tick (30Hz). At processing, it computes the per-repetition score (",{"xref":2961,":@":2964},[2962],{"#text":2963},"Section 2.6",{"@_ref-type":2264,"@_rid":2965},"s2-6",{"#text":2967},") and writes the results to the blackboard. Optionally, it saves full kinematic timeseries as CSV files and publishes them on",{"monospace":2969},[2970],{"#text":2971},"/protocol/exercise/kinematics_timeseries",{"#text":2267},{"list-item":2974},[2975],{"p":2976},[2977,2979,2983,2985,2989],{"#text":2978},"SessionAggregator: collects per-repetition metrics from the blackboard whenever a repetition is validated, accumulates them in an internal history, and computes session-aggregate statistics (mean score, mean arm misalignment, mean hand distance, mean duration). At session end, it publishes a structured JSON report on",{"monospace":2980},[2981],{"#text":2982},"/protocol/exercise_result",{"#text":2984}," with ",{"monospace":2986},[2987],{"#text":2988},"TRANSIENT_LOCAL",{"#text":2990}," QoS, ensuring the Coach node receives the report even if it subscribes after publication. The JSON report is self-contained and schema-consistent across sessions, making it directly suitable for ingestion into a longitudinal participant database without further post-processing.",{"list-item":2992},[2993],{"p":2994},[2995,2997,3000,3002,3007],{"#text":2996},"EStopMonitor: polls the emergency stop status at each tick. If an E-Stop event is detected, it sets a flag on the blackboard and returns failure, causing the ",{"monospace":2998},[2999],{"#text":2642},{"#text":3001}," node to abort all sibling behaviors and terminate the session. This mirrors the preemption logic implemented in the action server (",{"xref":3003,":@":3006},[3004],{"#text":3005},"Section 2.4",{"@_ref-type":2264,"@_rid":2625},{"#text":3008},"), ensuring that an E-Stop event is handled consistently at both the motion control level and the session orchestration level.",{"@_list-type":1407},{"#text":870},{"p":3012},[3013],{"#text":3014},"The Parallel structure guarantees that kinematic monitoring and aggregation remain active throughout the entire session, regardless of the state of exercise execution, without requiring explicit synchronisation between nodes.",{"#text":885},{"@_id":3017},"s2-5",{"#text":885},{"sec":3020,":@":3587},[3021,3022,3026,3027,3184,3185,3493,3494,3586],{"#text":1440},{"title":3023},[3024],{"#text":3025},"2.6 Per-repetition scoring metric",{"#text":870},{"p":3028},[3029,3031,3067,3069,3075,3077],{"#text":3030},"Task performance for each repetition is quantified by a normalized score ",{"inline-formula":3032,":@":3065},[3033],{"mml:math":3034,":@":3063},[3035],{"mml:mrow":3036},[3037,3041,3045],{"mml:mi":3038},[3039],{"#text":3040},"S",{"mml:mo":3042},[3043],{"#text":3044},"∈",{"mml:mrow":3046},[3047,3052,3058],{"mml:mo":3048,":@":3051},[3049],{"#text":3050},"[",{"@_stretchy":347},{"mml:mrow":3053},[3054],{"mml:mn":3055},[3056],{"#text":3057},"0,100",{"mml:mo":3059,":@":3062},[3060],{"#text":3061},"]",{"@_stretchy":347},{"@_id":3064},"m33",{"@_id":3066},"inf33",{"#text":3068}," computed from two kinematic indicators, both validated against a stereophotogrammetric reference system in the present study (",{"xref":3070,":@":3073},[3071],{"#text":3072},"Section 3.1",{"@_ref-type":2264,"@_rid":3074},"s3-1",{"#text":3076},"):",{"list":3078,":@":3183},[3079,3116],{"list-item":3080},[3081],{"p":3082},[3083,3085,3099,3101,3114],{"#text":3084},"Arm alignment angle ",{"inline-formula":3086,":@":3097},[3087],{"mml:math":3088,":@":3095},[3089],{"mml:mrow":3090},[3091],{"mml:mi":3092},[3093],{"#text":3094},"α",{"@_id":3096},"m34",{"@_id":3098},"inf34",{"#text":3100}," (degrees): the angle between the segment connecting the participant’s wrist to their shoulder and the segment connecting the robot end-effector to the participant’s shoulder. A smaller ",{"inline-formula":3102,":@":3112},[3103],{"mml:math":3104,":@":3110},[3105],{"mml:mrow":3106},[3107],{"mml:mi":3108},[3109],{"#text":3094},{"@_id":3111},"m35",{"@_id":3113},"inf35",{"#text":3115}," indicates more accurate pointing.",{"list-item":3117},[3118],{"p":3119},[3120,3122,3136,3138,3151,3153,3166,3168,3181],{"#text":3121},"Hand–end-effector distance ",{"inline-formula":3123,":@":3134},[3124],{"mml:math":3125,":@":3132},[3126],{"mml:mrow":3127},[3128],{"mml:mi":3129},[3130],{"#text":3131},"d",{"@_id":3133},"m36",{"@_id":3135},"inf36",{"#text":3137}," (meters): the Euclidean distance between the participant’s wrist and the robot end effector. While ",{"inline-formula":3139,":@":3149},[3140],{"mml:math":3141,":@":3147},[3142],{"mml:mrow":3143},[3144],{"mml:mi":3145},[3146],{"#text":3094},{"@_id":3148},"m37",{"@_id":3150},"inf37",{"#text":3152}," captures whether the participant is pointing in the correct direction, ",{"inline-formula":3154,":@":3164},[3155],{"mml:math":3156,":@":3162},[3157],{"mml:mrow":3158},[3159],{"mml:mi":3160},[3161],{"#text":3131},{"@_id":3163},"m38",{"@_id":3165},"inf38",{"#text":3167}," specifically captures whether the participant also extends the arm toward the target, so that a small ",{"inline-formula":3169,":@":3179},[3170],{"mml:math":3171,":@":3177},[3172],{"mml:mrow":3173},[3174],{"mml:mi":3175},[3176],{"#text":3131},{"@_id":3178},"m39",{"@_id":3180},"inf39",{"#text":3182}," indicates genuine reaching rather than directional pointing alone.",{"@_list-type":2241},{"#text":870},{"p":3186},[3187,3189,3221,3222,3251,3253,3257,3259,3263,3265,3272,3274,3420,3422,3435,3437,3467,3469,3486,3488,3491],{"#text":3188},"The two indicators are evaluated against fixed threshold values (",{"inline-formula":3190,":@":3219},[3191],{"mml:math":3192,":@":3217},[3193],{"mml:mrow":3194},[3195,3208,3211,3214],{"mml:msub":3196},[3197,3202],{"mml:mrow":3198},[3199],{"mml:mi":3200},[3201],{"#text":3094},{"mml:mrow":3203},[3204],{"mml:mtext":3205},[3206],{"#text":3207},"th",{"mml:mo":3209},[3210],{"#text":1657},{"mml:mn":3212},[3213],{"#text":2059},{"mml:mo":3215},[3216],{"#text":1469},{"@_id":3218},"m40",{"@_id":3220},"inf40",{"#text":2393},{"inline-formula":3223,":@":3249},[3224],{"mml:math":3225,":@":3247},[3226],{"mml:mrow":3227},[3228,3240,3243],{"mml:msub":3229},[3230,3235],{"mml:mrow":3231},[3232],{"mml:mi":3233},[3234],{"#text":3131},{"mml:mrow":3236},[3237],{"mml:mtext":3238},[3239],{"#text":3207},{"mml:mo":3241},[3242],{"#text":1657},{"mml:mn":3244},[3245],{"#text":3246},"0.50",{"@_id":3248},"m41",{"@_id":3250},"inf41",{"#text":3252},"m) using a logical and gate: a sample is classified as ",{"italic":3254},[3255],{"#text":3256},"on-target",{"#text":3258}," only if both conditions are satisfied simultaneously. The and gate prevents false positives arising from cases in which the arm points in the correct direction but does not reach the target, or ",{"italic":3260},[3261],{"#text":3262},"vice versa",{"#text":3264},". The score is computed as the proportion of on-target samples within the interval of interest for each repetition as defined in ",{"xref":3266,":@":3269},[3267],{"#text":3268},"Equation 1",{"@_ref-type":3270,"@_rid":3271},"disp-formula","e1",{"#text":3273},":",{"disp-formula":3275,":@":3419},[3276,3415],{"mml:math":3277,":@":3413},[3278],{"mml:mrow":3279},[3280,3283,3286,3290,3294],{"mml:mi":3281},[3282],{"#text":3040},{"mml:mo":3284},[3285],{"#text":1657},{"mml:mn":3287},[3288],{"#text":3289},"100",{"mml:mo":3291},[3292],{"#text":3293},"×",{"mml:mfrac":3295},[3296,3408],{"mml:mrow":3297},[3298,3328,3333,3337],{"mml:mstyle":3299,":@":3327},[3300],{"mml:msubsup":3301},[3302,3308,3321],{"mml:mrow":3303},[3304],{"mml:mo":3305},[3306],{"#text":3307},"∑",{"mml:mrow":3309},[3310,3314,3317],{"mml:mi":3311},[3312],{"#text":3313},"k",{"mml:mo":3315},[3316],{"#text":1657},{"mml:mn":3318},[3319],{"#text":3320},"1",{"mml:mrow":3322},[3323],{"mml:mi":3324},[3325],{"#text":3326},"N",{"@_displaystyle":15},{"mml:mn":3329,":@":3331},[3330],{"#text":3320},{"@_mathvariant":3332},"bold",{"mml:mspace":3334,":@":3335},[],{"@_width":3336},"-0.17em",{"mml:mfenced":3338,":@":3407},[3339],{"mml:mrow":3340},[3341,3353,3357,3369,3373,3377,3380,3392,3395],{"mml:msub":3342},[3343,3348],{"mml:mrow":3344},[3345],{"mml:mi":3346},[3347],{"#text":3094},{"mml:mrow":3349},[3350],{"mml:mi":3351},[3352],{"#text":3313},{"mml:mo":3354},[3355],{"#text":3356},"≤",{"mml:msub":3358},[3359,3364],{"mml:mrow":3360},[3361],{"mml:mi":3362},[3363],{"#text":3094},{"mml:mrow":3365},[3366],{"mml:mtext":3367},[3368],{"#text":3207},{"mml:mtext":3370},[3371],{"#text":3372}," ",{"mml:mo":3374},[3375],{"#text":3376},"∧",{"mml:mtext":3378},[3379],{"#text":3372},{"mml:msub":3381},[3382,3387],{"mml:mrow":3383},[3384],{"mml:mi":3385},[3386],{"#text":3131},{"mml:mrow":3388},[3389],{"mml:mi":3390},[3391],{"#text":3313},{"mml:mo":3393},[3394],{"#text":3356},{"mml:msub":3396},[3397,3402],{"mml:mrow":3398},[3399],{"mml:mi":3400},[3401],{"#text":3131},{"mml:mrow":3403},[3404],{"mml:mtext":3405},[3406],{"#text":3207},{"@_open":3050,"@_close":3061},{"mml:mrow":3409},[3410],{"mml:mi":3411},[3412],{"#text":3326},{"@_id":3414},"m42",{"label":3416},[3417],{"#text":3418},"(1)",{"@_id":3271},{"#text":3421},"where ",{"inline-formula":3423,":@":3433},[3424],{"mml:math":3425,":@":3431},[3426],{"mml:mrow":3427},[3428],{"mml:mi":3429},[3430],{"#text":3326},{"@_id":3432},"m43",{"@_id":3434},"inf42",{"#text":3436}," is the total number of samples in the interval and ",{"inline-formula":3438,":@":3465},[3439],{"mml:math":3440,":@":3463},[3441],{"mml:mrow":3442},[3443,3447],{"mml:mn":3444,":@":3446},[3445],{"#text":3320},{"@_mathvariant":3332},{"mml:mrow":3448},[3449,3453,3459],{"mml:mo":3450,":@":3452},[3451],{"#text":3050},{"@_stretchy":347},{"mml:mrow":3454},[3455],{"mml:mo":3456},[3457],{"#text":3458},"⋅",{"mml:mo":3460,":@":3462},[3461],{"#text":3061},{"@_stretchy":347},{"@_id":3464},"m44",{"@_id":3466},"inf43",{"#text":3468}," is the indicator function. The score is evaluated over the entire duration of the repetition, from the initial setup pose to the return to the center, with samples acquired at the camera frame rate (",{"inline-formula":3470,":@":3484},[3471],{"mml:math":3472,":@":3482},[3473],{"mml:mrow":3474},[3475,3479],{"mml:mo":3476},[3477],{"#text":3478},"≈",{"mml:mn":3480},[3481],{"#text":2118},{"@_id":3483},"m45",{"@_id":3485},"inf44",{"#text":3487},"Hz) by the ",{"monospace":3489},[3490],{"#text":2726},{"#text":3492}," node.",{"#text":870},{"p":3495},[3496,3498],{"#text":3497},"Three performance bands partition the score range:",{"list":3499,":@":3585},[3500,3527,3559],{"list-item":3501},[3502],{"p":3503},[3504,3525],{"inline-formula":3505,":@":3523},[3506],{"mml:math":3507,":@":3521},[3508],{"mml:mrow":3509},[3510,3513,3517],{"mml:mi":3511},[3512],{"#text":3040},{"mml:mo":3514},[3515],{"#text":3516},"\u003C",{"mml:mn":3518},[3519],{"#text":3520},"25",{"@_id":3522},"m46",{"@_id":3524},"inf45",{"#text":3526},": Fail–the repetition is rejected and must be repeated.",{"list-item":3528},[3529],{"p":3530},[3531,3557],{"inline-formula":3532,":@":3555},[3533],{"mml:math":3534,":@":3553},[3535],{"mml:mrow":3536},[3537,3540,3543,3546,3549],{"mml:mn":3538},[3539],{"#text":3520},{"mml:mo":3541},[3542],{"#text":3356},{"mml:mi":3544},[3545],{"#text":3040},{"mml:mo":3547},[3548],{"#text":3516},{"mml:mn":3550},[3551],{"#text":3552},"75",{"@_id":3554},"m47",{"@_id":3556},"inf46",{"#text":3558},": Acceptable–the repetition is validated; the participant proceeds.",{"list-item":3560},[3561],{"p":3562},[3563,3583],{"inline-formula":3564,":@":3581},[3565],{"mml:math":3566,":@":3579},[3567],{"mml:mrow":3568},[3569,3572,3576],{"mml:mi":3570},[3571],{"#text":3040},{"mml:mo":3573},[3574],{"#text":3575},"≥",{"mml:mn":3577},[3578],{"#text":3552},{"@_id":3580},"m48",{"@_id":3582},"inf47",{"#text":3584},": Great–the repetition is validated as high-quality performance.",{"@_list-type":2241},{"#text":885},{"@_id":2965},{"#text":885},{"sec":3590,":@":4374},[3591,3592,3596,3597,3614,3615,3924,3925,3942,3943,3997,3998,4201,4202,4373],{"#text":1440},{"title":3593},[3594],{"#text":3595},"2.7 Adaptive difficulty progression",{"#text":870},{"p":3598},[3599,3601,3604,3606,3612],{"#text":3600},"After each session, the Coach node reads the aggregate report published by ",{"monospace":3602},[3603],{"#text":2732},{"#text":3605}," and applies the decision rules in ",{"xref":3607,":@":3610},[3608],{"#text":3609},"Table 2",{"@_ref-type":1852,"@_rid":3611},"T2",{"#text":3613}," to determine the difficulty level for the subsequent session. Demotion takes precedence over promotion: if both conditions are simultaneously satisfied (e.g., due to a high score on the few successful attempts but a high overall fail ratio), the demotion rule is applied.",{"#text":870},{"table-wrap":3616,":@":3923},[3617,3618,3622,3623,3680,3681,3922],{"#text":915},{"label":3619},[3620],{"#text":3621},"TABLE 2",{"#text":915},{"caption":3624},[3625,3626,3679],{"#text":1891},{"p":3627},[3628,3630,3652,3654,3677],{"#text":3629},"Adaptive difficulty progression rules. ",{"inline-formula":3631,":@":3650},[3632],{"mml:math":3633,":@":3648},[3634],{"mml:mrow":3635},[3636],{"mml:mover":3637,":@":3647},[3638,3643],{"mml:mrow":3639},[3640],{"mml:mi":3641},[3642],{"#text":3040},{"mml:mo":3644},[3645],{"#text":3646},"̄",{"@_accent":15},{"@_id":3649},"m49",{"@_id":3651},"inf48",{"#text":3653},": mean score over all repetitions attempted in the session, including those classified as Fail. ",{"inline-formula":3655,":@":3675},[3656],{"mml:math":3657,":@":3673},[3658],{"mml:mrow":3659},[3660],{"mml:msub":3661},[3662,3667],{"mml:mrow":3663},[3664],{"mml:mi":3665},[3666],{"#text":1865},{"mml:mrow":3668},[3669],{"mml:mtext":3670},[3671],{"#text":3672},"fail",{"@_id":3674},"m50",{"@_id":3676},"inf49",{"#text":3678},": ratio of failed attempts (including retries) to total attempts. Demotion takes precedence over promotion.",{"#text":915},{"#text":915},{"table":3682},[3683,3684,3710,3711,3921],{"#text":1891},{"thead":3685,":@":3709},[3686,3687,3708],{"#text":1956},{"tr":3688},[3689,3690,3695,3696,3701,3702,3707],{"#text":1960},{"th":3691,":@":3694},[3692],{"#text":3693},"Condition",{"@_align":1966},{"#text":1960},{"th":3697,":@":3700},[3698],{"#text":3699},"Action",{"@_align":1966},{"#text":1960},{"th":3703,":@":3706},[3704],{"#text":3705},"Rationale",{"@_align":1966},{"#text":1956},{"#text":1891},{"@_valign":2025},{"#text":1891},{"tbody":3712,":@":3920},[3713,3714,3778,3779,3845,3846,3919],{"#text":1956},{"tr":3715},[3716,3717,3765,3766,3771,3772,3777],{"#text":1960},{"td":3718,":@":3764},[3719,3720,3763],{"#text":1971},{"inline-formula":3721,":@":3761},[3722,3723,3760],{"#text":1975},{"mml:math":3724,":@":3758},[3725,3726,3757],{"#text":1979},{"mml:mrow":3727},[3728,3729,3748,3749,3752,3753,3756],{"#text":1983},{"mml:msub":3730},[3731,3732,3739,3740,3747],{"#text":1987},{"mml:mrow":3733},[3734,3735,3738],{"#text":1991},{"mml:mi":3736},[3737],{"#text":1865},{"#text":1987},{"#text":1987},{"mml:mrow":3741},[3742,3743,3746],{"#text":1991},{"mml:mtext":3744},[3745],{"#text":3672},{"#text":1987},{"#text":1983},{"#text":1983},{"mml:mo":3750},[3751],{"#text":3575},{"#text":1983},{"mml:mn":3754},[3755],{"#text":3246},{"#text":1979},{"#text":1975},{"@_id":3759},"m51",{"#text":1971},{"@_id":3762},"inf50",{"#text":1960},{"@_align":1966},{"#text":1960},{"td":3767,":@":3770},[3768],{"#text":3769},"Demote to previous level",{"@_align":1966},{"#text":1960},{"td":3773,":@":3776},[3774],{"#text":3775},"Session predominantly failed",{"@_align":1966},{"#text":1956},{"#text":1956},{"tr":3780},[3781,3782,3832,3833,3838,3839,3844],{"#text":1960},{"td":3783,":@":3831},[3784,3785,3830],{"#text":1971},{"inline-formula":3786,":@":3828},[3787,3788,3827],{"#text":1975},{"mml:math":3789,":@":3825},[3790,3791,3824],{"#text":1979},{"mml:mrow":3792},[3793,3794,3815,3816,3819,3820,3823],{"#text":1983},{"mml:mrow":3795},[3796,3797,3814],{"#text":1987},{"mml:mover":3798,":@":3813},[3799,3800,3808,3809,3812],{"#text":1991},{"mml:mrow":3801},[3802,3804,3807],{"#text":3803},"\n                              ",{"mml:mi":3805},[3806],{"#text":3040},{"#text":1991},{"#text":1991},{"mml:mo":3810},[3811],{"#text":3646},{"#text":1987},{"@_accent":15},{"#text":1983},{"#text":1983},{"mml:mo":3817},[3818],{"#text":3575},{"#text":1983},{"mml:mn":3821},[3822],{"#text":3552},{"#text":1979},{"#text":1975},{"@_id":3826},"m52",{"#text":1971},{"@_id":3829},"inf51",{"#text":1960},{"@_align":1966},{"#text":1960},{"td":3834,":@":3837},[3835],{"#text":3836},"Promote to next level",{"@_align":1966},{"#text":1960},{"td":3840,":@":3843},[3841],{"#text":3842},"Consistent high performance",{"@_align":1966},{"#text":1956},{"#text":1956},{"tr":3847},[3848,3849,3906,3907,3912,3913,3918],{"#text":1960},{"td":3850,":@":3905},[3851,3852,3904],{"#text":1971},{"inline-formula":3853,":@":3902},[3854,3855,3901],{"#text":1975},{"mml:math":3856,":@":3899},[3857,3858,3898],{"#text":1979},{"mml:mrow":3859},[3860,3861,3864,3865,3868,3869,3889,3890,3893,3894,3897],{"#text":1983},{"mml:mn":3862},[3863],{"#text":3520},{"#text":1983},{"mml:mo":3866},[3867],{"#text":3356},{"#text":1983},{"mml:mrow":3870},[3871,3872,3888],{"#text":1987},{"mml:mover":3873,":@":3887},[3874,3875,3882,3883,3886],{"#text":1991},{"mml:mrow":3876},[3877,3878,3881],{"#text":3803},{"mml:mi":3879},[3880],{"#text":3040},{"#text":1991},{"#text":1991},{"mml:mo":3884},[3885],{"#text":3646},{"#text":1987},{"@_accent":15},{"#text":1983},{"#text":1983},{"mml:mo":3891},[3892],{"#text":3516},{"#text":1983},{"mml:mn":3895},[3896],{"#text":3552},{"#text":1979},{"#text":1975},{"@_id":3900},"m53",{"#text":1971},{"@_id":3903},"inf52",{"#text":1960},{"@_align":1966},{"#text":1960},{"td":3908,":@":3911},[3909],{"#text":3910},"Maintain current level",{"@_align":1966},{"#text":1960},{"td":3914,":@":3917},[3915],{"#text":3916},"Acceptable, consolidate",{"@_align":1966},{"#text":1956},{"#text":1891},{"@_valign":2025},{"#text":915},{"#text":870},{"@_id":3611,"@_position":2171},{"#text":870},{"p":3926},[3927,3929,3932,3934,3940],{"#text":3928},"The progression rules, thresholds, and initial difficulty level are all configurable in the YAML session plan. At the end of each repetition, the system delivers immediate qualitative feedback to the participant ",{"italic":3930},[3931],{"#text":2250},{"#text":3933}," a TTS message in Italian, selected probabilistically from predefined pools corresponding to the three performance bands (Fail, Acceptable, Great). After determining the next difficulty level, the Coach node additionally synthesizes a session-level TTS message selected from three pools corresponding to the demotion, maintain, and promotion outcomes, informing the participant of the session result and the plan for the next session. ",{"xref":3935,":@":3938},[3936],{"#text":3937},"Figure 2",{"@_ref-type":2650,"@_rid":3939},"F2",{"#text":3941}," presents the therapist’s view of the scoreboard, showing the results generated by the system, including scores, categories and output utterances.",{"#text":870},{"fig":3944,":@":3996},[3945,3946,3950,3951,3983,3984,3995],{"#text":915},{"label":3947},[3948],{"#text":3949},"FIGURE 2",{"#text":915},{"caption":3952},[3953,3954,3982],{"#text":1891},{"p":3955},[3956,3958,3962,3964,3968,3970,3974,3976,3980],{"#text":3957},"Per-repetition feedback generated by the Coach node for a representative subject across two consecutive sessions (three repetitions each). For every repetition, the table reports the repetition index (",{"italic":3959},[3960],{"#text":3961},"Rep",{"#text":3963},"), the numeric score (",{"italic":3965},[3966],{"#text":3967},"Punteggio",{"#text":3969},"), the qualitative outcome (",{"italic":3971},[3972],{"#text":3973},"Esito",{"#text":3975},"), and the corresponding natural-language feedback message given to the participant. In this example, all six repetitions across both sessions achieved the maximum score (100.0, ",{"monospace":3977},[3978],{"#text":3979},"GREAT",{"#text":3981},"), with the system varying the feedback phrasing between repetitions to avoid repetitive, mechanical-sounding encouragement.",{"#text":915},{"#text":915},{"graphic":3985,":@":3993},[3986,3987,3992],{"#text":1891},{"alt-text":3988,":@":3991},[3989],{"#text":3990},"Screenshot of a table with six rows and four columns labeled Rep, Punteggio, Esito, and feedback in Italian, all showing a score of one hundred, result \"GREAT\", and positive motivational comments.",{"@_content-type":2762},{"#text":915},{"@_mimetype":405,"@_mime-subtype":2765,"@_xlink:href":3994},"frobt-13-1950821-g002.tif",{"#text":870},{"@_id":3939,"@_position":2171},{"#text":870},{"p":3999},[4000,4002,4021,4022,4041,4043,4049,4051,4057,4059,4065,4067,4092,4094,4098,4100,4131,4133,4162,4164,4199],{"#text":4001},"The performance band boundaries (",{"inline-formula":4003,":@":4019},[4004],{"mml:math":4005,":@":4017},[4006],{"mml:mrow":4007},[4008,4011,4014],{"mml:mi":4009},[4010],{"#text":3040},{"mml:mo":4012},[4013],{"#text":1657},{"mml:mn":4015},[4016],{"#text":3520},{"@_id":4018},"m54",{"@_id":4020},"inf53",{"#text":2393},{"inline-formula":4023,":@":4039},[4024],{"mml:math":4025,":@":4037},[4026],{"mml:mrow":4027},[4028,4031,4034],{"mml:mi":4029},[4030],{"#text":3040},{"mml:mo":4032},[4033],{"#text":1657},{"mml:mn":4035},[4036],{"#text":3552},{"@_id":4038},"m55",{"@_id":4040},"inf54",{"#text":4042},") were derived from clinical practice in consultation with the rehabilitation specialists at Fondazione IRCCS Mondino, and are consistent with adaptive difficulty frameworks established in robot-assisted rehabilitation: a target success rate of approximately 70% has been identified as optimal for balancing motivation and challenge, with session-level demotion triggered when performance falls substantially below this range (",{"xref":4044,":@":4047},[4045],{"#text":4046},"Metzger et al., 2014",{"@_ref-type":1055,"@_rid":4048},"B24",{"#text":4050},"), analogous to the concept of proximal development zone in which a task is neither trivially easy nor beyond reach (",{"xref":4052,":@":4055},[4053],{"#text":4054},"Vygotsky, 1978",{"@_ref-type":1055,"@_rid":4056},"B39",{"#text":4058},"). This is also in line with the Challenge Point framework (",{"xref":4060,":@":4063},[4061],{"#text":4062},"Guadagnoli and Lee, 2004",{"@_ref-type":1055,"@_rid":4064},"B15",{"#text":4066},"), according to which learning is optimized when functional task difficulty is matched to the performer’s skill level: a task that is too easy conveys little corrective information and one that is too difficult overwhelms the learner’s capacity to interpret feedback, so an intermediate, sustained band of performance (here, the Acceptable range ",{"inline-formula":4068,":@":4090},[4069],{"mml:math":4070,":@":4088},[4071],{"mml:mrow":4072},[4073,4076,4079,4082,4085],{"mml:mn":4074},[4075],{"#text":3520},{"mml:mo":4077},[4078],{"#text":3356},{"mml:mi":4080},[4081],{"#text":3040},{"mml:mo":4083},[4084],{"#text":3516},{"mml:mn":4086},[4087],{"#text":3552},{"@_id":4089},"m56",{"@_id":4091},"inf55",{"#text":4093},") is expected to support consolidation rather than triggering an immediate change in difficulty. The specific value of the upper threshold is further supported by a recent clinical validation of a dynamic-difficulty-adjustment mechanism for combined motor-cognitive robotic rehabilitation after stroke, which adopted a reference success rate of 75% as the target for balancing motivation and learning, and used deviations from this target to drive difficulty adaptation in a manner directly analogous to the promotion/demotion logic used here (",{"xref":4095,":@":4097},[4096],{"#text":1272},{"@_ref-type":1055,"@_rid":1274},{"#text":4099},"). The upper boundary ",{"inline-formula":4101,":@":4129},[4102],{"mml:math":4103,":@":4127},[4104],{"mml:mrow":4105},[4106,4111,4122],{"mml:mo":4107,":@":4110},[4108],{"#text":4109},"(",{"@_stretchy":347},{"mml:mrow":4112},[4113,4116,4119],{"mml:mi":4114},[4115],{"#text":3040},{"mml:mo":4117},[4118],{"#text":3575},{"mml:mn":4120},[4121],{"#text":3552},{"mml:mo":4123,":@":4126},[4124],{"#text":4125},")",{"@_stretchy":347},{"@_id":4128},"m57",{"@_id":4130},"inf56",{"#text":4132}," therefore indicates consistent mastery of the current level and warrants progression, the lower boundary ",{"inline-formula":4134,":@":4160},[4135],{"mml:math":4136,":@":4158},[4137],{"mml:mrow":4138},[4139,4143,4154],{"mml:mo":4140,":@":4142},[4141],{"#text":4109},{"@_stretchy":347},{"mml:mrow":4144},[4145,4148,4151],{"mml:mi":4146},[4147],{"#text":3040},{"mml:mo":4149},[4150],{"#text":3516},{"mml:mn":4152},[4153],{"#text":3520},{"mml:mo":4155,":@":4157},[4156],{"#text":4125},{"@_stretchy":347},{"@_id":4159},"m58",{"@_id":4161},"inf57",{"#text":4163}," indicates a task that exceeds the participant’s current capability, and the intermediate band ",{"inline-formula":4165,":@":4197},[4166],{"mml:math":4167,":@":4195},[4168],{"mml:mrow":4169},[4170,4174,4191],{"mml:mo":4171,":@":4173},[4172],{"#text":4109},{"@_stretchy":347},{"mml:mrow":4175},[4176,4179,4182,4185,4188],{"mml:mn":4177},[4178],{"#text":3520},{"mml:mo":4180},[4181],{"#text":3356},{"mml:mi":4183},[4184],{"#text":3040},{"mml:mo":4186},[4187],{"#text":3516},{"mml:mn":4189},[4190],{"#text":3552},{"mml:mo":4192,":@":4194},[4193],{"#text":4125},{"@_stretchy":347},{"@_id":4196},"m59",{"@_id":4198},"inf58",{"#text":4200}," corresponds to the consolidation range in which further practice at the same level is expected to be beneficial.",{"#text":870},{"p":4203},[4204,4206,4225,4227,4258,4260,4364,4366,4371],{"#text":4205},"A geometrical interpretation can be given to the scoring thresholds: at the nominal arm length of ",{"inline-formula":4207,":@":4223},[4208],{"mml:math":4209,":@":4221},[4210],{"mml:mrow":4211},[4212,4215,4218],{"mml:mi":4213},[4214],{"#text":1865},{"mml:mo":4216},[4217],{"#text":1657},{"mml:mn":4219},[4220],{"#text":1872},{"@_id":4222},"m60",{"@_id":4224},"inf59",{"#text":4226}," m, an angular error of ",{"inline-formula":4228,":@":4256},[4229],{"mml:math":4230,":@":4254},[4231],{"mml:mrow":4232},[4233,4245,4248,4251],{"mml:msub":4234},[4235,4240],{"mml:mrow":4236},[4237],{"mml:mi":4238},[4239],{"#text":3094},{"mml:mrow":4241},[4242],{"mml:mtext":4243},[4244],{"#text":3207},{"mml:mo":4246},[4247],{"#text":1657},{"mml:mn":4249},[4250],{"#text":2059},{"mml:mo":4252},[4253],{"#text":1469},{"@_id":4255},"m61",{"@_id":4257},"inf60",{"#text":4259}," corresponds to a linear displacement between the hand and the target of",{"disp-formula":4261,":@":4362},[4262,4358],{"mml:math":4263,":@":4356},[4264],{"mml:mrow":4265},[4266,4269,4272,4275,4278,4282,4286,4289,4315,4318,4321,4324,4327,4330,4333,4345,4348,4352],{"mml:mi":4267},[4268],{"#text":3131},{"mml:mo":4270},[4271],{"#text":1657},{"mml:mn":4273},[4274],{"#text":1661},{"mml:mi":4276},[4277],{"#text":1865},{"mml:mo":4279},[4280],{"#text":4281},"⁡",{"mml:mi":4283},[4284],{"#text":4285},"sin",{"mml:mspace":4287,":@":4288},[],{"@_width":3336},{"mml:mfenced":4290,":@":4314},[4291],{"mml:mrow":4292},[4293],{"mml:mfrac":4294},[4295,4309],{"mml:mrow":4296},[4297],{"mml:msub":4298},[4299,4304],{"mml:mrow":4300},[4301],{"mml:mi":4302},[4303],{"#text":3094},{"mml:mrow":4305},[4306],{"mml:mtext":4307},[4308],{"#text":3207},{"mml:mrow":4310},[4311],{"mml:mn":4312},[4313],{"#text":1661},{"@_open":4109,"@_close":4125},{"mml:mo":4316},[4317],{"#text":1657},{"mml:mn":4319},[4320],{"#text":1661},{"mml:mo":4322},[4323],{"#text":3293},{"mml:mn":4325},[4326],{"#text":1872},{"mml:mo":4328},[4329],{"#text":3293},{"mml:mi":4331},[4332],{"#text":4285},{"mml:mfenced":4334,":@":4344},[4335],{"mml:mrow":4336},[4337,4341],{"mml:mn":4338},[4339],{"#text":4340},"5",{"mml:mo":4342},[4343],{"#text":1469},{"@_open":4109,"@_close":4125},{"mml:mo":4346},[4347],{"#text":3478},{"mml:mn":4349},[4350],{"#text":4351},"0.148",{"mml:mtext":4353},[4354],{"#text":4355}," m",{"@_id":4357},"m62",{"label":4359},[4360],{"#text":4361},"(2)",{"@_id":4363},"e2",{"#text":4365},"a tolerance of approximately 15 cm at the nominal arc length (",{"xref":4367,":@":4370},[4368],{"#text":4369},"Equation 2",{"@_ref-type":3270,"@_rid":4363},{"#text":4372},"), reflecting the residual motor impairment expected in the target patient population while still requiring accurate directional pointing.",{"#text":885},{"@_id":4375},"s2-7",{"#text":885},{"sec":4378,":@":4687},[4379,4380,4384,4385,4443,4444,4686],{"#text":1440},{"title":4381},[4382],{"#text":4383},"2.8 Experimental protocol",{"#text":870},{"sec":4386,":@":4441},[4387,4388,4392,4393,4440],{"#text":874},{"title":4389},[4390],{"#text":4391},"2.8.1 Participants",{"#text":915},{"p":4394},[4395,4397,4418,4420,4426,4428,4432,4434,4438],{"#text":4396},"Sixteen healthy adult volunteers were enrolled in the study (9 female, 7 male; mean age ",{"inline-formula":4398,":@":4416},[4399],{"mml:math":4400,":@":4414},[4401],{"mml:mrow":4402},[4403,4407,4410],{"mml:mn":4404},[4405],{"#text":4406},"54.5",{"mml:mo":4408},[4409],{"#text":2054},{"mml:mn":4411},[4412],{"#text":4413},"6.8",{"@_id":4415},"m63",{"@_id":4417},"inf61",{"#text":4419}," years). Stroke predominantly affects adults over 50 years of age, with prevalence and incidence rising sharply with age (",{"xref":4421,":@":4424},[4422],{"#text":4423},"He et al., 2024",{"@_ref-type":1055,"@_rid":4425},"B17",{"#text":4427},"); the recruited age range was therefore deliberately chosen to approximate the demographic profile of the intended clinical target population, namely, post-stroke patients in the subacute or chronic phase. This choice increases the ecological validity of the normative thresholds derived from the control sample with respect to future clinical use. Participants were assigned to one of two groups of eight (Group A: ",{"italic":4429},[4430],{"#text":4431},"high-performance",{"#text":4433},", Group B: ",{"italic":4435},[4436],{"#text":4437},"low-performance",{"#text":4439},"). All participants provided written informed consent in accordance with the Declaration of Helsinki.",{"#text":870},{"@_id":4442},"s2-8-1",{"#text":870},{"sec":4445,":@":4685},[4446,4447,4451,4452,4565,4566,4684],{"#text":874},{"title":4448},[4449],{"#text":4450},"2.8.2 Apparatus and setup",{"#text":915},{"p":4453},[4454,4456,4459,4461,4480,4482,4485,4487,4493,4495,4499,4501,4504,4506,4510,4512,4515,4517,4521,4522,4526,4527,4531,4533,4547,4549,4563],{"#text":4455},"Participants were seated at a fixed distance of 1.55 m from the TIAGo reference frame (",{"monospace":4457},[4458],{"#text":2889},{"#text":4460},"). The arc radius was set to ",{"inline-formula":4462,":@":4478},[4463],{"mml:math":4464,":@":4476},[4465],{"mml:mrow":4466},[4467,4470,4473],{"mml:mi":4468},[4469],{"#text":1865},{"mml:mo":4471},[4472],{"#text":1657},{"mml:mn":4474},[4475],{"#text":1872},{"@_id":4477},"m64",{"@_id":4479},"inf62",{"#text":4481},"m for all participants. Note that the seating distance of 1.55 m refers to the position of the participant’s torso relative to the robot’s ",{"monospace":4483},[4484],{"#text":2889},{"#text":4486}," (the center of the robot base), whereas the arc radius of 0.85 m is the distance between the robot’s end-effector and the participant’s left shoulder at the nominal setup pose. Kinematic ground truth was provided by a BTS SMART-DX EVO stereophotogrammetric motion capture system (",{"xref":4488,":@":4491},[4489],{"#text":4490},"BTS Bioengineering, 2026",{"@_ref-type":1055,"@_rid":4492},"B6",{"#text":4494},"). Two markers were placed on the gripper to recover the ",{"monospace":4496},[4497],{"#text":4498},"gripper_grasping_frame",{"#text":4500},". Four markers were placed on the participant (bilateral wrists and shoulders). The robot’s onboard RGB-D camera simultaneously acquired data for markerless skeletal tracking ",{"italic":4502},[4503],{"#text":2250},{"#text":4505}," MediaPipe Pose ",{"xref":4507,":@":4509},[4508],{"#text":2901},{"@_ref-type":1055,"@_rid":2903},{"#text":4511},". The rigid-body rototranslation between the mocap coordinate frame and the robot’s ",{"monospace":4513},[4514],{"#text":2889},{"#text":4516}," frame was computed from three markers placed on anatomically identifiable points of the TIAGo chassis: ",{"monospace":4518},[4519],{"#text":4520},"base_antenna_left_link",{"#text":2393},{"monospace":4523},[4524],{"#text":4525},"base_antenna_right_link",{"#text":2824},{"monospace":4528},[4529],{"#text":4530},"torso_lift_link",{"#text":4532},". These landmarks were selected because they correspond to accessible flat surfaces of the robot body, allowing precise and repeatable marker placement across sessions. The transformation was estimated as a standard rigid rototranslation (rotation matrix ",{"inline-formula":4534,":@":4545},[4535],{"mml:math":4536,":@":4543},[4537],{"mml:mrow":4538},[4539],{"mml:mi":4540},[4541],{"#text":4542},"R",{"@_id":4544},"m65",{"@_id":4546},"inf63",{"#text":4548}," and translation vector ",{"inline-formula":4550,":@":4561},[4551],{"mml:math":4552,":@":4559},[4553],{"mml:mrow":4554},[4555],{"mml:mi":4556,":@":4558},[4557],{"#text":1647},{"@_mathvariant":3332},{"@_id":4560},"m66",{"@_id":4562},"inf64",{"#text":4564},") minimising the residual between the known positions of the three points in the robot frame and their mocap measurements, and was applied to all BTS-derived coordinates prior to analysis.",{"#text":915},{"p":4567},[4568,4570,4591,4593,4606,4608,4612,4614,4618,4620,4636,4638,4659,4661,4674,4676,4682],{"#text":4569},"For each trial, the residual error of the rigid rototranslation was quantified as the discrepancy between the known chassis-marker positions in the robot frame and their transformed mocap counterparts. Across all trials, the mean residual error was ",{"inline-formula":4571,":@":4589},[4572],{"mml:math":4573,":@":4587},[4574],{"mml:mrow":4575},[4576,4580,4583],{"mml:mn":4577},[4578],{"#text":4579},"5.8",{"mml:mo":4581},[4582],{"#text":2054},{"mml:mn":4584},[4585],{"#text":4586},"1.3",{"@_id":4588},"m67",{"@_id":4590},"inf65",{"#text":4592},"mm (mean ",{"inline-formula":4594,":@":4604},[4595],{"mml:math":4596,":@":4602},[4597],{"mml:mrow":4598},[4599],{"mml:mo":4600},[4601],{"#text":2054},{"@_id":4603},"m68",{"@_id":4605},"inf66",{"#text":4607}," SD of the per-trial mean residual), confirming sub-centimetre accuracy of the BTS-to-TIAGo frame registration and establishing the accuracy floor for all subsequent kinematic comparisons (see also ",{"xref":4609,":@":4611},[4610],{"#text":3072},{"@_ref-type":2264,"@_rid":3074},{"#text":4613},"). The accuracy of the shoulder-relative arc centering assumption (",{"xref":4615,":@":4617},[4616],{"#text":3005},{"@_ref-type":2264,"@_rid":2625},{"#text":4619},") was independently verified against the BTS reference. The nominal setup pose places the end-effector 0.85 m in front of the participant’s left shoulder (0 m laterally, corresponding to ",{"inline-formula":4621,":@":4634},[4622],{"mml:math":4623,":@":4632},[4624],{"mml:mrow":4625},[4626,4629],{"mml:mn":4627},[4628],{"#text":1465},{"mml:mo":4630},[4631],{"#text":1469},{"@_id":4633},"m69",{"@_id":4635},"inf67",{"#text":4637}," eccentricity). Across all participants, the BTS-measured shoulder position relative to the initial end-effector pose was of ",{"inline-formula":4639,":@":4657},[4640],{"mml:math":4641,":@":4655},[4642],{"mml:mrow":4643},[4644,4648,4651],{"mml:mn":4645},[4646],{"#text":4647},"0.869",{"mml:mo":4649},[4650],{"#text":2054},{"mml:mn":4652},[4653],{"#text":4654},"0.073",{"@_id":4656},"m70",{"@_id":4658},"inf68",{"#text":4660},"m (mean ",{"inline-formula":4662,":@":4672},[4663],{"mml:math":4664,":@":4670},[4665],{"mml:mrow":4666},[4667],{"mml:mo":4668},[4669],{"#text":2054},{"@_id":4671},"m71",{"@_id":4673},"inf69",{"#text":4675}," SD). This confirms that the fixed seating protocol (",{"xref":4677,":@":4680},[4678],{"#text":4679},"Section 2.8.2",{"@_ref-type":2264,"@_rid":4681},"s2-8-2",{"#text":4683},") reliably approximates the nominal arc center across participants.",{"#text":870},{"@_id":4681},{"#text":885},{"@_id":4688},"s2-8",{"#text":885},{"sec":4691,":@":5207},[4692,4693,4697,4698,4702,4703,4860,4861,5206],{"#text":1440},{"title":4694},[4695],{"#text":4696},"2.9 Session protocol",{"#text":870},{"p":4699},[4700],{"#text":4701},"Each participant completed two experimental sessions in sequence. Throughout both sessions, participants were guided by the experimenter on how to perform the task: to actively reach toward the robot’s end-effector with the left arm, following its movement along the arc. The difficulty level of the second session was automatically assigned by the system based on the aggregate performance outcome of the first.",{"#text":870},{"sec":4704,":@":4858},[4705,4706,4741,4742,4857],{"#text":874},{"title":4707},[4708,4710],{"#text":4709},"2.9.1 High-performance group ",{"inline-formula":4711,":@":4739},[4712],{"mml:math":4713,":@":4737},[4714],{"mml:mrow":4715},[4716,4720,4733],{"mml:mo":4717,":@":4719},[4718],{"#text":4109},{"@_stretchy":347},{"mml:mrow":4721},[4722,4726,4729],{"mml:mi":4723},[4724],{"#text":4725},"n",{"mml:mo":4727},[4728],{"#text":1657},{"mml:mn":4730},[4731],{"#text":4732},"8",{"mml:mo":4734,":@":4736},[4735],{"#text":4125},{"@_stretchy":347},{"@_id":4738},"m72",{"@_id":4740},"inf70",{"#text":915},{"p":4743},[4744,4746,4775,4777,4793,4795,4824,4826,4855],{"#text":4745},"Session one consisted of three medium-difficulty repetitions ",{"inline-formula":4747,":@":4773},[4748],{"mml:math":4749,":@":4771},[4750],{"mml:mrow":4751},[4752,4756,4767],{"mml:mo":4753,":@":4755},[4754],{"#text":4109},{"@_stretchy":347},{"mml:mrow":4757},[4758,4761,4764],{"mml:mo":4759},[4760],{"#text":2054},{"mml:mn":4762},[4763],{"#text":2104},{"mml:mo":4765},[4766],{"#text":1469},{"mml:mo":4768,":@":4770},[4769],{"#text":4125},{"@_stretchy":347},{"@_id":4772},"m73",{"@_id":4774},"inf71",{"#text":4776},", all performed correctly and validated by the robot with scores ",{"inline-formula":4778,":@":4791},[4779],{"mml:math":4780,":@":4789},[4781],{"mml:mrow":4782},[4783,4786],{"mml:mo":4784},[4785],{"#text":3575},{"mml:mn":4787},[4788],{"#text":3552},{"@_id":4790},"m74",{"@_id":4792},"inf72",{"#text":4794},". The resulting mean session score ",{"inline-formula":4796,":@":4822},[4797],{"mml:math":4798,":@":4820},[4799],{"mml:mrow":4800},[4801,4814,4817],{"mml:mrow":4802},[4803],{"mml:mover":4804,":@":4813},[4805,4810],{"mml:mrow":4806},[4807],{"mml:mi":4808},[4809],{"#text":3040},{"mml:mo":4811},[4812],{"#text":3646},{"@_accent":15},{"mml:mo":4815},[4816],{"#text":3575},{"mml:mn":4818},[4819],{"#text":3552},{"@_id":4821},"m75",{"@_id":4823},"inf73",{"#text":4825}," and the fail ratio equal to 0 triggered automatic promotion to the hard level. Session 2 consisted of three hard-difficulty repetitions ",{"inline-formula":4827,":@":4853},[4828],{"mml:math":4829,":@":4851},[4830],{"mml:mrow":4831},[4832,4836,4847],{"mml:mo":4833,":@":4835},[4834],{"#text":4109},{"@_stretchy":347},{"mml:mrow":4837},[4838,4841,4844],{"mml:mo":4839},[4840],{"#text":2054},{"mml:mn":4842},[4843],{"#text":2073},{"mml:mo":4845},[4846],{"#text":1469},{"mml:mo":4848,":@":4850},[4849],{"#text":4125},{"@_stretchy":347},{"@_id":4852},"m76",{"@_id":4854},"inf74",{"#text":4856},", performed correctly.",{"#text":870},{"@_id":4859},"s2-9-1",{"#text":870},{"sec":4862,":@":5204},[4863,4864,4897,4898,5168,5169,5203],{"#text":874},{"title":4865},[4866,4868],{"#text":4867},"2.9.2 Low-performance group ",{"inline-formula":4869,":@":4895},[4870],{"mml:math":4871,":@":4893},[4872],{"mml:mrow":4873},[4874,4878,4889],{"mml:mo":4875,":@":4877},[4876],{"#text":4109},{"@_stretchy":347},{"mml:mrow":4879},[4880,4883,4886],{"mml:mi":4881},[4882],{"#text":4725},{"mml:mo":4884},[4885],{"#text":1657},{"mml:mn":4887},[4888],{"#text":4732},{"mml:mo":4890,":@":4892},[4891],{"#text":4125},{"@_stretchy":347},{"@_id":4894},"m77",{"@_id":4896},"inf75",{"#text":915},{"p":4899},[4900,4902,4931,4933,4949,4951,4967,4969,4986,4988,5004,5006,5022,5024,5040,5042,5058,5060,5079,5081,5097,5098,5117,5119,5135,5137,5166],{"#text":4901},"Session one consisted of six medium-difficulty repetitions ",{"inline-formula":4903,":@":4929},[4904],{"mml:math":4905,":@":4927},[4906],{"mml:mrow":4907},[4908,4912,4923],{"mml:mo":4909,":@":4911},[4910],{"#text":4109},{"@_stretchy":347},{"mml:mrow":4913},[4914,4917,4920],{"mml:mo":4915},[4916],{"#text":2054},{"mml:mn":4918},[4919],{"#text":2104},{"mml:mo":4921},[4922],{"#text":1469},{"mml:mo":4924,":@":4926},[4925],{"#text":4125},{"@_stretchy":347},{"@_id":4928},"m78",{"@_id":4930},"inf76",{"#text":4932}," following a controlled error pattern: one correct repetition (score ",{"inline-formula":4934,":@":4947},[4935],{"mml:math":4936,":@":4945},[4937],{"mml:mrow":4938},[4939,4942],{"mml:mo":4940},[4941],{"#text":3575},{"mml:mn":4943},[4944],{"#text":3552},{"@_id":4946},"m79",{"@_id":4948},"inf77",{"#text":4950},"), two failed repetitions (score ",{"inline-formula":4952,":@":4965},[4953],{"mml:math":4954,":@":4963},[4955],{"mml:mrow":4956},[4957,4960],{"mml:mo":4958},[4959],{"#text":1657},{"mml:mn":4961},[4962],{"#text":1465},{"@_id":4964},"m80",{"@_id":4966},"inf78",{"#text":4968},"), one partial repetition (score ",{"inline-formula":4970,":@":4984},[4971],{"mml:math":4972,":@":4982},[4973],{"mml:mrow":4974},[4975,4978],{"mml:mo":4976},[4977],{"#text":3478},{"mml:mn":4979},[4980],{"#text":4981},"50",{"@_id":4983},"m81",{"@_id":4985},"inf79",{"#text":4987},"), one failed repetition (score ",{"inline-formula":4989,":@":5002},[4990],{"mml:math":4991,":@":5000},[4992],{"mml:mrow":4993},[4994,4997],{"mml:mo":4995},[4996],{"#text":1657},{"mml:mn":4998},[4999],{"#text":1465},{"@_id":5001},"m82",{"@_id":5003},"inf80",{"#text":5005},"), and one final correct repetition (score ",{"inline-formula":5007,":@":5020},[5008],{"mml:math":5009,":@":5018},[5010],{"mml:mrow":5011},[5012,5015],{"mml:mo":5013},[5014],{"#text":3575},{"mml:mn":5016},[5017],{"#text":3552},{"@_id":5019},"m83",{"@_id":5021},"inf81",{"#text":5023},"). Failed repetitions (score ",{"inline-formula":5025,":@":5038},[5026],{"mml:math":5027,":@":5036},[5028],{"mml:mrow":5029},[5030,5033],{"mml:mo":5031},[5032],{"#text":1657},{"mml:mn":5034},[5035],{"#text":1465},{"@_id":5037},"m84",{"@_id":5039},"inf82",{"#text":5041},") were produced by participants keeping their arms resting on their laps throughout the trial, resulting in no samples satisfying the AND-gate condition. The partial repetition (score ",{"inline-formula":5043,":@":5056},[5044],{"mml:math":5045,":@":5054},[5046],{"mml:mrow":5047},[5048,5051],{"mml:mo":5049},[5050],{"#text":3478},{"mml:mn":5052},[5053],{"#text":4981},{"@_id":5055},"m85",{"@_id":5057},"inf83",{"#text":5059},") was produced by following the end-effector only along the rightward half of the arc (from center to ",{"inline-formula":5061,":@":5077},[5062],{"mml:math":5063,":@":5075},[5064],{"mml:mrow":5065},[5066,5069,5072],{"mml:mo":5067},[5068],{"#text":1486},{"mml:mn":5070},[5071],{"#text":2104},{"mml:mo":5073},[5074],{"#text":1469},{"@_id":5076},"m86",{"@_id":5078},"inf84",{"#text":5080}," and back to center), then keeping the arm at rest during the leftward excursion into the contralesional hemispace (",{"inline-formula":5082,":@":5095},[5083],{"mml:math":5084,":@":5093},[5085],{"mml:mrow":5086},[5087,5090],{"mml:mn":5088},[5089],{"#text":1465},{"mml:mo":5091},[5092],{"#text":1469},{"@_id":5094},"m87",{"@_id":5096},"inf85",{"#text":1476},{"inline-formula":5099,":@":5115},[5100],{"mml:math":5101,":@":5113},[5102],{"mml:mrow":5103},[5104,5107,5110],{"mml:mo":5105},[5106],{"#text":1516},{"mml:mn":5108},[5109],{"#text":2104},{"mml:mo":5111},[5112],{"#text":1469},{"@_id":5114},"m88",{"@_id":5116},"inf86",{"#text":5118},"), emulating the attentional behavior expected in USN patients who fail to engage with stimuli presented on the neglected side. Three out of six attempts were failed (fail ratio ",{"inline-formula":5120,":@":5133},[5121],{"mml:math":5122,":@":5131},[5123],{"mml:mrow":5124},[5125,5128],{"mml:mo":5126},[5127],{"#text":3575},{"mml:mn":5129},[5130],{"#text":3246},{"@_id":5132},"m89",{"@_id":5134},"inf87",{"#text":5136},"), triggering automatic demotion to the Easy level. Session 2 consisted of three Easy-difficulty repetitions ",{"inline-formula":5138,":@":5164},[5139],{"mml:math":5140,":@":5162},[5141],{"mml:mrow":5142},[5143,5147,5158],{"mml:mo":5144,":@":5146},[5145],{"#text":4109},{"@_stretchy":347},{"mml:mrow":5148},[5149,5152,5155],{"mml:mo":5150},[5151],{"#text":2054},{"mml:mn":5153},[5154],{"#text":2059},{"mml:mo":5156},[5157],{"#text":1469},{"mml:mo":5159,":@":5161},[5160],{"#text":4125},{"@_stretchy":347},{"@_id":5163},"m90",{"@_id":5165},"inf88",{"#text":5167},", all performed correctly. The error pattern in session one was deliberately piloted by the experimenter and was not intended to reflect the subjects’ actual motor capabilities. The purpose was to systematically verify the correct operation of the demotion logic under a controlled condition: this validation therefore demonstrates that the adaptive-difficulty algorithm correctly detects and responds to a known, scripted sequence of performance outcomes, rather than emulating the natural, continuous, and often inconsistent performance variability expected from real USN patients across repetitions and sessions. Assessing how the algorithm behaves under such organic variability, particularly for performance values close to the promotion/demotion thresholds, is left to future clinical validation.",{"#text":915},{"p":5170},[5171,5173,5186,5188,5201],{"#text":5172},"In total, this protocol yielded 120 recorded repetitions: 48 from Group A (8 participants ",{"inline-formula":5174,":@":5184},[5175],{"mml:math":5176,":@":5182},[5177],{"mml:mrow":5178},[5179],{"mml:mo":5180},[5181],{"#text":3293},{"@_id":5183},"m91",{"@_id":5185},"inf89",{"#text":5187}," three repetitions per session) and 72 from Group B (8 participants ",{"inline-formula":5189,":@":5199},[5190],{"mml:math":5191,":@":5197},[5192],{"mml:mrow":5193},[5194],{"mml:mo":5195},[5196],{"#text":3293},{"@_id":5198},"m92",{"@_id":5200},"inf90",{"#text":5202}," six repetitions in Session 1, plus three in Session 2).",{"#text":870},{"@_id":5205},"s2-9-2",{"#text":885},{"@_id":5208},"s2-9",{"#text":885},{"sec":5211,":@":5863},[5212,5213,5217,5218,5346,5347,5862],{"#text":1440},{"title":5214},[5215],{"#text":5216},"2.10 Data collection and analysis",{"#text":870},{"p":5219},[5220,5222,5250,5252,5280,5282,5295,5297,5318,5319,5340,5342,5345],{"#text":5221},"For each repetition, full kinematic timeseries of arm alignment angle ",{"inline-formula":5223,":@":5248},[5224],{"mml:math":5225,":@":5246},[5226],{"mml:mrow":5227},[5228,5231],{"mml:mi":5229},[5230],{"#text":3094},{"mml:mrow":5232},[5233,5237,5242],{"mml:mo":5234,":@":5236},[5235],{"#text":4109},{"@_stretchy":347},{"mml:mrow":5238},[5239],{"mml:mi":5240},[5241],{"#text":1647},{"mml:mo":5243,":@":5245},[5244],{"#text":4125},{"@_stretchy":347},{"@_id":5247},"m93",{"@_id":5249},"inf91",{"#text":5251},", hand–end-effector distance ",{"inline-formula":5253,":@":5278},[5254],{"mml:math":5255,":@":5276},[5256],{"mml:mrow":5257},[5258,5261],{"mml:mi":5259},[5260],{"#text":3131},{"mml:mrow":5262},[5263,5267,5272],{"mml:mo":5264,":@":5266},[5265],{"#text":4109},{"@_stretchy":347},{"mml:mrow":5268},[5269],{"mml:mi":5270},[5271],{"#text":1647},{"mml:mo":5273,":@":5275},[5274],{"#text":4125},{"@_stretchy":347},{"@_id":5277},"m94",{"@_id":5279},"inf92",{"#text":5281},", and 3D end-effector position were computed from both the robot’s onboard system and the BTS mocap reference. Per-repetition aggregate metrics (score ",{"inline-formula":5283,":@":5293},[5284],{"mml:math":5285,":@":5291},[5286],{"mml:mrow":5287},[5288],{"mml:mi":5289},[5290],{"#text":3040},{"@_id":5292},"m95",{"@_id":5294},"inf93",{"#text":5296},", mean ",{"inline-formula":5298,":@":5316},[5299],{"mml:math":5300,":@":5314},[5301],{"mml:mrow":5302},[5303],{"mml:mover":5304,":@":5313},[5305,5310],{"mml:mrow":5306},[5307],{"mml:mi":5308},[5309],{"#text":3094},{"mml:mo":5311},[5312],{"#text":3646},{"@_accent":15},{"@_id":5315},"m96",{"@_id":5317},"inf94",{"#text":5296},{"inline-formula":5320,":@":5338},[5321],{"mml:math":5322,":@":5336},[5323],{"mml:mrow":5324},[5325],{"mml:mover":5326,":@":5335},[5327,5332],{"mml:mrow":5328},[5329],{"mml:mi":5330},[5331],{"#text":3131},{"mml:mo":5333},[5334],{"#text":3646},{"@_accent":15},{"@_id":5337},"m97",{"@_id":5339},"inf95",{"#text":5341},", duration) were logged by the ",{"monospace":5343},[5344],{"#text":2732},{"#text":3492},{"#text":870},{"p":5348},[5349,5351],{"#text":5350},"Four analyses were performed:",{"list":5352,":@":5861},[5353,5655,5752,5803],{"list-item":5354},[5355],{"p":5356},[5357,5359,5372,5373,5386,5388,5392,5394,5422,5424,5427,5429,5524,5526,5574,5576,5589,5591,5654],{"#text":5358},"Kinematic metric accuracy: RMSE was computed between TIAGo-derived and mocap-derived timeseries of ",{"inline-formula":5360,":@":5370},[5361],{"mml:math":5362,":@":5368},[5363],{"mml:mrow":5364},[5365],{"mml:mi":5366},[5367],{"#text":3094},{"@_id":5369},"m98",{"@_id":5371},"inf96",{"#text":1255},{"inline-formula":5374,":@":5384},[5375],{"mml:math":5376,":@":5382},[5377],{"mml:mrow":5378},[5379],{"mml:mi":5380},[5381],{"#text":3131},{"@_id":5383},"m99",{"@_id":5385},"inf97",{"#text":5387},". The RMSE analysis targets the agreement between the two measurement instruments (TIAGo’s onboard estimate ",{"italic":5389},[5390],{"#text":5391},"versus",{"#text":5393}," the mocap gold standard). Since the measurement error of a sensing pipeline is not expected to depend on which participant is being tracked, individual repetitions across participants were pooled and treated as the unit of analysis without stratifying by subject. Kruskal-Wallis comparisons were run on the 88 trials in which the subject was asked to execute the task correctly. The analysis of all 120 trials, instead, evaluated the trajectory of the end-effector, i.e., its radius of curvature, angular velocity, and instantaneous eccentricity ",{"inline-formula":5395,":@":5420},[5396],{"mml:math":5397,":@":5418},[5398],{"mml:mrow":5399},[5400,5403],{"mml:mi":5401},[5402],{"#text":1494},{"mml:mrow":5404},[5405,5409,5414],{"mml:mo":5406,":@":5408},[5407],{"#text":4109},{"@_stretchy":347},{"mml:mrow":5410},[5411],{"mml:mi":5412},[5413],{"#text":1647},{"mml:mo":5415,":@":5417},[5416],{"#text":4125},{"@_stretchy":347},{"@_id":5419},"m100",{"@_id":5421},"inf98",{"#text":5423},", to characterize the fidelity of the executed Cartesian arc trajectory beyond the scoring-relevant metrics. The trajectory radius of curvature was estimated for each repetition by projecting the end-effector 3D positions onto the horizontal (XY) plane and fitting a circle ",{"italic":5425},[5426],{"#text":2250},{"#text":5428}," an algebraic least-squares circle fit, which solves the linear least-squares system ",{"inline-formula":5430,":@":5522},[5431],{"mml:math":5432,":@":5520},[5433],{"mml:mrow":5434},[5435,5438,5442,5446,5459,5462,5465,5469,5472,5484,5487,5490,5493,5505,5508],{"mml:mn":5436},[5437],{"#text":1661},{"mml:mi":5439},[5440],{"#text":5441},"x",{"mml:mtext":5443},[5444],{"#text":5445}," ",{"mml:msub":5447},[5448,5454],{"mml:mrow":5449},[5450],{"mml:mi":5451},[5452],{"#text":5453},"c",{"mml:mrow":5455},[5456],{"mml:mi":5457},[5458],{"#text":5441},{"mml:mo":5460},[5461],{"#text":1486},{"mml:mn":5463},[5464],{"#text":1661},{"mml:mi":5466},[5467],{"#text":5468},"y",{"mml:mtext":5470},[5471],{"#text":5445},{"mml:msub":5473},[5474,5479],{"mml:mrow":5475},[5476],{"mml:mi":5477},[5478],{"#text":5453},{"mml:mrow":5480},[5481],{"mml:mi":5482},[5483],{"#text":5468},{"mml:mo":5485},[5486],{"#text":1486},{"mml:mi":5488},[5489],{"#text":5453},{"mml:mo":5491},[5492],{"#text":1657},{"mml:msup":5494},[5495,5500],{"mml:mrow":5496},[5497],{"mml:mi":5498},[5499],{"#text":5441},{"mml:mrow":5501},[5502],{"mml:mn":5503},[5504],{"#text":1661},{"mml:mo":5506},[5507],{"#text":1486},{"mml:msup":5509},[5510,5515],{"mml:mrow":5511},[5512],{"mml:mi":5513},[5514],{"#text":5468},{"mml:mrow":5516},[5517],{"mml:mn":5518},[5519],{"#text":1661},{"@_id":5521},"m101",{"@_id":5523},"inf99",{"#text":5525}," for the circle center ",{"inline-formula":5527,":@":5572},[5528],{"mml:math":5529,":@":5570},[5530],{"mml:mrow":5531},[5532,5536,5566],{"mml:mo":5533,":@":5535},[5534],{"#text":4109},{"@_stretchy":347},{"mml:mrow":5537},[5538,5550,5554],{"mml:msub":5539},[5540,5545],{"mml:mrow":5541},[5542],{"mml:mi":5543},[5544],{"#text":5453},{"mml:mrow":5546},[5547],{"mml:mi":5548},[5549],{"#text":5441},{"mml:mo":5551},[5552],{"#text":5553},",",{"mml:msub":5555},[5556,5561],{"mml:mrow":5557},[5558],{"mml:mi":5559},[5560],{"#text":5453},{"mml:mrow":5562},[5563],{"mml:mi":5564},[5565],{"#text":5468},{"mml:mo":5567,":@":5569},[5568],{"#text":4125},{"@_stretchy":347},{"@_id":5571},"m102",{"@_id":5573},"inf100",{"#text":5575}," and the auxiliary term ",{"inline-formula":5577,":@":5587},[5578],{"mml:math":5579,":@":5585},[5580],{"mml:mrow":5581},[5582],{"mml:mi":5583},[5584],{"#text":5453},{"@_id":5586},"m103",{"@_id":5588},"inf101",{"#text":5590},", from which the radius is recovered as ",{"inline-formula":5592,":@":5652},[5593],{"mml:math":5594,":@":5650},[5595],{"mml:mrow":5596},[5597,5600,5603],{"mml:mi":5598},[5599],{"#text":1865},{"mml:mo":5601},[5602],{"#text":1657},{"mml:msqrt":5604},[5605],{"mml:mrow":5606},[5607,5624,5627,5644,5647],{"mml:msubsup":5608},[5609,5614,5619],{"mml:mrow":5610},[5611],{"mml:mi":5612},[5613],{"#text":5453},{"mml:mrow":5615},[5616],{"mml:mi":5617},[5618],{"#text":5441},{"mml:mrow":5620},[5621],{"mml:mn":5622},[5623],{"#text":1661},{"mml:mo":5625},[5626],{"#text":1486},{"mml:msubsup":5628},[5629,5634,5639],{"mml:mrow":5630},[5631],{"mml:mi":5632},[5633],{"#text":5453},{"mml:mrow":5635},[5636],{"mml:mi":5637},[5638],{"#text":5468},{"mml:mrow":5640},[5641],{"mml:mn":5642},[5643],{"#text":1661},{"mml:mo":5645},[5646],{"#text":1486},{"mml:mi":5648},[5649],{"#text":5453},{"@_id":5651},"m104",{"@_id":5653},"inf102",{"#text":2267},{"list-item":5656},[5657],{"p":5658},[5659,5661,5664,5666,5697,5698,5726,5728,5732,5734,5750],{"#text":5660},"Physiological pointing threshold: to assess whether the ",{"italic":5662},[5663],{"#text":2550},{"#text":5665}," scoring thresholds (",{"inline-formula":5667,":@":5695},[5668],{"mml:math":5669,":@":5693},[5670],{"mml:mrow":5671},[5672,5684,5687,5690],{"mml:msub":5673},[5674,5679],{"mml:mrow":5675},[5676],{"mml:mi":5677},[5678],{"#text":3094},{"mml:mrow":5680},[5681],{"mml:mtext":5682},[5683],{"#text":3207},{"mml:mo":5685},[5686],{"#text":1657},{"mml:mn":5688},[5689],{"#text":2059},{"mml:mo":5691},[5692],{"#text":1469},{"@_id":5694},"m105",{"@_id":5696},"inf103",{"#text":2393},{"inline-formula":5699,":@":5724},[5700],{"mml:math":5701,":@":5722},[5702],{"mml:mrow":5703},[5704,5716,5719],{"mml:msub":5705},[5706,5711],{"mml:mrow":5707},[5708],{"mml:mi":5709},[5710],{"#text":3131},{"mml:mrow":5712},[5713],{"mml:mtext":5714},[5715],{"#text":3207},{"mml:mo":5717},[5718],{"#text":1657},{"mml:mn":5720},[5721],{"#text":3246},{"@_id":5723},"m106",{"@_id":5725},"inf104",{"#text":5727},"m, ",{"xref":5729,":@":5731},[5730],{"#text":2963},{"@_ref-type":2264,"@_rid":2965},{"#text":5733},") are conservative with respect to genuine, correctly executed pointing responses, BTS-derived arm-alignment angle and hand–end-effector distance were extracted during all repetitions of the high-performance group (correct by design) and all session 2 repetitions (BTS score ",{"inline-formula":5735,":@":5748},[5736],{"mml:math":5737,":@":5746},[5738],{"mml:mrow":5739},[5740,5743],{"mml:mo":5741},[5742],{"#text":1657},{"mml:mn":5744},[5745],{"#text":3289},{"@_id":5747},"m107",{"@_id":5749},"inf105",{"#text":5751},"). For each metric, the 95th percentile of the pooled BTS distribution was taken as a data-driven estimate of the physiological upper bound on the alignment error expected during a genuinely correct pointing response.",{"list-item":5753},[5754],{"p":5755},[5756,5758,5771,5773,5793,5795,5801],{"#text":5757},"Scoring concordance: for each of all 120 repetitions, spanning the Fail, Acceptable, and Great conditions by design, the score ",{"inline-formula":5759,":@":5769},[5760],{"mml:math":5761,":@":5767},[5762],{"mml:mrow":5763},[5764],{"mml:mi":5765},[5766],{"#text":3040},{"@_id":5768},"m108",{"@_id":5770},"inf106",{"#text":5772}," computed from TIAGo-derived metrics was classified into the three bands (Fail/Acceptable/Great). The same classification was derived from mocap-based metrics using identical thresholds and formula. Unlike the kinematic accuracy analysis above, this analysis uses the complete set of 120 repetitions, since its purpose is to verify that the onboard scoring pipeline assigns each repetition to the correct performance band across the full range of intended behaviors, not only under correct execution. A ",{"inline-formula":5774,":@":5791},[5775],{"mml:math":5776,":@":5789},[5777],{"mml:mrow":5778},[5779,5783,5786],{"mml:mn":5780},[5781],{"#text":5782},"3",{"mml:mo":5784},[5785],{"#text":3293},{"mml:mn":5787},[5788],{"#text":5782},{"@_id":5790},"m109",{"@_id":5792},"inf107",{"#text":5794}," confusion matrix was constructed, and overall accuracy, Cohen’s kappa (",{"xref":5796,":@":5799},[5797],{"#text":5798},"Cohen, 1988",{"@_ref-type":1055,"@_rid":5800},"B8",{"#text":5802},"), and per-class recall were reported.",{"list-item":5804},[5805],{"p":5806},[5807,5809,5830,5831,5853,5855,5859],{"#text":5808},"Adaptive behavior validation: the difficulty level proposed by the system for session 2 was compared against the expected outcome for each participant, based on the session one aggregate statistics (",{"inline-formula":5810,":@":5828},[5811],{"mml:math":5812,":@":5826},[5813],{"mml:mrow":5814},[5815],{"mml:mover":5816,":@":5825},[5817,5822],{"mml:mrow":5818},[5819],{"mml:mi":5820},[5821],{"#text":3040},{"mml:mo":5823},[5824],{"#text":3646},{"@_accent":15},{"@_id":5827},"m110",{"@_id":5829},"inf108",{"#text":1255},{"inline-formula":5832,":@":5851},[5833],{"mml:math":5834,":@":5849},[5835],{"mml:mrow":5836},[5837],{"mml:msub":5838},[5839,5844],{"mml:mrow":5840},[5841],{"mml:mi":5842},[5843],{"#text":1865},{"mml:mrow":5845},[5846],{"mml:mtext":5847},[5848],{"#text":3672},{"@_id":5850},"m111",{"@_id":5852},"inf109",{"#text":5854},") and the decision rules in ",{"xref":5856,":@":5858},[5857],{"#text":3609},{"@_ref-type":1852,"@_rid":3611},{"#text":5860},". Correct operation was defined as an exact match between the system-assigned level and the expected level for all 16 participants.",{"@_list-type":1407},{"#text":885},{"@_id":5864},"s2-10",{"#text":1036},{"@_sec-type":5867,"@_id":5868},"materials|methods","s2",{"#text":1036},{"sec":5871,":@":7989,"anchorId":7991},[5872,5873,5877,5878,6651,6652,6778,6779,7634,7635,7988],{"#text":1040},{"title":5874},[5875],{"#text":5876},"3 Results",{"#text":885},{"sec":5879,":@":6650},[5880,5881,5885,5886,5933,5934,5964,5965,6649],{"#text":1440},{"title":5882},[5883],{"#text":5884},"3.1 Kinematic metric accuracy",{"#text":870},{"p":5887},[5888,5889,5895,5897,5917,5918,5931],{"#text":915},{"xref":5890,":@":5893},[5891],{"#text":5892},"Figure 3",{"@_ref-type":2650,"@_rid":5894},"F3",{"#text":5896}," summarizes the kinematic accuracy of the TIAGo onboard markerless pipeline relative to the BTS SMART-DX EVO stereophotogrammetric reference, computed on the 88 out of 120 total repetitions in which participants achieved a BTS-derived score of 100% (i.e., fully correct executions according to the gold-standard reference). The inter-system registration residual was ",{"inline-formula":5898,":@":5915},[5899],{"mml:math":5900,":@":5913},[5901],{"mml:mrow":5902},[5903,5906,5909],{"mml:mn":5904},[5905],{"#text":4579},{"mml:mo":5907},[5908],{"#text":2054},{"mml:mn":5910},[5911],{"#text":5912},"1.33",{"@_id":5914},"m112",{"@_id":5916},"inf110",{"#text":4592},{"inline-formula":5919,":@":5929},[5920],{"mml:math":5921,":@":5927},[5922],{"mml:mrow":5923},[5924],{"mml:mo":5925},[5926],{"#text":2054},{"@_id":5928},"m113",{"@_id":5930},"inf111",{"#text":5932}," SD, max 7.05 mm), establishing the accuracy floor of the BTS-to-TIAGo frame alignment.",{"#text":870},{"fig":5935,":@":5963},[5936,5937,5941,5942,5950,5951,5962],{"#text":915},{"label":5938},[5939],{"#text":5940},"FIGURE 3",{"#text":915},{"caption":5943},[5944,5945,5949],{"#text":1891},{"p":5946},[5947],{"#text":5948},"RMSE between TIAGo onboard measurements and BTS SMART-DX EVO reference measurements, for arm-alignment angle (top) and hand–end-effector distance (bottom), computed on the 88 repetitions in which the BTS-derived score was 100%, stratified by difficulty level (Easy, Medium, Hard). Individual trial values are overlaid as dots; boxes span the interquartile range; the central line indicates the median; whiskers extend to the 5th and 95th percentiles.",{"#text":915},{"#text":915},{"graphic":5952,":@":5960},[5953,5954,5959],{"#text":1891},{"alt-text":5955,":@":5958},[5956],{"#text":5957},"Box plots comparing RMSE for arm alignment (degrees, top) and hand end-effector distance (centimeters, bottom) across easy, medium, and hard tasks, with increasing median and interquartile range values from easy to hard.",{"@_content-type":2762},{"#text":915},{"@_mimetype":405,"@_mime-subtype":2765,"@_xlink:href":5961},"frobt-13-1950821-g003.tif",{"#text":870},{"@_id":5894,"@_position":2171},{"#text":870},{"p":5966},[5967,5969,5986,5988,6005,6006,6026,6028,6045,6046,6063,6064,6083,6085,6102,6103,6120,6121,6140,6142,6172,6173,6194,6196,6216,6218,6238,6240,6260,6262,6281,6283,6302,6304,6323,6324,6353,6354,6374,6375,6395,6396,6415,6416,6436,6438,6444,6446,6467,6468,6481,6483,6502,6504,6531,6533,6560,6562,6590,6592,6619,6620,6647],{"#text":5968},"RMSE showed a statistically significant increase with arc eccentricity for both metrics. For arm alignment, values rose from a median of ",{"inline-formula":5970,":@":5984},[5971],{"mml:math":5972,":@":5982},[5973],{"mml:mrow":5974},[5975,5979],{"mml:mn":5976},[5977],{"#text":5978},"1.22",{"mml:mo":5980},[5981],{"#text":1469},{"@_id":5983},"m114",{"@_id":5985},"inf112",{"#text":5987}," (IQR ",{"inline-formula":5989,":@":6003},[5990],{"mml:math":5991,":@":6001},[5992],{"mml:mrow":5993},[5994,5998],{"mml:mn":5995},[5996],{"#text":5997},"0.97",{"mml:mo":5999},[6000],{"#text":1469},{"@_id":6002},"m115",{"@_id":6004},"inf113",{"#text":2393},{"inline-formula":6007,":@":6024},[6008],{"mml:math":6009,":@":6022},[6010],{"mml:mrow":6011},[6012,6015,6018],{"mml:mi":6013},[6014],{"#text":4725},{"mml:mo":6016},[6017],{"#text":1657},{"mml:mn":6019},[6020],{"#text":6021},"24",{"@_id":6023},"m116",{"@_id":6025},"inf114",{"#text":6027},") at Easy to ",{"inline-formula":6029,":@":6043},[6030],{"mml:math":6031,":@":6041},[6032],{"mml:mrow":6033},[6034,6038],{"mml:mn":6035},[6036],{"#text":6037},"1.83",{"mml:mo":6039},[6040],{"#text":1469},{"@_id":6042},"m117",{"@_id":6044},"inf115",{"#text":5987},{"inline-formula":6047,":@":6061},[6048],{"mml:math":6049,":@":6059},[6050],{"mml:mrow":6051},[6052,6056],{"mml:mn":6053},[6054],{"#text":6055},"3.16",{"mml:mo":6057},[6058],{"#text":1469},{"@_id":6060},"m118",{"@_id":6062},"inf116",{"#text":2393},{"inline-formula":6065,":@":6081},[6066],{"mml:math":6067,":@":6079},[6068],{"mml:mrow":6069},[6070,6073,6076],{"mml:mi":6071},[6072],{"#text":4725},{"mml:mo":6074},[6075],{"#text":1657},{"mml:mn":6077},[6078],{"#text":2163},{"@_id":6080},"m119",{"@_id":6082},"inf117",{"#text":6084},") at Medium and ",{"inline-formula":6086,":@":6100},[6087],{"mml:math":6088,":@":6098},[6089],{"mml:mrow":6090},[6091,6095],{"mml:mn":6092},[6093],{"#text":6094},"2.27",{"mml:mo":6096},[6097],{"#text":1469},{"@_id":6099},"m120",{"@_id":6101},"inf118",{"#text":5987},{"inline-formula":6104,":@":6118},[6105],{"mml:math":6106,":@":6116},[6107],{"mml:mrow":6108},[6109,6113],{"mml:mn":6110},[6111],{"#text":6112},"3.32",{"mml:mo":6114},[6115],{"#text":1469},{"@_id":6117},"m121",{"@_id":6119},"inf119",{"#text":2393},{"inline-formula":6122,":@":6138},[6123],{"mml:math":6124,":@":6136},[6125],{"mml:mrow":6126},[6127,6130,6133],{"mml:mi":6128},[6129],{"#text":4725},{"mml:mo":6131},[6132],{"#text":1657},{"mml:mn":6134},[6135],{"#text":6021},{"@_id":6137},"m122",{"@_id":6139},"inf120",{"#text":6141},") at Hard (Kruskal-Wallis ",{"inline-formula":6143,":@":6170},[6144],{"mml:math":6145,":@":6168},[6146],{"mml:mrow":6147},[6148,6161,6164],{"mml:msup":6149},[6150,6156],{"mml:mrow":6151},[6152],{"mml:mi":6153},[6154],{"#text":6155},"χ",{"mml:mrow":6157},[6158],{"mml:mn":6159},[6160],{"#text":1661},{"mml:mo":6162},[6163],{"#text":1657},{"mml:mn":6165},[6166],{"#text":6167},"11.01",{"@_id":6169},"m123",{"@_id":6171},"inf121",{"#text":2393},{"inline-formula":6174,":@":6192},[6175],{"mml:math":6176,":@":6190},[6177],{"mml:mrow":6178},[6179,6183,6186],{"mml:mi":6180},[6181],{"#text":6182},"p",{"mml:mo":6184},[6185],{"#text":1657},{"mml:mn":6187},[6188],{"#text":6189},"0.004",{"@_id":6191},"m124",{"@_id":6193},"inf122",{"#text":6195},"; Easy vs. Medium ",{"inline-formula":6197,":@":6214},[6198],{"mml:math":6199,":@":6212},[6200],{"mml:mrow":6201},[6202,6205,6208],{"mml:mi":6203},[6204],{"#text":6182},{"mml:mo":6206},[6207],{"#text":1657},{"mml:mn":6209},[6210],{"#text":6211},"0.019",{"@_id":6213},"m125",{"@_id":6215},"inf123",{"#text":6217},", Easy vs. Hard ",{"inline-formula":6219,":@":6236},[6220],{"mml:math":6221,":@":6234},[6222],{"mml:mrow":6223},[6224,6227,6230],{"mml:mi":6225},[6226],{"#text":6182},{"mml:mo":6228},[6229],{"#text":1657},{"mml:mn":6231},[6232],{"#text":6233},"0.006",{"@_id":6235},"m126",{"@_id":6237},"inf124",{"#text":6239},", Medium vs. Hard ",{"inline-formula":6241,":@":6258},[6242],{"mml:math":6243,":@":6256},[6244],{"mml:mrow":6245},[6246,6249,6252],{"mml:mi":6247},[6248],{"#text":6182},{"mml:mo":6250},[6251],{"#text":1657},{"mml:mn":6253},[6254],{"#text":6255},"1.000",{"@_id":6257},"m127",{"@_id":6259},"inf125",{"#text":6261},", Bonferroni-corrected). For hand–end-effector distance, RMSE increased from 1.59 cm (IQR 0.93cm, ",{"inline-formula":6263,":@":6279},[6264],{"mml:math":6265,":@":6277},[6266],{"mml:mrow":6267},[6268,6271,6274],{"mml:mi":6269},[6270],{"#text":4725},{"mml:mo":6272},[6273],{"#text":1657},{"mml:mn":6275},[6276],{"#text":6021},{"@_id":6278},"m128",{"@_id":6280},"inf126",{"#text":6282},") at Easy to 1.99 cm (IQR 5.68cm, ",{"inline-formula":6284,":@":6300},[6285],{"mml:math":6286,":@":6298},[6287],{"mml:mrow":6288},[6289,6292,6295],{"mml:mi":6290},[6291],{"#text":4725},{"mml:mo":6293},[6294],{"#text":1657},{"mml:mn":6296},[6297],{"#text":2163},{"@_id":6299},"m129",{"@_id":6301},"inf127",{"#text":6303},") at Medium and 2.77 cm (IQR 3.95cm, ",{"inline-formula":6305,":@":6321},[6306],{"mml:math":6307,":@":6319},[6308],{"mml:mrow":6309},[6310,6313,6316],{"mml:mi":6311},[6312],{"#text":4725},{"mml:mo":6314},[6315],{"#text":1657},{"mml:mn":6317},[6318],{"#text":6021},{"@_id":6320},"m130",{"@_id":6322},"inf128",{"#text":6141},{"inline-formula":6325,":@":6351},[6326],{"mml:math":6327,":@":6349},[6328],{"mml:mrow":6329},[6330,6342,6345],{"mml:msup":6331},[6332,6337],{"mml:mrow":6333},[6334],{"mml:mi":6335},[6336],{"#text":6155},{"mml:mrow":6338},[6339],{"mml:mn":6340},[6341],{"#text":1661},{"mml:mo":6343},[6344],{"#text":1657},{"mml:mn":6346},[6347],{"#text":6348},"7.27",{"@_id":6350},"m131",{"@_id":6352},"inf129",{"#text":2393},{"inline-formula":6355,":@":6372},[6356],{"mml:math":6357,":@":6370},[6358],{"mml:mrow":6359},[6360,6363,6366],{"mml:mi":6361},[6362],{"#text":6182},{"mml:mo":6364},[6365],{"#text":1657},{"mml:mn":6367},[6368],{"#text":6369},"0.026",{"@_id":6371},"m132",{"@_id":6373},"inf130",{"#text":6195},{"inline-formula":6376,":@":6393},[6377],{"mml:math":6378,":@":6391},[6379],{"mml:mrow":6380},[6381,6384,6387],{"mml:mi":6382},[6383],{"#text":6182},{"mml:mo":6385},[6386],{"#text":1657},{"mml:mn":6388},[6389],{"#text":6390},"0.162",{"@_id":6392},"m133",{"@_id":6394},"inf131",{"#text":6217},{"inline-formula":6397,":@":6413},[6398],{"mml:math":6399,":@":6411},[6400],{"mml:mrow":6401},[6402,6405,6408],{"mml:mi":6403},[6404],{"#text":6182},{"mml:mo":6406},[6407],{"#text":1657},{"mml:mn":6409},[6410],{"#text":6369},{"@_id":6412},"m134",{"@_id":6414},"inf132",{"#text":6239},{"inline-formula":6417,":@":6434},[6418],{"mml:math":6419,":@":6432},[6420],{"mml:mrow":6421},[6422,6425,6428],{"mml:mi":6423},[6424],{"#text":6182},{"mml:mo":6426},[6427],{"#text":1657},{"mml:mn":6429},[6430],{"#text":6431},"0.899",{"@_id":6433},"m135",{"@_id":6435},"inf133",{"#text":6437},"). Although median RMSE values remain modest across all levels, the elevated IQR at Medium and Hard difficulty reveals a subset of trials with substantially higher errors. These outliers are attributable to transient occlusions of the wrist landmark during lateral arm extension–a known failure mode of monocular markerless pose estimation (",{"xref":6439,":@":6442},[6440],{"#text":6441},"Dill et al., 2023",{"@_ref-type":1055,"@_rid":6443},"B11",{"#text":6445},") – which introduce brief but sharp deviations in the TIAGo-derived signal. Such events, while infrequent, can transiently affect both the kinematic metrics and the per-repetition score computed from them; their impact on classification is discussed in Section 3.3. The post-hoc comparisons show a consistent pattern for both metrics: the significant difference lies between Easy and the lateral levels (Medium and Hard), while the step from Medium to Hard is not significant, suggesting that the dominant error contribution arises from the transition out of the frontal workspace rather than accumulating linearly with eccentricity. The executed trajectory closely matched the commanded semicircular arc: the mean radius of curvature estimated from gold-standard measurements was ",{"inline-formula":6447,":@":6465},[6448],{"mml:math":6449,":@":6463},[6450],{"mml:mrow":6451},[6452,6456,6459],{"mml:mn":6453},[6454],{"#text":6455},"0.815",{"mml:mo":6457},[6458],{"#text":2054},{"mml:mn":6460},[6461],{"#text":6462},"0.012",{"@_id":6464},"m136",{"@_id":6466},"inf134",{"#text":4660},{"inline-formula":6469,":@":6479},[6470],{"mml:math":6471,":@":6477},[6472],{"mml:mrow":6473},[6474],{"mml:mo":6475},[6476],{"#text":2054},{"@_id":6478},"m137",{"@_id":6480},"inf135",{"#text":6482}," SD), corresponding to a systematic underestimate of 4.1% with respect to the commanded radius ",{"inline-formula":6484,":@":6500},[6485],{"mml:math":6486,":@":6498},[6487],{"mml:mrow":6488},[6489,6492,6495],{"mml:mi":6490},[6491],{"#text":1865},{"mml:mo":6493},[6494],{"#text":1657},{"mml:mn":6496},[6497],{"#text":1872},{"@_id":6499},"m138",{"@_id":6501},"inf136",{"#text":6503},"m, which is attributable to chord interpolation between discrete Cartesian waypoints. End-effector angular velocity showed near-perfect agreement between TIAGo and BTS across all repetitions (mean Pearson ",{"inline-formula":6505,":@":6529},[6506],{"mml:math":6507,":@":6527},[6508],{"mml:mrow":6509},[6510,6513,6516,6520,6523],{"mml:mi":6511},[6512],{"#text":1865},{"mml:mo":6514},[6515],{"#text":1657},{"mml:mn":6517},[6518],{"#text":6519},"0.9975",{"mml:mo":6521},[6522],{"#text":2054},{"mml:mn":6524},[6525],{"#text":6526},"0.0008",{"@_id":6528},"m139",{"@_id":6530},"inf137",{"#text":6532},"; mean RMSE ",{"inline-formula":6534,":@":6558},[6535],{"mml:math":6536,":@":6556},[6537],{"mml:mrow":6538},[6539,6542,6546,6549,6553],{"mml:mo":6540},[6541],{"#text":1657},{"mml:mn":6543},[6544],{"#text":6545},"0.20",{"mml:mo":6547},[6548],{"#text":2054},{"mml:mn":6550},[6551],{"#text":6552},"0.05",{"mml:mo":6554},[6555],{"#text":1469},{"@_id":6557},"m140",{"@_id":6559},"inf138",{"#text":6561},"/s), as did the instantaneous trajectory eccentricity ",{"inline-formula":6563,":@":6588},[6564],{"mml:math":6565,":@":6586},[6566],{"mml:mrow":6567},[6568,6571],{"mml:mi":6569},[6570],{"#text":1494},{"mml:mrow":6572},[6573,6577,6582],{"mml:mo":6574,":@":6576},[6575],{"#text":4109},{"@_stretchy":347},{"mml:mrow":6578},[6579],{"mml:mi":6580},[6581],{"#text":1647},{"mml:mo":6583,":@":6585},[6584],{"#text":4125},{"@_stretchy":347},{"@_id":6587},"m141",{"@_id":6589},"inf139",{"#text":6591}," (mean ",{"inline-formula":6593,":@":6617},[6594],{"mml:math":6595,":@":6615},[6596],{"mml:mrow":6597},[6598,6601,6604,6608,6611],{"mml:mi":6599},[6600],{"#text":1865},{"mml:mo":6602},[6603],{"#text":1657},{"mml:mn":6605},[6606],{"#text":6607},"0.9999",{"mml:mo":6609},[6610],{"#text":2054},{"mml:mn":6612},[6613],{"#text":6614},"0.00003",{"@_id":6616},"m142",{"@_id":6618},"inf140",{"#text":6532},{"inline-formula":6621,":@":6645},[6622],{"mml:math":6623,":@":6643},[6624],{"mml:mrow":6625},[6626,6629,6633,6636,6640],{"mml:mo":6627},[6628],{"#text":1657},{"mml:mn":6630},[6631],{"#text":6632},"1.95",{"mml:mo":6634},[6635],{"#text":2054},{"mml:mn":6637},[6638],{"#text":6639},"0.34",{"mml:mo":6641},[6642],{"#text":1469},{"@_id":6644},"m143",{"@_id":6646},"inf141",{"#text":6648},"). These results confirm that the TIAGo onboard kinematic pipeline faithfully reproduces both the geometry and the dynamics of the executed arc trajectory, independently of the scoring-relevant alignment and distance metrics reported above.",{"#text":885},{"@_id":3074},{"#text":885},{"sec":6653,":@":6776},[6654,6655,6659,6660,6755,6756,6775],{"#text":1440},{"title":6656},[6657],{"#text":6658},"3.2 Physiological pointing threshold",{"#text":870},{"p":6661},[6662,6664,6667,6669,6686,6688,6691,6693,6724,6725,6753],{"#text":6663},"To verify that the ",{"italic":6665},[6666],{"#text":2550},{"#text":6668}," scoring thresholds are conservative with respect to genuinely correct pointing responses, the arm-alignment angle and hand–end-effector distance were analyzed during all repetitions independently verified to be fully correct (Section 2.10). The 95th percentile of the pooled BTS gold-standard distribution was ",{"inline-formula":6670,":@":6684},[6671],{"mml:math":6672,":@":6682},[6673],{"mml:mrow":6674},[6675,6679],{"mml:mn":6676},[6677],{"#text":6678},"4.6",{"mml:mo":6680},[6681],{"#text":1469},{"@_id":6683},"m144",{"@_id":6685},"inf142",{"#text":6687}," for the arm alignment angle and 36.1 cm for the hand–end-effector distance, capturing the baseline physiologic variability of unimpaired pointing responses. Both values fall comfortably below the system’s ",{"italic":6689},[6690],{"#text":2550},{"#text":6692}," thresholds (",{"inline-formula":6694,":@":6722},[6695],{"mml:math":6696,":@":6720},[6697],{"mml:mrow":6698},[6699,6711,6714,6717],{"mml:msub":6700},[6701,6706],{"mml:mrow":6702},[6703],{"mml:mi":6704},[6705],{"#text":3094},{"mml:mrow":6707},[6708],{"mml:mtext":6709},[6710],{"#text":3207},{"mml:mo":6712},[6713],{"#text":1657},{"mml:mn":6715},[6716],{"#text":2059},{"mml:mo":6718},[6719],{"#text":1469},{"@_id":6721},"m145",{"@_id":6723},"inf143",{"#text":2393},{"inline-formula":6726,":@":6751},[6727],{"mml:math":6728,":@":6749},[6729],{"mml:mrow":6730},[6731,6743,6746],{"mml:msub":6732},[6733,6738],{"mml:mrow":6734},[6735],{"mml:mi":6736},[6737],{"#text":3131},{"mml:mrow":6739},[6740],{"mml:mtext":6741},[6742],{"#text":3207},{"mml:mo":6744},[6745],{"#text":1657},{"mml:mn":6747},[6748],{"#text":3246},{"@_id":6750},"m146",{"@_id":6752},"inf144",{"#text":6754},"m), confirming that the scoring thresholds are appropriately conservative and unlikely to penalize genuine, on-target pointing performance.",{"#text":870},{"p":6757},[6758,6760,6773],{"#text":6759},"The physiological distance value is also anatomically plausible rather than arbitrary. With the participant’s shoulder positioned at approximately 0.85 m from the end effector at the nominal reach configuration, the residual 36.1 cm reflects the sum of several geometric offsets between the two tracked reference points, not a coincidence-point error tolerance: the wrist marker used to compute ",{"inline-formula":6761,":@":6771},[6762],{"mml:math":6763,":@":6769},[6764],{"mml:mrow":6765},[6766],{"mml:mi":6767},[6768],{"#text":3131},{"@_id":6770},"m147",{"@_id":6772},"inf145",{"#text":6774}," is located approximately 15 cm proximal to the fingertip along the hand, the reference point used for the end effector is located approximately 10 cm proximal to the tip of TIAGo’s gripper, and a further small clearance remains between fingertip and gripper even at genuine, correctly executed contact. This geometric decomposition indicates that 36.1 cm is a physically plausible upper bound for the wrist–end-effector residual distance during genuine interaction, further supporting the adequacy of the 0.50 m operational threshold, which retains a comfortable margin above this physiological estimate.",{"#text":885},{"@_id":6777},"s3-2",{"#text":885},{"sec":6780,":@":7633},[6781,6782,6786,6787,6867,6868,6989,6990,7074,7075,7259,7260,7400,7401,7632],{"#text":1440},{"title":6783},[6784],{"#text":6785},"3.3 Scoring concordance",{"#text":870},{"p":6788},[6789,6790,6796,6798,6817,6819,6838,6840,6859,6861,6866],{"#text":915},{"xref":6791,":@":6794},[6792],{"#text":6793},"Figure 4a",{"@_ref-type":2650,"@_rid":6795},"F4",{"#text":6797}," shows the per-repetition score distributions for both the TIAGo and BTS systems across both groups and sessions. In the high-performance group (Group A), scores from both systems were tightly concentrated near 100 in both sessions, confirming that participants performed the task correctly and that TIAGo and BTS metrics overlap closely. In the low-performance group (Group B), session one scores exhibited a trimodal distribution reflecting the controlled error pattern: a cluster at ",{"inline-formula":6799,":@":6815},[6800],{"mml:math":6801,":@":6813},[6802],{"mml:mrow":6803},[6804,6807,6810],{"mml:mi":6805},[6806],{"#text":3040},{"mml:mo":6808},[6809],{"#text":3478},{"mml:mn":6811},[6812],{"#text":1465},{"@_id":6814},"m148",{"@_id":6816},"inf146",{"#text":6818}," (arms resting on laps, three repetitions per participant), a cluster at ",{"inline-formula":6820,":@":6836},[6821],{"mml:math":6822,":@":6834},[6823],{"mml:mrow":6824},[6825,6828,6831],{"mml:mi":6826},[6827],{"#text":3040},{"mml:mo":6829},[6830],{"#text":3478},{"mml:mn":6832},[6833],{"#text":4981},{"@_id":6835},"m149",{"@_id":6837},"inf147",{"#text":6839}," (partial attempts matching the contralesional neglect profile; one repetition per participant), and a cluster near ",{"inline-formula":6841,":@":6857},[6842],{"mml:math":6843,":@":6855},[6844],{"mml:mrow":6845},[6846,6849,6852],{"mml:mi":6847},[6848],{"#text":3040},{"mml:mo":6850},[6851],{"#text":1657},{"mml:mn":6853},[6854],{"#text":3289},{"@_id":6856},"m150",{"@_id":6858},"inf148",{"#text":6860}," (correct attempts, two repetitions per participant). TIAGo- and BTS-based classifications demonstrated full agreement across all three performance clusters. Following automated system demotion, session 2 scores for the low-performance group converged to 100 for both systems, indistinguishable from those of the high-performance group at their respective difficulty level. The session-level trajectories underlying these transitions are shown in ",{"xref":6862,":@":6865},[6863],{"#text":6864},"Figure 4b",{"@_ref-type":2650,"@_rid":6795},{"#text":2267},{"#text":870},{"fig":6869,":@":6988},[6870,6871,6875,6876,6975,6976,6987],{"#text":915},{"label":6872},[6873],{"#text":6874},"FIGURE 4",{"#text":915},{"caption":6877},[6878,6879,6974],{"#text":1891},{"p":6880},[6881,6882,6886,6888,6901,6903,6922,6924,6943,6945,6949,6951,6972],{"#text":1956},{"bold":6883},[6884],{"#text":6885},"(a)",{"#text":6887}," Per-repetition scores ",{"inline-formula":6889,":@":6899},[6890],{"mml:math":6891,":@":6897},[6892],{"mml:mrow":6893},[6894],{"mml:mi":6895},[6896],{"#text":3040},{"@_id":6898},"m151",{"@_id":6900},"inf149",{"#text":6902}," (0–100 scale) derived from TIAGo onboard measurements (blue, solid boxes) and BTS mocap reference (orange, dashed boxes), stratified by group and session: Group A (high-performance) in sessions one and 2, and Group B (low-performance) in sessions one and 2. The difficulty level of each condition is indicated below the x-axis. Horizontal dotted lines mark the performance band boundaries (",{"inline-formula":6904,":@":6920},[6905],{"mml:math":6906,":@":6918},[6907],{"mml:mrow":6908},[6909,6912,6915],{"mml:mi":6910},[6911],{"#text":3040},{"mml:mo":6913},[6914],{"#text":1657},{"mml:mn":6916},[6917],{"#text":3520},{"@_id":6919},"m152",{"@_id":6921},"inf150",{"#text":6923},", Fail; ",{"inline-formula":6925,":@":6941},[6926],{"mml:math":6927,":@":6939},[6928],{"mml:mrow":6929},[6930,6933,6936],{"mml:mi":6931},[6932],{"#text":3040},{"mml:mo":6934},[6935],{"#text":1657},{"mml:mn":6937},[6938],{"#text":3552},{"@_id":6940},"m153",{"@_id":6942},"inf151",{"#text":6944},", Great). Individual trial values are overlaid as dots. ",{"bold":6946},[6947],{"#text":6948},"(b)",{"#text":6950}," Session-level mean scores (",{"inline-formula":6952,":@":6970},[6953],{"mml:math":6954,":@":6968},[6955],{"mml:mrow":6956},[6957],{"mml:mover":6958,":@":6967},[6959,6964],{"mml:mrow":6960},[6961],{"mml:mi":6962},[6963],{"#text":3040},{"mml:mo":6965},[6966],{"#text":3646},{"@_accent":15},{"@_id":6969},"m154",{"@_id":6971},"inf152",{"#text":6973},", BTS reference) for Group A (blue) and Group B (red) across the two sessions. Arrows indicate the difficulty-level transition automatically applied by the Coach node between sessions: Group A was promoted to the Hard level, Group B was demoted to the Easy level.",{"#text":915},{"#text":915},{"graphic":6977,":@":6985},[6978,6979,6984],{"#text":1891},{"alt-text":6980,":@":6983},[6981],{"#text":6982},"Boxplot and scatter plot (panel a) comparing scores from a TIAGo robot (blue) and BTS reference (orange), divided by Group A and Group B across sessions and task difficulties, with lines marking “Great” (green, 75) and “Fail” (red, 25) score thresholds. Line graph (panel b) shows mean session scores for high-performance Group A (blue, constant at 100, promoted to hard) and low-performance Group B (red, increasing from ~40 to 100, demoted to easy), with the same performance thresholds.",{"@_content-type":2762},{"#text":915},{"@_mimetype":405,"@_mime-subtype":2765,"@_xlink:href":6986},"frobt-13-1950821-g004.tif",{"#text":870},{"@_id":6795,"@_position":2171},{"#text":870},{"p":6991},[6992,6994,7000,7002,7030,7031,7059,7061,7064,7066,7072],{"#text":6993},"Beyond the aggregate RMSE values, ",{"xref":6995,":@":6998},[6996],{"#text":6997},"Figure 5",{"@_ref-type":2650,"@_rid":6999},"F5",{"#text":7001}," illustrates this agreement at the level of the raw continuous signal for a representative repetition. Both the TIAGo-derived and mocap-derived traces of ",{"inline-formula":7003,":@":7028},[7004],{"mml:math":7005,":@":7026},[7006],{"mml:mrow":7007},[7008,7011],{"mml:mi":7009},[7010],{"#text":3094},{"mml:mrow":7012},[7013,7017,7022],{"mml:mo":7014,":@":7016},[7015],{"#text":4109},{"@_stretchy":347},{"mml:mrow":7018},[7019],{"mml:mi":7020},[7021],{"#text":1647},{"mml:mo":7023,":@":7025},[7024],{"#text":4125},{"@_stretchy":347},{"@_id":7027},"m155",{"@_id":7029},"inf153",{"#text":1255},{"inline-formula":7032,":@":7057},[7033],{"mml:math":7034,":@":7055},[7035],{"mml:mrow":7036},[7037,7040],{"mml:mi":7038},[7039],{"#text":3131},{"mml:mrow":7041},[7042,7046,7051],{"mml:mo":7043,":@":7045},[7044],{"#text":4109},{"@_stretchy":347},{"mml:mrow":7047},[7048],{"mml:mi":7049},[7050],{"#text":1647},{"mml:mo":7052,":@":7054},[7053],{"#text":4125},{"@_stretchy":347},{"@_id":7056},"m156",{"@_id":7058},"inf154",{"#text":7060}," closely track one another throughout the movement, with deviations remaining small relative to the margin separating them from the ",{"italic":7062},[7063],{"#text":2550},{"#text":7065}," scoring thresholds. This continuous-level view complements the pooled RMSE statistics and the discrete band-classification analysis (",{"xref":7067,":@":7070},[7068],{"#text":7069},"Section 3.3",{"@_ref-type":2264,"@_rid":7071},"s3-3",{"#text":7073},") by directly showing that the two instruments agree not only in their final classification outcome, but throughout the time course of the movement.",{"#text":870},{"fig":7076,":@":7258},[7077,7078,7082,7083,7245,7246,7257],{"#text":915},{"label":7079},[7080],{"#text":7081},"FIGURE 5",{"#text":915},{"caption":7084},[7085,7086,7244],{"#text":1891},{"p":7087},[7088,7090,7118,7120,7151,7153,7181,7183,7200,7202,7207,7209,7237,7239,7243],{"#text":7089},"Continuous agreement between TIAGo-derived and mocap-derived kinematic signals for a representative repetition. Top: misalignment angle ",{"inline-formula":7091,":@":7116},[7092],{"mml:math":7093,":@":7114},[7094],{"mml:mrow":7095},[7096,7099],{"mml:mi":7097},[7098],{"#text":3094},{"mml:mrow":7100},[7101,7105,7110],{"mml:mo":7102,":@":7104},[7103],{"#text":4109},{"@_stretchy":347},{"mml:mrow":7106},[7107],{"mml:mi":7108},[7109],{"#text":1647},{"mml:mo":7111,":@":7113},[7112],{"#text":4125},{"@_stretchy":347},{"@_id":7115},"m157",{"@_id":7117},"inf155",{"#text":7119},", with the dashed line marking the operational threshold ",{"inline-formula":7121,":@":7149},[7122],{"mml:math":7123,":@":7147},[7124],{"mml:mrow":7125},[7126,7138,7141,7144],{"mml:msub":7127},[7128,7133],{"mml:mrow":7129},[7130],{"mml:mi":7131},[7132],{"#text":3094},{"mml:mrow":7134},[7135],{"mml:mtext":7136},[7137],{"#text":3207},{"mml:mo":7139},[7140],{"#text":1657},{"mml:mn":7142},[7143],{"#text":2059},{"mml:mo":7145},[7146],{"#text":1469},{"@_id":7148},"m158",{"@_id":7150},"inf156",{"#text":7152},". Bottom: hand–end-effector distance ",{"inline-formula":7154,":@":7179},[7155],{"mml:math":7156,":@":7177},[7157],{"mml:mrow":7158},[7159,7162],{"mml:mi":7160},[7161],{"#text":3131},{"mml:mrow":7163},[7164,7168,7173],{"mml:mo":7165,":@":7167},[7166],{"#text":4109},{"@_stretchy":347},{"mml:mrow":7169},[7170],{"mml:mi":7171},[7172],{"#text":1647},{"mml:mo":7174,":@":7176},[7175],{"#text":4125},{"@_stretchy":347},{"@_id":7178},"m159",{"@_id":7180},"inf157",{"#text":7182},"; the vertical axis is zoomed to a range that keeps the signals visible; the dashed line here marks the data-driven physiological reference bound (",{"inline-formula":7184,":@":7198},[7185],{"mml:math":7186,":@":7196},[7187],{"mml:mrow":7188},[7189,7192],{"mml:mo":7190},[7191],{"#text":3478},{"mml:mn":7193},[7194],{"#text":7195},"0.35",{"@_id":7197},"m160",{"@_id":7199},"inf158",{"#text":7201},"m, close to the 36.1 cm estimate reported in ",{"xref":7203,":@":7206},[7204],{"#text":7205},"Section 3.2",{"@_ref-type":2264,"@_rid":6777},{"#text":7208},") rather than the operational scoring threshold (",{"inline-formula":7210,":@":7235},[7211],{"mml:math":7212,":@":7233},[7213],{"mml:mrow":7214},[7215,7227,7230],{"mml:msub":7216},[7217,7222],{"mml:mrow":7218},[7219],{"mml:mi":7220},[7221],{"#text":3131},{"mml:mrow":7223},[7224],{"mml:mtext":7225},[7226],{"#text":3207},{"mml:mo":7228},[7229],{"#text":1657},{"mml:mn":7231},[7232],{"#text":3246},{"@_id":7234},"m161",{"@_id":7236},"inf159",{"#text":7238},"m), which lies outside the plotted range. The two measurement systems track each other closely throughout the repetition, remaining well below both the physiological reference and the (off-scale) operational threshold at all times, illustrating the continuous-level agreement underlying the perfect discrete band-classification accuracy reported in ",{"xref":7240,":@":7242},[7241],{"#text":3072},{"@_ref-type":2264,"@_rid":3074},{"#text":2267},{"#text":915},{"#text":915},{"graphic":7247,":@":7255},[7248,7249,7254],{"#text":1891},{"alt-text":7250,":@":7253},[7251],{"#text":7252},"Two line graphs compare BTS and TIAGo systems from 20 to 50 seconds. The top graph shows misalignment angle, both lines staying below the red 10-degree threshold. The bottom graph presents distance, with both series remaining under the red 0.35-meter threshold. Legends identify blue as BTS and orange as TIAGo.",{"@_content-type":2762},{"#text":915},{"@_mimetype":405,"@_mime-subtype":2765,"@_xlink:href":7256},"frobt-13-1950821-g005.tif",{"#text":870},{"@_id":6999,"@_position":2171},{"#text":870},{"p":7261},[7262,7263,7269,7271,7290,7292,7312,7314,7318,7320,7349,7351,7355,7357,7386,7388,7392,7394,7398],{"#text":915},{"xref":7264,":@":7267},[7265],{"#text":7266},"Table 3",{"@_ref-type":1852,"@_rid":7268},"T3",{"#text":7270}," reports the ",{"inline-formula":7272,":@":7288},[7273],{"mml:math":7274,":@":7286},[7275],{"mml:mrow":7276},[7277,7280,7283],{"mml:mn":7278},[7279],{"#text":5782},{"mml:mo":7281},[7282],{"#text":3293},{"mml:mn":7284},[7285],{"#text":5782},{"@_id":7287},"m162",{"@_id":7289},"inf160",{"#text":7291}," confusion matrix for per-repetition band classification (Fail/Acceptable/Great) comparing TIAGo-derived and mocap-derived scores across all 120 repetitions. The overall classification accuracy was 100% (Cohen’s ",{"inline-formula":7293,":@":7310},[7294],{"mml:math":7295,":@":7308},[7296],{"mml:mrow":7297},[7298,7302,7305],{"mml:mi":7299},[7300],{"#text":7301},"κ",{"mml:mo":7303},[7304],{"#text":1657},{"mml:mn":7306},[7307],{"#text":6255},{"@_id":7309},"m163",{"@_id":7311},"inf161",{"#text":7313},"). Although transient occlusion artifacts occasionally cause the TIAGo-derived score to deviate from the mocap-derived value within a repetition, these deviations remain confined within the same performance band in all 120 cases. A plausible source of increased occlusion in correctly executed repetitions is the proximity of the wrist to the end effector during active reaching: when the hand approaches the target, the end effector may partially occlude the wrist landmark in the RGB-D camera view. This effect is expected to be more pronounced in Group A, whose participants actively followed the end effector throughout the entire arc, maximizing the time spent with the wrist near the target. Consistently, the score deviations visible in ",{"xref":7315,":@":7317},[7316],{"#text":6793},{"@_ref-type":2650,"@_rid":6795},{"#text":7319}," are concentrated in Group A at Medium difficulty–the condition combining correct full-range reaching with a laterally extended arc for the first time. In contrast, the central cluster of Group B session 1 – comprising the partial repetitions ",{"inline-formula":7321,":@":7347},[7322],{"mml:math":7323,":@":7345},[7324],{"mml:mrow":7325},[7326,7330,7341],{"mml:mo":7327,":@":7329},[7328],{"#text":4109},{"@_stretchy":347},{"mml:mrow":7331},[7332,7335,7338],{"mml:mi":7333},[7334],{"#text":3040},{"mml:mo":7336},[7337],{"#text":3478},{"mml:mn":7339},[7340],{"#text":4981},{"mml:mo":7342,":@":7344},[7343],{"#text":4125},{"@_stretchy":347},{"@_id":7346},"m164",{"@_id":7348},"inf162",{"#text":7350},", in which participants followed the end effector only along the ipsilesional half of the arc and kept the arm at rest during the contralesional excursion–shows tighter agreement between TIAGo and BTS scores, consistent with reduced wrist-to-end-effector proximity and therefore fewer occlusion events. As visible in ",{"xref":7352,":@":7354},[7353],{"#text":6793},{"@_ref-type":2650,"@_rid":6795},{"#text":7356},", only one repetition approached the classification boundary, with a score near the Great threshold ",{"inline-formula":7358,":@":7384},[7359],{"mml:math":7360,":@":7382},[7361],{"mml:mrow":7362},[7363,7367,7378],{"mml:mo":7364,":@":7366},[7365],{"#text":4109},{"@_stretchy":347},{"mml:mrow":7368},[7369,7372,7375],{"mml:mi":7370},[7371],{"#text":3040},{"mml:mo":7373},[7374],{"#text":1657},{"mml:mn":7376},[7377],{"#text":3552},{"mml:mo":7379,":@":7381},[7380],{"#text":4125},{"@_stretchy":347},{"@_id":7383},"m165",{"@_id":7385},"inf163",{"#text":7387},"; all other cases were classified well within their respective bands. Critically, no cross-band errors between Fail and Great occurred in any of the 120 repetitions–the only class of error capable of triggering an erroneous adaptive decision. Given the wide separation of the tested conditions from the band boundaries, this result supports the robustness of the metric to the transient measurement artifacts identified in ",{"xref":7389,":@":7391},[7390],{"#text":3072},{"@_ref-type":2264,"@_rid":3074},{"#text":7393},", but does not by itself establish its discriminative power under naturally graded performance. Notably, despite the experimental design deliberately targeting performance clusters well separated from the decision boundaries, the score of this single repetition nonetheless drifted close to the Great/Acceptable boundary, consistent with the wrist-occlusion effect already discussed above (",{"xref":7395,":@":7397},[7396],{"#text":6793},{"@_ref-type":2650,"@_rid":6795},{"#text":7399},"): the proximity of the wrist to the end effector during active reaching intermittently degraded landmark tracking confidence, producing exactly the kind of boundary-approaching deviation anticipated in this analysis.",{"#text":870},{"table-wrap":7402,":@":7631},[7403,7404,7408,7409,7448,7449,7630],{"#text":915},{"label":7405},[7406],{"#text":7407},"TABLE 3",{"#text":915},{"caption":7410},[7411,7412,7447],{"#text":1891},{"p":7413},[7414,7416,7446],{"#text":7415},"Confusion matrix for per-repetition performance classification. Rows: mocap-derived classification (ground truth). Columns: TIAGo-derived classification. Counts pooled across all participants, sessions, and difficulty levels ",{"inline-formula":7417,":@":7444},[7418],{"mml:math":7419,":@":7442},[7420],{"mml:mrow":7421},[7422,7426,7438],{"mml:mo":7423,":@":7425},[7424],{"#text":4109},{"@_stretchy":347},{"mml:mrow":7427},[7428,7431,7434],{"mml:mi":7429},[7430],{"#text":3326},{"mml:mo":7432},[7433],{"#text":1657},{"mml:mn":7435},[7436],{"#text":7437},"120",{"mml:mo":7439,":@":7441},[7440],{"#text":4125},{"@_stretchy":347},{"@_id":7443},"m166",{"@_id":7445},"inf164",{"#text":2267},{"#text":915},{"#text":915},{"table":7450},[7451,7452,7507,7508,7629],{"#text":1891},{"thead":7453,":@":7506},[7454,7455,7471,7472,7505],{"#text":1956},{"tr":7456},[7457,7458,7461,7462,7466,7467,7470],{"#text":1960},{"th":7459,":@":7460},[],{"@_align":1966},{"#text":1960},{"th":7463,":@":7465},[7464],{"#text":576},{"@_colspan":664,"@_align":2015},{"#text":1960},{"th":7468,":@":7469},[],{"@_align":1966},{"#text":1956},{"#text":1956},{"tr":7473},[7474,7475,7480,7481,7486,7487,7492,7493,7498,7499,7504],{"#text":1960},{"th":7476,":@":7479},[7477],{"#text":7478},"Mocap reference",{"@_align":1966},{"#text":1960},{"th":7482,":@":7485},[7483],{"#text":7484},"Fail",{"@_align":2015},{"#text":1960},{"th":7488,":@":7491},[7489],{"#text":7490},"Acceptable",{"@_align":2015},{"#text":1960},{"th":7494,":@":7497},[7495],{"#text":7496},"Great",{"@_align":2015},{"#text":1960},{"th":7500,":@":7503},[7501],{"#text":7502},"Total",{"@_align":2015},{"#text":1956},{"#text":1891},{"@_valign":2025},{"#text":1891},{"tbody":7509,":@":7628},[7510,7511,7539,7540,7568,7569,7598,7599,7627],{"#text":1956},{"tr":7512},[7513,7514,7518,7519,7523,7524,7528,7529,7533,7534,7538],{"#text":1960},{"td":7515,":@":7517},[7516],{"#text":7484},{"@_align":1966},{"#text":1960},{"td":7520,":@":7522},[7521],{"#text":6021},{"@_align":2015},{"#text":1960},{"td":7525,":@":7527},[7526],{"#text":1465},{"@_align":2015},{"#text":1960},{"td":7530,":@":7532},[7531],{"#text":1465},{"@_align":2015},{"#text":1960},{"td":7535,":@":7537},[7536],{"#text":6021},{"@_align":2015},{"#text":1956},{"#text":1956},{"tr":7541},[7542,7543,7547,7548,7552,7553,7557,7558,7562,7563,7567],{"#text":1960},{"td":7544,":@":7546},[7545],{"#text":7490},{"@_align":1966},{"#text":1960},{"td":7549,":@":7551},[7550],{"#text":1465},{"@_align":2015},{"#text":1960},{"td":7554,":@":7556},[7555],{"#text":4732},{"@_align":2015},{"#text":1960},{"td":7559,":@":7561},[7560],{"#text":1465},{"@_align":2015},{"#text":1960},{"td":7564,":@":7566},[7565],{"#text":4732},{"@_align":2015},{"#text":1956},{"#text":1956},{"tr":7570},[7571,7572,7576,7577,7581,7582,7586,7587,7592,7593,7597],{"#text":1960},{"td":7573,":@":7575},[7574],{"#text":7496},{"@_align":1966},{"#text":1960},{"td":7578,":@":7580},[7579],{"#text":1465},{"@_align":2015},{"#text":1960},{"td":7583,":@":7585},[7584],{"#text":1465},{"@_align":2015},{"#text":1960},{"td":7588,":@":7591},[7589],{"#text":7590},"88",{"@_align":2015},{"#text":1960},{"td":7594,":@":7596},[7595],{"#text":7590},{"@_align":2015},{"#text":1956},{"#text":1956},{"tr":7600},[7601,7602,7606,7607,7611,7612,7616,7617,7621,7622,7626],{"#text":1960},{"td":7603,":@":7605},[7604],{"#text":7502},{"@_align":1966},{"#text":1960},{"td":7608,":@":7610},[7609],{"#text":6021},{"@_align":2015},{"#text":1960},{"td":7613,":@":7615},[7614],{"#text":4732},{"@_align":2015},{"#text":1960},{"td":7618,":@":7620},[7619],{"#text":7590},{"@_align":2015},{"#text":1960},{"td":7623,":@":7625},[7624],{"#text":7437},{"@_align":2015},{"#text":1956},{"#text":1891},{"@_valign":2025},{"#text":915},{"#text":870},{"@_id":7268,"@_position":2171},{"#text":885},{"@_id":7071},{"#text":885},{"sec":7636,":@":7986},[7637,7638,7642,7643,7653,7654,7798,7799,7969,7970,7985],{"#text":1440},{"title":7639},[7640],{"#text":7641},"3.4 Adaptive behavior validation",{"#text":870},{"p":7644},[7645,7647,7651],{"#text":7646},"The adaptive difficulty progression logic operated correctly for all 16 participants, as verified by comparing the system-assigned difficulty level for session 2 against the expected outcome for each group. All adaptive decisions were based on TIAGo-derived session statistics, whose concordance with the BTS reference (",{"xref":7648,":@":7650},[7649],{"#text":7069},{"@_ref-type":2264,"@_rid":7071},{"#text":7652},") confirms the validity of the decisions.",{"#text":870},{"p":7655},[7656,7658,7695,7697,7726,7728,7757,7759,7796],{"#text":7657},"In the high-performance group (A), all eight participants achieved TIAGo-derived mean session scores well above the promotion threshold in session 1 (group mean ",{"inline-formula":7659,":@":7693},[7660],{"mml:math":7661,":@":7691},[7662],{"mml:mrow":7663},[7664,7677,7680,7684,7687],{"mml:mrow":7665},[7666],{"mml:mover":7667,":@":7676},[7668,7673],{"mml:mrow":7669},[7670],{"mml:mi":7671},[7672],{"#text":3040},{"mml:mo":7674},[7675],{"#text":3646},{"@_accent":15},{"mml:mo":7678},[7679],{"#text":1657},{"mml:mn":7681},[7682],{"#text":7683},"93.5",{"mml:mo":7685},[7686],{"#text":2054},{"mml:mn":7688},[7689],{"#text":7690},"6.3",{"@_id":7692},"m167",{"@_id":7694},"inf165",{"#text":7696},", range 86.0–100.0, fail ratio = 0.00), triggering automatic promotion to the Hard level ",{"inline-formula":7698,":@":7724},[7699],{"mml:math":7700,":@":7722},[7701],{"mml:mrow":7702},[7703,7707,7718],{"mml:mo":7704,":@":7706},[7705],{"#text":4109},{"@_stretchy":347},{"mml:mrow":7708},[7709,7712,7715],{"mml:mo":7710},[7711],{"#text":2054},{"mml:mn":7713},[7714],{"#text":2073},{"mml:mo":7716},[7717],{"#text":1469},{"mml:mo":7719,":@":7721},[7720],{"#text":4125},{"@_stretchy":347},{"@_id":7723},"m168",{"@_id":7725},"inf166",{"#text":7727}," for session 2. The lower mean relative to the BTS-derived scores is likely attributable to transient occlusion artifacts, but all individual session means remained well above the ",{"inline-formula":7729,":@":7755},[7730],{"mml:math":7731,":@":7753},[7732],{"mml:mrow":7733},[7734,7747,7750],{"mml:mrow":7735},[7736],{"mml:mover":7737,":@":7746},[7738,7743],{"mml:mrow":7739},[7740],{"mml:mi":7741},[7742],{"#text":3040},{"mml:mo":7744},[7745],{"#text":3646},{"@_accent":15},{"mml:mo":7748},[7749],{"#text":1657},{"mml:mn":7751},[7752],{"#text":3552},{"@_id":7754},"m169",{"@_id":7756},"inf167",{"#text":7758}," threshold, ensuring correct promotion for every participant. Mean scores in session 2 remained high (",{"inline-formula":7760,":@":7794},[7761],{"mml:math":7762,":@":7792},[7763],{"mml:mrow":7764},[7765,7778,7781,7785,7788],{"mml:mrow":7766},[7767],{"mml:mover":7768,":@":7777},[7769,7774],{"mml:mrow":7770},[7771],{"mml:mi":7772},[7773],{"#text":3040},{"mml:mo":7775},[7776],{"#text":3646},{"@_accent":15},{"mml:mo":7779},[7780],{"#text":1657},{"mml:mn":7782},[7783],{"#text":7784},"95.5",{"mml:mo":7786},[7787],{"#text":2054},{"mml:mn":7789},[7790],{"#text":7791},"5.7",{"@_id":7793},"m170",{"@_id":7795},"inf168",{"#text":7797},", range 86.2–100.0, fail ratio = 0.00), confirming that the onboard scoring system reliably captured high-quality performance also at the increased arc eccentricity of the Hard level.",{"#text":870},{"p":7800},[7801,7803,7831,7833,7862,7864,7901,7903,7922,7924,7961,7963,7967],{"#text":7802},"In the low-performance group (B), all eight participants produced a fail ratio of exactly ",{"inline-formula":7804,":@":7829},[7805],{"mml:math":7806,":@":7827},[7807],{"mml:mrow":7808},[7809,7821,7824],{"mml:msub":7810},[7811,7816],{"mml:mrow":7812},[7813],{"mml:mi":7814},[7815],{"#text":1865},{"mml:mrow":7817},[7818],{"mml:mtext":7819},[7820],{"#text":3672},{"mml:mo":7822},[7823],{"#text":1657},{"mml:mn":7825},[7826],{"#text":3246},{"@_id":7828},"m171",{"@_id":7830},"inf169",{"#text":7832}," in session 1 (24 of 48 repetitions scoring below 25), meeting the demotion threshold and triggering automatic demotion to the Easy level ",{"inline-formula":7834,":@":7860},[7835],{"mml:math":7836,":@":7858},[7837],{"mml:mrow":7838},[7839,7843,7854],{"mml:mo":7840,":@":7842},[7841],{"#text":4109},{"@_stretchy":347},{"mml:mrow":7844},[7845,7848,7851],{"mml:mo":7846},[7847],{"#text":2054},{"mml:mn":7849},[7850],{"#text":2059},{"mml:mo":7852},[7853],{"#text":1469},{"mml:mo":7855,":@":7857},[7856],{"#text":4125},{"@_stretchy":347},{"@_id":7859},"m172",{"@_id":7861},"inf170",{"#text":7863}," for session 2. The mean session score per participant (",{"inline-formula":7865,":@":7899},[7866],{"mml:math":7867,":@":7897},[7868],{"mml:mrow":7869},[7870,7883,7886,7890,7893],{"mml:mrow":7871},[7872],{"mml:mover":7873,":@":7882},[7874,7879],{"mml:mrow":7875},[7876],{"mml:mi":7877},[7878],{"#text":3040},{"mml:mo":7880},[7881],{"#text":3646},{"@_accent":15},{"mml:mo":7884},[7885],{"#text":1657},{"mml:mn":7887},[7888],{"#text":7889},"41.2",{"mml:mo":7891},[7892],{"#text":2054},{"mml:mn":7894},[7895],{"#text":7896},"0.8",{"@_id":7898},"m173",{"@_id":7900},"inf171",{"#text":7902},", range 39.7–41.8) is consistent with the controlled error pattern (three zero-score repetitions and one ",{"inline-formula":7904,":@":7920},[7905],{"mml:math":7906,":@":7918},[7907],{"mml:mrow":7908},[7909,7912,7915],{"mml:mi":7910},[7911],{"#text":3040},{"mml:mo":7913},[7914],{"#text":3478},{"mml:mn":7916},[7917],{"#text":4981},{"@_id":7919},"m174",{"@_id":7921},"inf172",{"#text":7923}," repetition per participant). Following demotion, all eight participants achieved near-perfect scores in session 2 (",{"inline-formula":7925,":@":7959},[7926],{"mml:math":7927,":@":7957},[7928],{"mml:mrow":7929},[7930,7943,7946,7950,7953],{"mml:mrow":7931},[7932],{"mml:mover":7933,":@":7942},[7934,7939],{"mml:mrow":7935},[7936],{"mml:mi":7937},[7938],{"#text":3040},{"mml:mo":7940},[7941],{"#text":3646},{"@_accent":15},{"mml:mo":7944},[7945],{"#text":1657},{"mml:mn":7947},[7948],{"#text":7949},"99.6",{"mml:mo":7951},[7952],{"#text":2054},{"mml:mn":7954},[7955],{"#text":7956},"1.0",{"@_id":7958},"m175",{"@_id":7960},"inf173",{"#text":7962},", range 97.3–100.0, fail ratio = 0.00), consistent with the lower RMSE observed at the Easy difficulty level (",{"xref":7964,":@":7966},[7965],{"#text":3072},{"@_ref-type":2264,"@_rid":3074},{"#text":7968},"), which reduces the likelihood of artifact-induced score deviations.",{"#text":870},{"p":7971},[7972,7974,7978,7980,7983],{"#text":7973},"The session-level score trajectories for both groups are shown in ",{"xref":7975,":@":7977},[7976],{"#text":6864},{"@_ref-type":2650,"@_rid":6795},{"#text":7979},". It should be noted that the error pattern in session one of the low-performance group was deliberately piloted by the experimenter–all participants were fully capable of performing the task correctly at all difficulty levels, as demonstrated by the correct executions within the same session. The controlled condition was designed to simulate the performance profile expected from a USN patient struggling with the current difficulty level, and validates the demotion logic under a worst-case scenario. The between-session score changes therefore serve primarily as a functional end-to-end verification of the data pipeline, from per-repetition metric computation in the BT through session-level aggregation in ",{"monospace":7981},[7982],{"#text":2732},{"#text":7984}," to the difficulty decision in the Coach node.",{"#text":885},{"@_id":7987},"s3-4",{"#text":1036},{"@_sec-type":7990,"@_id":7991},"results","s3",{"#text":1036},{"sec":7994,":@":8829,"anchorId":8423},[7995,7996,8000,8001,8005,8006,8038,8039,8429,8430,8445,8446,8645,8646,8789,8790,8828],{"#text":1040},{"title":7997},[7998],{"#text":7999},"4 Discussion",{"#text":885},{"p":8002},[8003],{"#text":8004},"This study evaluated three prerequisites for the clinical deployment of HemiBot as an autonomous rehabilitation coaching system: the reliability of the onboard kinematic sensing pipeline, the accuracy of the per-repetition scoring metric, and the correctness of the adaptive difficulty progression logic. The results provide positive evidence on all three fronts, while also identifying specific technical limitations that must be addressed before the system can be used with patient populations.",{"#text":885},{"sec":8007,":@":8036},[8008,8009,8013,8014,8035],{"#text":1440},{"title":8010},[8011],{"#text":8012},"4.1 Kinematic sensing",{"#text":870},{"p":8015},[8016,8018,8022,8024,8028,8030,8034],{"#text":8017},"RMSE increased significantly with arc eccentricity for both metrics, with post-hoc differences significant between Easy and Medium and between Easy and Hard, but not between Medium and Hard, suggesting that the dominant contribution to absolute error arises from the transition from the frontal to the lateral workspace rather than accumulating linearly with eccentricity. The concurrent increase in dispersion at higher difficulty levels points to a subset of trials affected by transient wrist occlusions during lateral arm extension, a known failure mode of monocular markerless pose estimation at non-frontal configurations (",{"xref":8019,":@":8021},[8020],{"#text":6441},{"@_ref-type":1055,"@_rid":6443},{"#text":8023},"). Despite this, median RMSE values remain modest across all difficulty levels, so the observed artifacts do not compromise classification accuracy–a point confirmed by the perfect scoring concordance (",{"xref":8025,":@":8027},[8026],{"#text":7069},{"@_ref-type":2264,"@_rid":7071},{"#text":8029},"). The proximity of the wrist to the end effector during active reaching provides a further, task-specific source of occlusion in correctly executed repetitions–an effect expected to be more pronounced in Group A, who followed the end effector actively throughout the arc, as discussed in ",{"xref":8031,":@":8033},[8032],{"#text":7069},{"@_ref-type":2264,"@_rid":7071},{"#text":2267},{"#text":885},{"@_id":8037},"s4-1",{"#text":885},{"sec":8040,":@":8427},[8041,8042,8046,8047,8426],{"#text":1440},{"title":8043},[8044],{"#text":8045},"4.2 Scoring concordance",{"#text":870},{"p":8048},[8049,8051,8055,8057,8076,8077,8096,8097,8116,8118,8137,8138,8157,8159,8163,8165,8197,8199,8231,8233,8253,8255,8275,8277,8306,8308,8330,8332,8337,8339,8343,8345,8366,8367,8389,8391,8416,8418,8424],{"#text":8050},"It should first be recalled that the objective of this analysis was to verify the fidelity of the onboard, markerless measurement pipeline against the mocap gold standard, specifically, whether the TIAGo-derived score for a given repetition consistently falls in the same performance band as the mocap-derived score, under conditions in which healthy participants were explicitly instructed and piloted to reproduce a targeted performance level (Fail, Acceptable, or Great). The absence of band misclassification across all 120 repetitions confirms that the markerless onboard tracker, despite the transient artifacts reported in ",{"xref":8052,":@":8054},[8053],{"#text":3072},{"@_ref-type":2264,"@_rid":3074},{"#text":8056},", does not introduce errors large enough to displace a repetition from its reference band. In particular, no cross-band error between Fail and Great occurred–the only class of error capable of triggering an incorrect adaptive decision. However, this result should be interpreted in light of the experimental design. The performance conditions tested in this study were centered around distinct clusters (",{"inline-formula":8058,":@":8074},[8059],{"mml:math":8060,":@":8072},[8061],{"mml:mrow":8062},[8063,8066,8069],{"mml:mi":8064},[8065],{"#text":3040},{"mml:mo":8067},[8068],{"#text":3478},{"mml:mn":8070},[8071],{"#text":1465},{"@_id":8073},"m176",{"@_id":8075},"inf174",{"#text":2393},{"inline-formula":8078,":@":8094},[8079],{"mml:math":8080,":@":8092},[8081],{"mml:mrow":8082},[8083,8086,8089],{"mml:mi":8084},[8085],{"#text":3040},{"mml:mo":8087},[8088],{"#text":3478},{"mml:mn":8090},[8091],{"#text":4981},{"@_id":8093},"m177",{"@_id":8095},"inf175",{"#text":1255},{"inline-formula":8098,":@":8114},[8099],{"mml:math":8100,":@":8112},[8101],{"mml:mrow":8102},[8103,8106,8109],{"mml:mi":8104},[8105],{"#text":3040},{"mml:mo":8107},[8108],{"#text":3478},{"mml:mn":8110},[8111],{"#text":3289},{"@_id":8113},"m178",{"@_id":8115},"inf176",{"#text":8117},"), maintaining margins of at least 25 points from the classification boundaries at ",{"inline-formula":8119,":@":8135},[8120],{"mml:math":8121,":@":8133},[8122],{"mml:mrow":8123},[8124,8127,8130],{"mml:mi":8125},[8126],{"#text":3040},{"mml:mo":8128},[8129],{"#text":1657},{"mml:mn":8131},[8132],{"#text":3520},{"@_id":8134},"m179",{"@_id":8136},"inf177",{"#text":1255},{"inline-formula":8139,":@":8155},[8140],{"mml:math":8141,":@":8153},[8142],{"mml:mrow":8143},[8144,8147,8150],{"mml:mi":8145},[8146],{"#text":3040},{"mml:mo":8148},[8149],{"#text":1657},{"mml:mn":8151},[8152],{"#text":3552},{"@_id":8154},"m180",{"@_id":8156},"inf178",{"#text":8158},". As visible in ",{"xref":8160,":@":8162},[8161],{"#text":6793},{"@_ref-type":2650,"@_rid":6795},{"#text":8164},", only one repetition approached a decision boundary. Consequently, while these findings establish high classification accuracy for unambiguous motor performance, they do not fully characterize the system’s behavior when performance occurs near the decision thresholds (e.g., ",{"inline-formula":8166,":@":8195},[8167],{"mml:math":8168,":@":8193},[8169],{"mml:mrow":8170},[8171,8174,8177],{"mml:mi":8172},[8173],{"#text":3040},{"mml:mo":8175},[8176],{"#text":3044},{"mml:mrow":8178},[8179,8183,8189],{"mml:mo":8180,":@":8182},[8181],{"#text":3050},{"@_stretchy":347},{"mml:mrow":8184},[8185],{"mml:mn":8186},[8187],{"#text":8188},"20,30",{"mml:mo":8190,":@":8192},[8191],{"#text":3061},{"@_stretchy":347},{"@_id":8194},"m181",{"@_id":8196},"inf179",{"#text":8198}," or ",{"inline-formula":8200,":@":8229},[8201],{"mml:math":8202,":@":8227},[8203],{"mml:mrow":8204},[8205,8208,8211],{"mml:mi":8206},[8207],{"#text":3040},{"mml:mo":8209},[8210],{"#text":3044},{"mml:mrow":8212},[8213,8217,8223],{"mml:mo":8214,":@":8216},[8215],{"#text":3050},{"@_stretchy":347},{"mml:mrow":8218},[8219],{"mml:mn":8220},[8221],{"#text":8222},"70,80",{"mml:mo":8224,":@":8226},[8225],{"#text":3061},{"@_stretchy":347},{"@_id":8228},"m182",{"@_id":8230},"inf180",{"#text":8232},"). Near these boundaries, even minor measurement perturbations—such as brief wrist occlusions during lateral reaching—could potentially cause boundary jitter. For instance, a genuinely high-quality trial with a true motor performance of ",{"inline-formula":8234,":@":8251},[8235],{"mml:math":8236,":@":8249},[8237],{"mml:mrow":8238},[8239,8242,8245],{"mml:mi":8240},[8241],{"#text":3040},{"mml:mo":8243},[8244],{"#text":1657},{"mml:mn":8246},[8247],{"#text":8248},"76",{"@_id":8250},"m183",{"@_id":8252},"inf181",{"#text":8254}," might be misclassified as Acceptable if a transient occlusion drops the TIAGo-derived score to ",{"inline-formula":8256,":@":8273},[8257],{"mml:math":8258,":@":8271},[8259],{"mml:mrow":8260},[8261,8264,8267],{"mml:mi":8262},[8263],{"#text":3040},{"mml:mo":8265},[8266],{"#text":1657},{"mml:mn":8268},[8269],{"#text":8270},"74",{"@_id":8272},"m184",{"@_id":8274},"inf182",{"#text":8276},". While such intra-band shifts (between Great and Acceptable) do not trigger inappropriate demotions, a similar shift near the lower boundary ",{"inline-formula":8278,":@":8304},[8279],{"mml:math":8280,":@":8302},[8281],{"mml:mrow":8282},[8283,8287,8298],{"mml:mo":8284,":@":8286},[8285],{"#text":4109},{"@_stretchy":347},{"mml:mrow":8288},[8289,8292,8295],{"mml:mi":8290},[8291],{"#text":3040},{"mml:mo":8293},[8294],{"#text":1657},{"mml:mn":8296},[8297],{"#text":3520},{"mml:mo":8299,":@":8301},[8300],{"#text":4125},{"@_stretchy":347},{"@_id":8303},"m185",{"@_id":8305},"inf183",{"#text":8307}," could affect the session fail ratio ",{"inline-formula":8309,":@":8328},[8310],{"mml:math":8311,":@":8326},[8312],{"mml:mrow":8313},[8314],{"mml:msub":8315},[8316,8321],{"mml:mrow":8317},[8318],{"mml:mi":8319},[8320],{"#text":1865},{"mml:mrow":8322},[8323],{"mml:mtext":8324},[8325],{"#text":3672},{"@_id":8327},"m186",{"@_id":8329},"inf184",{"#text":8331}," and prematurely trigger a difficulty reduction. This is consistent with the underlying tracking implementation (",{"xref":8333,":@":8336},[8334],{"#text":8335},"Section 2.5",{"@_ref-type":2264,"@_rid":3017},{"#text":8338},"): occlusions are not explicitly detected, and a landmark is discarded for a given frame only when it yields an invalid depth reading, in which case the sample is omitted rather than extrapolated by the Kalman filter. Occlusions that still return a valid depth value are instead retained as degraded samples. No minimum-valid-sample threshold is enforced before a repetition is scored. Therefore, an occlusion episode can either reduce the number of samples contributing to a repetition’s score, or inject artifact-affected samples into it, without triggering any explicit invalidation. These are the most plausible mechanisms underlying the boundary-approaching deviation discussed above. To mitigate this risk in clinical deployment, two structural safeguards are built into the architecture. First, the real-time graphical scoreboard (",{"xref":8340,":@":8342},[8341],{"#text":3937},{"@_ref-type":2650,"@_rid":3939},{"#text":8344},") requires therapist validation after each repetition, allowing the clinician to manually override artifact-affected scores prior to BT advancement or Coach node aggregation. Second, progression decisions are driven by session-wide metrics (",{"inline-formula":8346,":@":8364},[8347],{"mml:math":8348,":@":8362},[8349],{"mml:mrow":8350},[8351],{"mml:mover":8352,":@":8361},[8353,8358],{"mml:mrow":8354},[8355],{"mml:mi":8356},[8357],{"#text":3040},{"mml:mo":8359},[8360],{"#text":3646},{"@_accent":15},{"@_id":8363},"m187",{"@_id":8365},"inf185",{"#text":1255},{"inline-formula":8368,":@":8387},[8369],{"mml:math":8370,":@":8385},[8371],{"mml:mrow":8372},[8373],{"mml:msub":8374},[8375,8380],{"mml:mrow":8376},[8377],{"mml:mi":8378},[8379],{"#text":1865},{"mml:mrow":8381},[8382],{"mml:mtext":8383},[8384],{"#text":3672},{"@_id":8386},"m188",{"@_id":8388},"inf186",{"#text":8390},") rather than single-repetition triggers, inherently smoothing out isolated tracking anomalies. Furthermore, future iterations of the Coach node will incorporate a decision hysteresis band (e.g., ",{"inline-formula":8392,":@":8414},[8393],{"mml:math":8394,":@":8412},[8395],{"mml:mrow":8396},[8397,8400,8403,8406,8409],{"mml:mi":8398},[8399],{"#text":3040},{"mml:mo":8401},[8402],{"#text":1657},{"mml:mn":8404},[8405],{"#text":3552},{"mml:mo":8407},[8408],{"#text":2054},{"mml:mn":8410},[8411],{"#text":4340},{"@_id":8413},"m189",{"@_id":8415},"inf187",{"#text":8417},") or exponential moving averages across consecutive sessions, preventing rapid oscillation between difficulty levels for patients exhibiting borderline performance. (",{"xref":8419,":@":8422},[8420],{"#text":8421},"Section 4",{"@_ref-type":2264,"@_rid":8423},"s4",{"#text":8425},", Limitations).",{"#text":885},{"@_id":8428},"s4-2",{"#text":885},{"sec":8431,":@":8443},[8432,8433,8437,8438,8442],{"#text":1440},{"title":8434},[8435],{"#text":8436},"4.3 Adaptive behavior",{"#text":870},{"p":8439},[8440],{"#text":8441},"The correct adaptive decisions for all 16 participants confirm that the promotion and demotion rules operate as intended. This experiment mainly verifies that the adaptation logic works as intended; its behavior under the more variable performance expected from patients will need to be assessed in future studies. Beyond the algorithmic correctness, this result also validates the reliability of the entire data pipeline: the difficulty decision depends on session-level statistics that are computed by aggregating per-repetition metrics collected across multiple asynchronous ROS 2 nodes, and any failure in this chain would have produced an incorrect adaptive decision. Correct end-to-end behavior across all 16 participants is therefore a non-trivial validation result for a distributed, asynchronous ROS 2 pipeline.",{"#text":885},{"@_id":8444},"s4-3",{"#text":885},{"sec":8447,":@":8643},[8448,8449,8453,8454,8518,8519,8585,8586,8637,8638,8642],{"#text":1440},{"title":8450},[8451],{"#text":8452},"4.4 Comparison with related work",{"#text":870},{"p":8455},[8456,8458,8462,8464,8468,8470,8473,8475,8478,8480,8483,8485,8488,8489,8493,8495,8499,8500,8504,8505,8509,8511,8516],{"#text":8457},"Contact-based systems such as the REAplan (",{"xref":8459,":@":8461},[8460],{"#text":1272},{"@_ref-type":1055,"@_rid":1274},{"#text":8463},") and the Armule (",{"xref":8465,":@":8467},[8466],{"#text":1264},{"@_ref-type":1055,"@_rid":1266},{"#text":8469},") implement adaptive difficulty for robot-assisted rehabilitation through physical guidance or resistance. The present system achieves adaptive coaching in a non-contact paradigm, which is particularly relevant for USN patients who may resist physical interaction and for whom exogenous visual stimulation in contralesional space is the primary therapeutic modality. Unlike force-based approaches, which predominantly target the ",{"italic":8471},[8472],{"#text":1199},{"#text":8474}," component of the neglect deficit through motor assistance, the present paradigm couples the ",{"italic":8476},[8477],{"#text":1193},{"#text":8479}," (perceptual-attentional) and ",{"italic":8481},[8482],{"#text":1199},{"#text":8484}," (motor-intentional) components within a single task, in line with the ",{"italic":8486},[8487],{"#text":1179},{"#text":1181},{"xref":8490,":@":8492},[8491],{"#text":1185},{"@_ref-type":1055,"@_rid":1187},{"#text":8494},") and the evidence base for spatiomotor cueing and Limb Activation Treatment (",{"xref":8496,":@":8498},[8497],{"#text":1211},{"@_ref-type":1055,"@_rid":1213},{"#text":1058},{"xref":8501,":@":8503},[8502],{"#text":1218},{"@_ref-type":1055,"@_rid":1220},{"#text":1058},{"xref":8506,":@":8508},[8507],{"#text":1225},{"@_ref-type":1055,"@_rid":1227},{"#text":8510},"). As noted in ",{"xref":8512,":@":8515},[8513],{"#text":8514},"Somma et al. (2026)",{"@_ref-type":1055,"@_rid":1235},{"#text":8517},", this joint attentional-motor approach remains comparatively underexplored in robotic platforms for USN rehabilitation.",{"#text":870},{"p":8520},[8521,8523,8529,8531,8534,8536,8553,8555,8575,8577,8583],{"#text":8522},"Data-driven personalization of exercise difficulty has been validated in exoskeleton-based systems: a retrospective analysis of Armeo Spring session logs across 71 patients showed that task difficulty is a consistent determinant of performance and that disease-specific improvement trajectories can be identified, supporting the use of quantitative performance data to guide progressive difficulty adaptation (",{"xref":8524,":@":8527},[8525],{"#text":8526},"Lui et al., 2026",{"@_ref-type":1055,"@_rid":8528},"B22",{"#text":8530},"). The BT-based architecture offers a complementary modularity advantage: each behavioral node can be independently tested, replaced, or extended–for instance, by substituting ",{"monospace":8532},[8533],{"#text":2726},{"#text":8535}," with a gaze-aware scoring node once reliable eye-tracking becomes available–without modifying the overall session orchestration logic. A recent systematic review and meta-analysis demonstrated that ML-adaptive virtual reality systems–predominantly using reinforcement learning and deep learning for real-time difficulty adjustment–improve upper limb motor function in stroke survivors by a clinically significant margin (FMA-UE mean difference: ",{"inline-formula":8537,":@":8551},[8538],{"mml:math":8539,":@":8549},[8540],{"mml:mrow":8541},[8542,8545],{"mml:mo":8543},[8544],{"#text":1486},{"mml:mn":8546},[8547],{"#text":8548},"7.47",{"@_id":8550},"m190",{"@_id":8552},"inf188",{"#text":8554}," points, 95%CI: 5.38–9.57, ",{"inline-formula":8556,":@":8573},[8557],{"mml:math":8558,":@":8571},[8559],{"mml:mrow":8560},[8561,8564,8567],{"mml:mi":8562},[8563],{"#text":6182},{"mml:mo":8565},[8566],{"#text":3516},{"mml:mn":8568},[8569],{"#text":8570},"0.001",{"@_id":8572},"m191",{"@_id":8574},"inf189",{"#text":8576},") (",{"xref":8578,":@":8581},[8579],{"#text":8580},"Al Tawil et al., 2026",{"@_ref-type":1055,"@_rid":8582},"B1",{"#text":8584},"), suggesting that analogous real-time adaptation mechanisms applied to HemiBot’s trajectory parameters represent a natural next step.",{"#text":870},{"p":8587},[8588,8590,8607,8608,8614,8616,8622,8624,8627,8629,8635],{"#text":8589},"The non-contact coaching role of humanoid robots in rehabilitation has been validated from two complementary perspectives. A reliability study using the THER-I-ACT instrument demonstrated that coaching, feedback, and relational therapeutic interactions delivered by a humanoid robot can be comprehensively and reliably assessed (ICC ",{"inline-formula":8591,":@":8605},[8592],{"mml:math":8593,":@":8603},[8594],{"mml:mrow":8595},[8596,8599],{"mml:mo":8597},[8598],{"#text":3575},{"mml:mn":8600},[8601],{"#text":8602},"0.90",{"@_id":8604},"m192",{"@_id":8606},"inf190",{"#text":8576},{"xref":8609,":@":8612},[8610],{"#text":8611},"Platz et al., 2023",{"@_ref-type":1055,"@_rid":8613},"B29",{"#text":8615},"). A scoping review on Social Assistive Robots in clinical physiotherapy identified coaching, demonstration, monitoring, and peer support as the four primary functional roles (",{"xref":8617,":@":8620},[8618],{"#text":8619},"He et al., 2025",{"@_ref-type":1055,"@_rid":8621},"B18",{"#text":8623},") – all of which HemiBot addresses through its TTS feedback, moving end-effector, ",{"monospace":8625},[8626],{"#text":2726},{"#text":8628}," node, and scoreboard respectively. Both reviews highlight the capacity of non-contact social robots to extend therapist reach without physical contact, an argument directly applicable to the deployment scenario envisioned at Fondazione IRCCS Mondino. More advanced adaptive policies–such as reinforcement learning approaches that adjust exercise parameters to individual performance in real time–have been explored for social robot coaching in physiotherapy ",{"xref":8630,":@":8633},[8631],{"#text":8632},"Bettosi et al. (2025)",{"@_ref-type":1055,"@_rid":8634},"B5",{"#text":8636},", and represent a natural next step beyond the present threshold-based progression.",{"#text":870},{"p":8639},[8640],{"#text":8641},"A further consideration concerns the target clinical population: transient wrist-occlusion artifacts, identified here as a source of increasing error at larger eccentricities, may affect stroke patients with hemiparesis differently than healthy participants, since atypical or reduced-amplitude limb kinematics could increase the frequency or duration of low-confidence landmark tracking. This potential interaction between motor impairment and markerless tracking reliability was not assessed in the present healthy-volunteer sample and should be characterized in future clinical validation. Relatedly, while the empathetic TTS feedback content was implemented and delivered throughout the sessions, its perceived empathy, appropriateness, and effect on participant engagement were not themselves evaluated in this study; this component should therefore be regarded as an unvalidated element of the clinical-readiness pathway, to be assessed in future work.",{"#text":885},{"@_id":8644},"s4-4",{"#text":885},{"sec":8647,":@":8787},[8648,8649,8653,8654,8762,8763,8786],{"#text":1440},{"title":8650},[8651],{"#text":8652},"4.5 Limitations",{"#text":870},{"p":8655},[8656,8658,8677,8679,8709,8711,8730,8731,8750,8752,8755,8757,8760],{"#text":8657},"Several limitations of the current work must be acknowledged. First, the study involved exclusively healthy participants; while the recruited age profile (",{"inline-formula":8659,":@":8675},[8660],{"mml:math":8661,":@":8673},[8662],{"mml:mrow":8663},[8664,8667,8670],{"mml:mn":8665},[8666],{"#text":4406},{"mml:mo":8668},[8669],{"#text":2054},{"mml:mn":8671},[8672],{"#text":4413},{"@_id":8674},"m193",{"@_id":8676},"inf191",{"#text":8678}," years) approximates that of the intended clinical population, the scoring thresholds and band boundaries remain to be validated on post-stroke USN patients, who exhibit substantially different movement patterns, fatigue, and attentional fluctuations. Second, the low-performance group’s error pattern was deliberately piloted by the experimenter, so the demotion validation does not reflect organic patient variability. Because the low-performance group followed a controlled, scripted error pattern ",{"inline-formula":8680,":@":8707},[8681],{"mml:math":8682,":@":8705},[8683],{"mml:mrow":8684},[8685,8689,8701],{"mml:mo":8686,":@":8688},[8687],{"#text":4109},{"@_stretchy":347},{"mml:mrow":8690},[8691,8694,8697],{"mml:mi":8692},[8693],{"#text":3040},{"mml:mo":8695},[8696],{"#text":3478},{"mml:mn":8698},[8699],{"#text":8700},"0,50,100",{"mml:mo":8702,":@":8704},[8703],{"#text":4125},{"@_stretchy":347},{"@_id":8706},"m194",{"@_id":8708},"inf192",{"#text":8710},", the scoring logic has not yet been evaluated against naturally occurring, continuous performance gradients near the ",{"inline-formula":8712,":@":8728},[8713],{"mml:math":8714,":@":8726},[8715],{"mml:mrow":8716},[8717,8720,8723],{"mml:mi":8718},[8719],{"#text":3040},{"mml:mo":8721},[8722],{"#text":1657},{"mml:mn":8724},[8725],{"#text":3520},{"@_id":8727},"m195",{"@_id":8729},"inf193",{"#text":1255},{"inline-formula":8732,":@":8748},[8733],{"mml:math":8734,":@":8746},[8735],{"mml:mrow":8736},[8737,8740,8743],{"mml:mi":8738},[8739],{"#text":3040},{"mml:mo":8741},[8742],{"#text":1657},{"mml:mn":8744},[8745],{"#text":3552},{"@_id":8747},"m196",{"@_id":8749},"inf194",{"#text":8751}," boundaries. Third, only two sessions per participant were recorded, precluding assessment of longitudinal learning effects. Fourth, the onboard scoring metric remains primarily a motor-kinematic measure: while arm-alignment angle captures ",{"italic":8753},[8754],{"#text":1199},{"#text":8756},"-type accuracy and hand–end-effector distance provides an indirect proxy for active engagement, neither constitutes a direct measure of the ",{"italic":8758},[8759],{"#text":1193},{"#text":8761}," (perceptual-attentional) component of the neglect response. Wearable eye-tracking glasses are currently being explored by our group as a robust technique for capturing gaze-based attentional state, yet the development needed for such integration is not mature enough for its use into the present system.",{"#text":870},{"p":8764},[8765,8767,8784],{"#text":8766},"Fifth, while the collision-avoidance and emergency-stop mechanisms are implemented and operate consistently at both the motion-control and session-orchestration levels, they have not yet undergone quantitative safety validation: the software detection latency is bounded by the 30 Hz control loop (",{"inline-formula":8768,":@":8782},[8769],{"mml:math":8770,":@":8780},[8771],{"mml:mrow":8772},[8773,8776],{"mml:mo":8774},[8775],{"#text":3478},{"mml:mn":8777},[8778],{"#text":8779},"33",{"@_id":8781},"m197",{"@_id":8783},"inf195",{"#text":8785},"ms), but the hardware-side actuator latency and the physical stopping time and distance were not measured. The safety architecture should therefore be regarded as a design provision to be experimentally validated before clinical use, not as a demonstrated safety guarantee.",{"#text":885},{"@_id":8788},"s4-5",{"#text":885},{"sec":8791,":@":8826},[8792,8793,8797,8798,8825],{"#text":1440},{"title":8794},[8795],{"#text":8796},"4.6 Future Directions",{"#text":870},{"p":8799},[8800,8802,8805,8807,8810,8812,8818,8820,8824],{"#text":8801},"Planned future work includes: (i) a usability study with healthy participants and patient caregivers, assessed ",{"italic":8803},[8804],{"#text":2250},{"#text":8806}," the System Usability Scale (SUS), the User Experience Questionnaire (UEQ), and the Patient Global Impression of Change (PGIC); (ii) a clinical efficacy trial with post-stroke USN patients at Fondazione IRCCS Mondino, incorporating USN-specific outcome measures (Behavioral Inattention Test, Catherine Bergego Scale) and a broader neuropsychological battery; (iii) integration of an eye-tracking system to provide a direct, continuous measure of the ",{"italic":8808},[8809],{"#text":1193},{"#text":8811}," component alongside the motor-kinematic scoring already implemented; (iv) gamification of the exercises to sustain engagement across multi-week training programs; and (v) replacement of the current rule-based adaptive logic with a planning- or machine-learning-based closed-loop controller, in line with the deliberative-layer paradigm for autonomous, long-term session management and difficulty adaptation surveyed in (",{"xref":8813,":@":8816},[8814],{"#text":8815},"Tamantini et al., 2025",{"@_ref-type":1055,"@_rid":8817},"B36",{"#text":8819},"). (vi) Two engineering mitigations could reduce the frequency and impact of wrist occlusions in future iterations of the system. First, replacing the current per-frame Kalman filter, which omits a sample outright whenever the depth reading is invalid, rather than propagating a predicted estimate, with a filter that extrapolates joint position for a bounded number of consecutive missing frames would preserve continuity of the tracked trajectory through brief occlusions. Second, lowering the height of the TIAGo end-effector’s ready/rest configuration and the arc trajectory itself could reduce the geometric overlap between the end-effector and the wrist landmark from the camera’s viewpoint during active reaching, directly reducing the incidence of the occlusion mechanism identified in ",{"xref":8821,":@":8823},[8822],{"#text":3072},{"@_ref-type":2264,"@_rid":3074},{"#text":2267},{"#text":885},{"@_id":8827},"s4-6",{"#text":1036},{"@_sec-type":8830,"@_id":8423},"discussion",{"#text":1036},{"sec":8833,":@":8871,"anchorId":8873},[8834,8835,8839,8840,8870],{"#text":1040},{"title":8836},[8837],{"#text":8838},"5 Conclusion",{"#text":885},{"p":8841},[8842,8844,8847,8849,8868],{"#text":8843},"This paper presented ",{"italic":8845},[8846],{"#text":1370},{"#text":8848},", a complete ROS 2 software architecture for autonomous, adaptive rehabilitation session management on the TIAGo mobile manipulator, designed to target egocentric peripersonal neglect through a non-contact, robot-driven attentional cueing paradigm. The system integrates a multi-node Behavior Tree for real-time exercise execution and kinematic scoring, a Coach node for session-level adaptive difficulty progression, Italian empathetic TTS feedback, and a therapist-facing scoreboard. A controlled experiment with 16 healthy participants demonstrated three key results. First, kinematic RMSE remained modest across all difficulty levels, despite a statistically significant increase with arc eccentricity attributable to transient wrist occlusions at non-frontal arm configurations. Second, scoring concordance between TIAGo-derived and mocap-derived classifications was perfect (100%, ",{"inline-formula":8850,":@":8866},[8851],{"mml:math":8852,":@":8864},[8853],{"mml:mrow":8854},[8855,8858,8861],{"mml:mi":8856},[8857],{"#text":7301},{"mml:mo":8859},[8860],{"#text":1657},{"mml:mn":8862},[8863],{"#text":6255},{"@_id":8865},"m198",{"@_id":8867},"inf196",{"#text":8869},") across all 120 repetitions, confirming that the conservative scoring thresholds absorb both natural motor variability and artifact-induced deviations without compromising classification reliability. Third, the adaptive difficulty logic operated correctly for all 16 participants, validating the end-to-end reliability of the data pipeline from per-repetition metric computation through session-level aggregation to the Coach node decision. Together, these results characterize the measurement and decision chain of HemiBot under controlled conditions, and identify the specific analyses–near-boundary scoring behavior and validation on naturally graded performance–required before a clinical trial with post-stroke USN patients can be undertaken.",{"#text":1036},{"@_sec-type":8872,"@_id":8873},"conclusion","s5",{"#text":8875},"\n  ",[],[8878,8891,8904,8912,8926,8945,8964,8978],{"title":8879,"order":412,"content":8880},"Data availability statement",[8881,8882,8885,8886,8890],{"#text":885},{"title":8883},[8884],{"#text":8879},{"#text":885},{"p":8887},[8888],{"#text":8889},"The raw data supporting the conclusions of this article will be made available by the authors, without undue reservation.",{"#text":1036},{"title":8892,"order":664,"content":8893},"Author contributions",[8894,8895,8898,8899,8903],{"#text":885},{"title":8896},[8897],{"#text":8892},{"#text":885},{"p":8900},[8901],{"#text":8902},"RS: Conceptualization, Data curation, Formal Analysis, Writing – original draft. BG: Conceptualization, Investigation, Writing – review and editing. SS: Writing – review and editing. FL: Software, Writing – review and editing. LR: Writing – review and editing. MS: Writing – review and editing. SR: Conceptualization, Funding acquisition, Project administration, Supervision, Writing – review and editing.",{"#text":1036},{"title":8905,"order":8906,"content":8907},"Funding",5,[8908],{"p":8909},[8910],{"#text":8911},"The author(s) declared that financial support was received for this work and/or its publication. This work was supported by the Italian Ministry of Research under the complementary actions to the NRRP “Fit4MedRob–Fit for Medical Robotics” Grant (#PNC0000007).",{"title":8913,"order":8914,"content":8915},"Acknowledgments",6,[8916,8917,8920,8921,8925],{"#text":885},{"title":8918},[8919],{"#text":8913},{"#text":885},{"p":8922},[8923],{"#text":8924},"The experiments were carried out in the Living Lab of the Center of Excellence on Rehabilitation Devices and Digital Instruments (CoE REDI), University of Pavia. The authors thank the clinical collaborators at Fondazione IRCCS Mondino for their support in the conceptualization of the system and in defining the clinical needs of the target patient population.",{"#text":1036},{"title":8927,"order":8928,"content":8929},"Conflict of interest",8,[8930,8931,8934,8935,8939,8940,8944],{"#text":885},{"title":8932},[8933],{"#text":8927},{"#text":885},{"p":8936},[8937],{"#text":8938},"The author(s) declared that this work was conducted in the absence of any commercial or financial relationships that could be construed as a potential conflict of interest.",{"#text":885},{"p":8941},[8942],{"#text":8943},"The author SR declared that they were an editorial board member of Frontiers at the time of submission. This had no impact on the peer review process and the final decision.",{"#text":1036},{"title":8946,"order":8947,"content":8948},"Generative AI statement",9,[8949,8950,8953,8954,8958,8959,8963],{"#text":885},{"title":8951},[8952],{"#text":8946},{"#text":885},{"p":8955},[8956],{"#text":8957},"The author(s) declared that generative AI was used in the creation of this manuscript. Generative AI was used During the preparation of this work, the author(s) used Generative AI in order to review grammar and phrasing. After using this tool/service, the author(s) reviewed and edited the content as needed and take(s) full responsibility for the content of the publication.",{"#text":885},{"p":8960},[8961],{"#text":8962},"Any alternative text (alt text) provided alongside figures in this article has been generated by Frontiers with the support of artificial intelligence and reasonable efforts have been made to ensure accuracy, including review by the authors wherever possible. If you identify any issues, please contact us.",{"#text":1036},{"title":8965,"order":8966,"content":8967},"Publisher’s note",11,[8968,8969,8972,8973,8977],{"#text":885},{"title":8970},[8971],{"#text":8965},{"#text":885},{"p":8974},[8975],{"#text":8976},"All claims expressed in this article are solely those of the authors and do not necessarily represent those of their affiliated organizations, or those of the publisher, the editors and the reviewers. Any product that may be evaluated in this article, or claim that may be made by its manufacturer, is not guaranteed or endorsed by the publisher.",{"#text":1036},{"title":8979,"order":8980,"content":8981},"Supplementary material",14,[8982,8983,8986,8987,8996,8997,9003],{"#text":885},{"title":8984},[8985],{"#text":8979},{"#text":885},{"p":8988},[8989,8991],{"#text":8990},"The Supplementary Material for this article can be found online at: ",{"ext-link":8992,":@":8995},[8993],{"#text":8994},"https://www.frontiersin.org/articles/10.3389/frobt.2026.1950821/full#supplementary-material",{"@_ext-link-type":879,"@_xmlns:xlink":880,"@_xlink:href":8994},{"#text":885},{"supplementary-material":8998,":@":8999},[],{"@_xlink:href":9000,"@_id":9001,"@_mimetype":9002,"@_xmlns:xlink":880},"DataSheet1.pdf","SM1","application/pdf",{"#text":1036},[],[9006],{"title":9007,"id":9008,"references":9009},"References","h8",[9010,9153,9266,9