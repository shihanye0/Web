earning-based adaptive personalization in virtual reality stroke rehabilitation: a systematic review",{"#text":9116},". ",{"source":9118},[9119],{"#text":9120},"Front. Rehabilitation Sci.",{"volume":9122},[9123],{"#text":9124},"7",{"#text":2393},{"fpage":9127},[9128],{"#text":9129},"1827658",{"#text":9116},{"pub-id":9132,":@":9135},[9133],{"#text":9134},"10.3389/fresc.2026.1827658",{"@_pub-id-type":9136},"doi",{"pub-id":9138,":@":9141},[9139],{"#text":9140},"42381640",{"@_pub-id-type":9142},"pmid",{"@_publication-type":9144},"journal",{"#text":885},[9147,9148,9149,9150,9151,9152],{"surname":9025,"givenNames":9030},{"surname":9039,"givenNames":9044},{"surname":9053,"givenNames":9030},{"surname":9066,"givenNames":9071},{"surname":9080,"givenNames":9085},{"surname":9094,"givenNames":9099},{"content":9154,"id":1187,"index":21,"authors":9261,"title":9227,"source":9232,"volume":9236,"year":9222,"fpage":9241,"lpage":9247,"doi":9252,"pmid":9257},[9155,9156,9260],{"#text":870},{"mixed-citation":9157,":@":9259},[9158,9159,9218,9219,9223,9224,9228,9229,9233,9237,9238,9242,9244,9248,9249,9254],{"#text":915},{"person-group":9160,":@":9217},[9161,9162,9175,9176,9189,9190,9203,9204,9216],{"#text":1891},{"name":9163},[9164,9165,9169,9170,9174],{"#text":1956},{"surname":9166},[9167],{"#text":9168},"Barrett",{"#text":1956},{"given-names":9171},[9172],{"#text":9173},"A. M.",{"#text":1891},{"#text":1891},{"name":9177},[9178,9179,9183,9184,9188],{"#text":1956},{"surname":9180},[9181],{"#text":9182},"Goedert",{"#text":1956},{"given-names":9185},[9186],{"#text":9187},"K. M.",{"#text":1891},{"#text":1891},{"name":9191},[9192,9193,9197,9198,9202],{"#text":1956},{"surname":9194},[9195],{"#text":9196},"Carter",{"#text":1956},{"given-names":9199},[9200],{"#text":9201},"A. R.",{"#text":1891},{"#text":1891},{"name":9205},[9206,9207,9211,9212,9215],{"#text":1956},{"surname":9208},[9209],{"#text":9210},"Chaudhari",{"#text":1956},{"given-names":9213},[9214],{"#text":9030},{"#text":1891},{"#text":915},{"@_person-group-type":9103},{"#text":1846},{"year":9220},[9221],{"#text":9222},"2022",{"#text":9110},{"article-title":9225},[9226],{"#text":9227},"Spatial neglect treatment: the brain’s spatial-motor aiming systems",{"#text":9116},{"source":9230},[9231],{"#text":9232},"Neuropsychol. Rehabil.",{"volume":9234},[9235],{"#text":9236},"32",{"#text":2393},{"fpage":9239},[9240],{"#text":9241},"690",{"#text":9243},"–",{"lpage":9245},[9246],{"#text":9247},"716",{"#text":9116},{"pub-id":9250,":@":9253},[9251],{"#text":9252},"10.1080/09602011.2020.1862678",{"@_pub-id-type":9136},{"pub-id":9255,":@":9258},[9256],{"#text":9257},"33941021",{"@_pub-id-type":9142},{"@_publication-type":9144},{"#text":885},[9262,9263,9264,9265],{"surname":9168,"givenNames":9173},{"surname":9182,"givenNames":9187},{"surname":9196,"givenNames":9201},{"surname":9210,"givenNames":9030},{"content":9267,"id":1143,"index":21,"authors":9332,"title":9299,"source":9304,"volume":9308,"year":9294,"fpage":9313,"lpage":9318,"doi":9323,"pmid":9328},[9268,9269,9331],{"#text":870},{"mixed-citation":9270,":@":9330},[9271,9272,9290,9291,9295,9296,9300,9301,9305,9309,9310,9314,9315,9319,9320,9325],{"#text":915},{"person-group":9273,":@":9289},[9274,9275,9288],{"#text":1891},{"name":9276},[9277,9278,9282,9283,9287],{"#text":1956},{"surname":9279},[9280],{"#text":9281},"Bartolomeo",{"#text":1956},{"given-names":9284},[9285],{"#text":9286},"P.",{"#text":1891},{"#text":915},{"@_person-group-type":9103},{"#text":1846},{"year":9292},[9293],{"#text":9294},"2021",{"#text":9110},{"article-title":9297},[9298],{"#text":9299},"From competition to cooperation: visual neglect across the hemispheres",{"#text":9116},{"source":9302},[9303],{"#text":9304},"Rev. Neurol.",{"volume":9306},[9307],{"#text":9308},"177",{"#text":2393},{"fpage":9311},[9312],{"#text":9313},"1104",{"#text":9243},{"lpage":9316},[9317],{"#text":9318},"1111",{"#text":9116},{"pub-id":9321,":@":9324},[9322],{"#text":9323},"10.1016/j.neurol.2021.07.015",{"@_pub-id-