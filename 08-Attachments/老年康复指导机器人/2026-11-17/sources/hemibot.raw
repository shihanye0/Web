Reactive",18],{"main":19,"user":548,"article":549,"articleHub":17337,"mainHeader":17341},{"ibar":20,"footer":263,"newsletterComponent":-1,"snackbarItem":346,"toggleShowSnackbar":347,"contentfulJournal":348,"graphJournal":453,"settingsFeaturesSwitchers":456,"templateToggleBanner":457,"tenantConfig":460},{"tenantLogo":21,"journalLogo":21,"aboutUs":22,"submitUrl":124,"submitDataUrl":21,"showSubmitButton":15,"journal":125,"sectionTerm":194,"aboutJournal":195,"mainLinks":244,"journalLinks":251,"helpCenterLink":260},"",[23,40,55,82,98],{"title":24,"links":25},"Who we are",[26,31,34,37],{"text":27,"url":28,"target":29,"ariaLabel":30},"Mission and values","https://www.frontiersin.org/about/mission","_self",null,{"text":32,"url":33,"target":29,"ariaLabel":30},"History","https://www.frontiersin.org/about/history",{"text":35,"url":36,"target":29,"ariaLabel":30},"Leadership","https://www.frontiersin.org/about/leadership",{"text":38,"url":39,"target":29,"ariaLabel":30},"Awards","https://www.frontiersin.org/about/awards",{"title":41,"links":42},"Impact and progress",[43,46,49,52],{"text":44,"url":45,"target":29,"ariaLabel":30},"Frontiers' impact","https://www.frontiersin.org/about/impact",{"text":47,"url":48,"target":29,"ariaLabel":30},"Our annual reports","https://www.frontiersin.org/about/annual-reports",{"text":50,"url":51,"target":29,"ariaLabel":30},"Thought leadership","https://www.frontiersin.org/about/thought-leadership",{"text":53,"url":54,"target":29,"ariaLabel":30},"Researcher perspectives","https://www.frontiersin.org/about/researcher-perspectives",{"title":56,"links":57},"Publishing model",[58,61,64,67,70,73,76,79],{"text":59,"url":60,"target":29,"ariaLabel":30},"How we publish","https://www.frontiersin.org/about/how-we-publish",{"text":62,"url":63,"target":29,"ariaLabel":30},"Open access","https://www.frontiersin.org/about/open-access",{"text":65,"url":66,"target":29,"ariaLabel":30},"Quality and research integrity","https://www.frontiersin.org/about/quality",{"text":